-- PAGE: CONFIGURATION (โปรไฟล์ + นำเข้า/ส่งออก)
-- ═══════════════════════════════════════════════════════════════════════════
local function buildConfigPage(page)
	local scroll = UI.MakeScroll(page)

	-- สถานะที่เก็บข้อมูล
	UI.Section(scroll, "config.storage", 1)
	local storageRow = UI.Card(scroll, { LayoutOrder = 2, Size = UDim2.new(1, 0, 0, 56) })
	local storageLabel = Instance.new("TextLabel")
	storageLabel.Size = UDim2.new(1, -100, 0, 20)
	storageLabel.Position = UDim2.new(0, 12, 0, 6)
	storageLabel.BackgroundTransparency = 1
	storageLabel.Font = Enum.Font.GothamBold
	storageLabel.TextSize = 12
	storageLabel.TextXAlignment = Enum.TextXAlignment.Left
	storageLabel.Parent = storageRow

	local storageHint = Instance.new("TextLabel")
	storageHint.Size = UDim2.new(1, -100, 0, 24)
	storageHint.Position = UDim2.new(0, 12, 0, 28)
	storageHint.BackgroundTransparency = 1
	storageHint.Font = Enum.Font.Gotham
	storageHint.TextSize = 10
	storageHint.TextWrapped = true
	storageHint.TextXAlignment = Enum.TextXAlignment.Left
	storageHint.Parent = storageRow

	local function refreshStorage()
		if not storageRow.Parent then return end
		local c = ThemeEngine.GetColors()
		if SaveService.HasServerStorage() then
			storageLabel.Text = Localization.L("config.storageServer")
			storageLabel.TextColor3 = c.Success
			storageHint.Text = ""
		else
			storageLabel.Text = Localization.L("config.storageSession")
			storageLabel.TextColor3 = c.Warning
			storageHint.Text = Localization.L("config.bridgeInstall")
			storageHint.TextColor3 = c.TextDim
		end
	end
	refreshStorage()
	Localization.Bind(refreshStorage)

	UI.Button({
		Parent = storageRow,
		LabelKey = "common.refresh",
		Style = "ghost",
		Size = UDim2.new(0, 80, 0, 28),
		LayoutOrder = 0,
		OnClick = function()
			refreshStorage()
		end,
	}).GetButton().Position = UDim2.new(1, -92, 0.5, -14)

	-- สร้าง/บันทึกโปรไฟล์
	UI.Section(scroll, "config.profileName", 3)
	local nameInput = UI.TextInput({
		Parent = scroll,
		LayoutOrder = 4,
		PlaceholderKey = "config.namePlaceholder",
		MaxLength = 32,
	})
	nameInput.GetFrame().Size = UDim2.new(1, 0, 0, 34)

	local profileList = Instance.new("Frame")
	profileList.LayoutOrder = 6
	profileList.Size = UDim2.new(1, 0, 0, 0)
	profileList.AutomaticSize = Enum.AutomaticSize.Y
	profileList.BackgroundTransparency = 1
	profileList.Parent = scroll
	local profileLayout = Instance.new("UIListLayout")
	profileLayout.SortOrder = Enum.SortOrder.LayoutOrder
	profileLayout.Padding = UDim.new(0, 6)
	profileLayout.Parent = profileList

	local function rebuildProfileList()
		for _, child in ipairs(profileList:GetChildren()) do
			if child:IsA("Frame") or child:IsA("TextLabel") then
				child:Destroy()
			end
		end
		local c = ThemeEngine.GetColors()
		local names = SaveService.GetProfileNames()
		if #names == 0 then
			local empty = Instance.new("TextLabel")
			empty.Size = UDim2.new(1, 0, 0, 24)
			empty.BackgroundTransparency = 1
			empty.Font = Enum.Font.Gotham
			empty.TextSize = 12
			empty.TextColor3 = c.TextDim
			empty.Text = Localization.L("config.noProfiles")
			empty.Parent = profileList
			return
		end
		for order, name in ipairs(names) do
			local row = Instance.new("Frame")
			row.Size = UDim2.new(1, 0, 0, 44)
			row.LayoutOrder = order
			row.BackgroundColor3 = c.PanelAlt
			row.BackgroundTransparency = 0.5
			row.BorderSizePixel = 0
			row.Parent = profileList
			UI.Corner(row, 6)

			local nameLabel = Instance.new("TextLabel")
			nameLabel.Size = UDim2.new(1, -150, 1, 0)
			nameLabel.Position = UDim2.new(0, 10, 0, 0)
			nameLabel.BackgroundTransparency = 1
			nameLabel.Font = Enum.Font.GothamBold
			nameLabel.TextSize = 12
			nameLabel.TextColor3 = c.Text
			nameLabel.TextXAlignment = Enum.TextXAlignment.Left
			nameLabel.TextTruncate = Enum.TextTruncate.AtEnd
			nameLabel.Text = name
			nameLabel.Parent = row

			UI.Button({
				Parent = row,
				LabelKey = "common.load",
				Style = "primary",
				Size = UDim2.new(0, 62, 0, 28),
				LayoutOrder = 0,
				OnClick = function()
					local ok, errKey = SaveService.LoadProfile(name)
					if ok then
						Notify.Show("success", "config.loaded", "config.loaded", { name = name }, 3)
					else
						Notify.Show("error", "config.loadFailed", errKey or "err.generic", { name = name })
					end
				end,
			}).GetButton().Position = UDim2.new(1, -140, 0.5, -14)

			-- ลบ: ยืนยัน 2 ครั้ง
			local delConfirm = false
			local delTimer = nil
			local delBtn
			delBtn = UI.Button({
				Parent = row,
				LabelKey = "common.delete",
				Style = "danger",
				Size = UDim2.new(0, 62, 0, 28),
				LayoutOrder = 0,
				OnClick = function()
					if not delConfirm then
						delConfirm = true
						delBtn.SetText(Localization.L("common.confirm"))
						if delTimer then task.cancel(delTimer) end
						delTimer = task.delay(3, function()
							delConfirm = false
							delTimer = nil
							delBtn.SetText(Localization.L("common.delete"))
						end)
					else
						if delTimer then task.cancel(delTimer) delTimer = nil end
						SaveService.DeleteProfile(name)
						Notify.Show("info", "config.deleted", "config.deleted", { name = name }, 2.5)
						rebuildProfileList()
					end
				end,
			})
			delBtn.GetButton().Position = UDim2.new(1, -72, 0.5, -14)
		end
	end

	UI.Button({
		Parent = scroll,
		LabelKey = "config.saveProfile",
		Style = "primary",
		LayoutOrder = 5,
		OnClick = function()
			local name = trimString(nameInput.Get())
			if name == "" then
				Notify.Show("warning", "config.invalidName", "err.invalidInput", nil, 3)
				return
			end
			local ok, errKey = SaveService.SaveProfile(name)
			if ok then
				Notify.Show("success", "config.saved", "config.saved", { name = name }, 3)
			else
				Notify.Show("error", "config.saveFailed", errKey or "err.generic", { name = name })
			end
			rebuildProfileList()
		end,
	})

	rebuildProfileList()

	-- นำเข้า / ส่งออก
	UI.Section(scroll, "config.exportTitle", 7)
	UI.Button({
		Parent = scroll,
		LabelKey = "config.exportTitle",
		Style = "secondary",
		LayoutOrder = 8,
		OnClick = function()
			local json = SaveService.ExportString()
			if not json then
				Notify.Show("error", "config.saveFailed", "err.generic", nil, 3)
				return
			end
			Modal.Open({
				TitleKey = "config.exportTitle",
				BodyKey = "config.exportHint",
				Field = { Initial = json, ReadOnly = true, MultiLine = true, Height = 150 },
				Buttons = {
					{ LabelKey = "common.close", Style = "ghost", OnClick = function(text, close) close() end },
				},
			})
		end,
	})

	UI.Button({
		Parent = scroll,
		LabelKey = "config.importTitle",
		Style = "secondary",
		LayoutOrder = 9,
		OnClick = function()
			Modal.Open({
				TitleKey = "config.importTitle",
				BodyKey = "config.exportHint",
				Field = { Initial = "", PlaceholderKey = "config.importPlaceholder", MultiLine = true, Height = 150 },
				Buttons = {
					{ LabelKey = "common.cancel", Style = "ghost", OnClick = function(text, close) close() end },
					{
						LabelKey = "config.importTitle",
						Style = "primary",
						OnClick = function(text, close)
							local ok = SaveService.ImportString(text)
							if ok then
								Notify.Show("success", "config.importOk", "config.importOk", nil, 3)
								close()
							else
								Notify.Show("error", "config.importFail", "config.importFail", nil, 4)
							end
						end,
					},
				},
			})
		end,
	})
end

