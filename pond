		icon.BackgroundTransparency = 1
		icon.Font = Enum.Font.GothamBold
		icon.TextSize = 13
		icon.Text = menu.icon
		icon.Parent = btn

		local txt = Instance.new("TextLabel")
		txt.Size = UDim2.new(1, -44, 1, 0)
		txt.Position = UDim2.new(0, 38, 0, 0)
		txt.BackgroundTransparency = 1
		txt.Font = Enum.Font.GothamMedium
		txt.TextSize = 12
		txt.TextXAlignment = Enum.TextXAlignment.Left
		txt.TextTruncate = Enum.TextTruncate.AtEnd
		txt.Parent = btn
		Localization.BindText(txt, menu.lk)

		local bar = Instance.new("Frame")
		bar.Size = UDim2.new(0, 3, 0.5, 0)
		bar.Position = UDim2.new(0, 0, 0.25, 0)
		bar.BackgroundColor3 = colors.Accent
		bar.BorderSizePixel = 0
		bar.Visible = false
		bar.Parent = btn
		UI.Corner(bar, 2)

		NavButtons[menu.id] = { btn = btn, icon = icon, txt = txt, bar = bar }

		btn.MouseButton1Click:Connect(function()
			NavigateTo(menu.id)
