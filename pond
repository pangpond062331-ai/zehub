-- MODULE REGISTRY (ระบบโมดูลฟังก์ชัน)
-- · แต่ละโมดูลต้องประกาศ availability ตามจริง — ห้ามแกล้งแสดงว่าทำงาน
-- · โมดูลที่พังจะไม่ทำให้ UI ทั้งระบบล่ม (กันด้วย pcall + error log)
-- ═══════════════════════════════════════════════════════════════════════════
do
	ModuleRegistry.list = {}
	ModuleRegistry.byId = {}
	ModuleRegistry.changed = Signal.new("ModulesChanged")

	function ModuleRegistry.GetGameAPI()
		local ok, api = pcall(function()
			return ReplicatedStorage:FindFirstChild("AnimeNexusAPI")
		end)
		if ok and api then return api end
		return nil
	end

	function ModuleRegistry.Register(def)
		if type(def) ~= "table" or type(def.id) ~= "string" then
			ErrorHandling.Report("ModuleRegistry", "Register: invalid module definition", "warn")
			return nil
		end
		if ModuleRegistry.byId[def.id] then
			ErrorHandling.Report("ModuleRegistry", "Duplicate module id: " .. def.id, "warn")
			return nil
		end
		def.enabled = false
		def.lastError = nil
		def.data = deepCopy(State.Get("ModuleData." .. def.id) or {})
		table.insert(ModuleRegistry.list, def)
		ModuleRegistry.byId[def.id] = def
		return def
	end

	-- คืน {available=bool, statusKey=string, reasonKey=string?}
	function ModuleRegistry.GetAvailability(mod)
		if type(mod.availability) == "function" then
			local ok, res = pcall(mod.availability)
			if ok and type(res) == "table" then
				return res
			end
			ErrorHandling.Report("ModuleRegistry", "availability() failed for " .. tostring(mod.id))
			return { available = false, statusKey = "status.unavailable", reasonKey = "err.generic" }
		end
		return { available = true, statusKey = mod.statusKey or "status.localEffect" }
	end

	function ModuleRegistry.GetStatusKey(mod)
		if mod.lastError then return "status.error" end
		if mod.enabled then
			local avail = ModuleRegistry.GetAvailability(mod)
			return (avail.available and avail.statusKey ~= "status.requiresApi") and "status.enabled" or (avail.statusKey or "status.enabled")
		end
		local avail2 = ModuleRegistry.GetAvailability(mod)
		if not avail2.available then return "status.unavailable" end
		return avail2.statusKey or "status.disabled"
	end

	function ModuleRegistry.StatusKind(statusKey)
		if statusKey == "status.enabled" then return "success" end
		if statusKey == "status.error" or statusKey == "status.unavailable" then return "error" end
		if statusKey == "status.devOnly" or statusKey == "status.requiresApi" then return "warning" end
		if statusKey == "status.action" then return "accent" end
		return "dim"
	end

	function ModuleRegistry.SetEnabled(id, want)
		local mod = ModuleRegistry.byId[id]
		if not mod then return false end
		local name = Localization.L(mod.nameKey)
		if want then
			if mod.enabled then return true end
			local avail = ModuleRegistry.GetAvailability(mod)
			if not avail.available then
				Notify.Show("warning", "notify.moduleUnavailable", avail.reasonKey or "common.notAvailable", { name = name })
				return false
			end
			local ok, err = pcall(mod.enable, mod.data)
			if not ok then
				mod.lastError = tostring(err)
				ErrorHandling.Report("Module." .. id, err)
				Notify.Show("error", "notify.moduleFailed", "err.generic", { name = name })
				ModuleRegistry.changed:Fire()
				return false
			end
			mod.enabled = true
			mod.lastError = nil
			State.Set("Modules." .. id, true)
			ModuleRegistry.SaveData(id)
			Notify.Show("success", "notify.moduleEnabled", "notify.moduleEnabled", { name = name }, 2.5)
		else
			if not mod.enabled then return true end
			local ok, err = pcall(mod.disable, mod.data)
			mod.enabled = false
			if not ok then
				mod.lastError = tostring(err)
				ErrorHandling.Report("Module." .. id, err)
			end
			State.Set("Modules." .. id, false)
			Notify.Show("info", "notify.moduleDisabled", "notify.moduleDisabled", { name = name }, 2.5)
		end
		ModuleRegistry.changed:Fire()
		return true
	end

	function ModuleRegistry.Toggle(id)
		local mod = ModuleRegistry.byId[id]
		if not mod then return false end
		return ModuleRegistry.SetEnabled(id, not mod.enabled)
	end

	-- เรียกใช้โมดูลประเภทปุ่ม (kind = "action")
	function ModuleRegistry.RunAction(id)
		local mod = ModuleRegistry.byId[id]
		if not mod or type(mod.action) ~= "function" then return false end
		local avail = ModuleRegistry.GetAvailability(mod)
		if not avail.available then
			Notify.Show("warning", "notify.moduleUnavailable", avail.reasonKey or "common.notAvailable",
				{ name = Localization.L(mod.nameKey) })
			return false
		end
		local ok, err = pcall(mod.action, mod.data)
		if not ok then
			mod.lastError = tostring(err)
			ErrorHandling.Report("Module." .. id, err)
			Notify.Show("error", "notify.moduleFailed", "err.generic", { name = Localization.L(mod.nameKey) })
			ModuleRegistry.changed:Fire()
			return false
		end
		return true
	end

	function ModuleRegistry.GetEnabledCount()
		local n = 0
		for _, m in ipairs(ModuleRegistry.list) do
			if m.enabled then n = n + 1 end
		end
		return n
	end

	function ModuleRegistry.SaveData(id)
		local mod = ModuleRegistry.byId[id]
		if mod and type(mod.data) == "table" then
			State.Set("ModuleData." .. id, deepCopy(mod.data))
		end
	end

	-- เรียกเมื่อตัวละครเกิดใหม่: โมดูลที่เปิดอยู่ต้อง re-apply
	function ModuleRegistry.HandleRespawn()
		for _, mod in ipairs(ModuleRegistry.list) do
			if mod.enabled and mod.onRespawn then
				local ok, err = pcall(mod.onRespawn, mod.data)
				if not ok then
					mod.lastError = tostring(err)
					ErrorHandling.Report("Module." .. mod.id .. ".Respawn", err)
					ModuleRegistry.changed:Fire()
				end
			end
		end
	end

	-- กู้ค่าการเปิด/ปิดโมดูลจาก State (เรียกหลังลงทะเบียนครบแล้ว)
	function ModuleRegistry.RestoreStates()
		for _, mod in ipairs(ModuleRegistry.list) do
			local saved = State.Get("Modules." .. mod.id)
			if saved == true and not mod.enabled then
				ModuleRegistry.SetEnabled(mod.id, true)
			end
		end
	end
end

