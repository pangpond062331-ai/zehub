-- CLEANUP MANAGER
-- รวบรวม connection/instance ที่ต้องปล่อยเมื่อปิดระบบ
-- ═══════════════════════════════════════════════════════════════════════════
local Cleanup = {}
do
	local conns = {}
	local instances = {}
	local teardownCallbacks = {}

	-- เชื่อม signal แบบถูกติดตามอัตโนมัติ
	function Cleanup.Bind(signal, fn)
		local conn = signal:Connect(fn)
		table.insert(conns, conn)
		return conn
	end

	-- เพิ่ม connection ภายนอก (เช่น RBXScriptSignal) ให้ถูกติดตาม
	function Cleanup.Watch(rbxSignal, fn)
		local conn
		conn = rbxSignal:Connect(function(...)
			if not conn.Connected then return end
			local ok, err = pcall(fn, ...)
			if not ok then
				ErrorHandling.Report("Cleanup.Watch", err)
			end
		end)
		table.insert(conns, conn)
		return conn
	end

	function Cleanup.TrackInstance(inst)
		if inst then
			table.insert(instances, inst)
		end
		return inst
	end

	function Cleanup.OnTeardown(fn)
		if type(fn) == "function" then
			table.insert(teardownCallbacks, fn)
		end
	end

	function Cleanup.GetStats()
		return #conns, #instances
	end

	function Cleanup.Teardown()
		for _, fn in ipairs(teardownCallbacks) do
			pcall(fn)
		end
		teardownCallbacks = {}
		for i = #conns, 1, -1 do
			local c = conns[i]
			conns[i] = nil
			pcall(function() c:Disconnect() end)
		end
		for i = #instances, 1, -1 do
			local inst = instances[i]
			instances[i] = nil
			if inst and inst.Parent then
				pcall(function() inst:Destroy() end)
			end
		end
	end
end

