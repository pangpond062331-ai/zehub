-- MODAL (หน้าต่างลอยกลางจอ — ใช้กับ Export/Import/Error Log)
-- ═══════════════════════════════════════════════════════════════════════════
do
	local dim = nil
	local card = nil

	function Modal.Init(rootFrame)
		dim = Instance.new("Frame")
		dim.Name = "ModalDim"
		dim.Size = UDim2.fromScale(1, 1)
		dim.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
		dim.BackgroundTransparency = 0.45
		dim.BorderSizePixel = 0
		dim.Visible = false
		dim.Active = true
		dim.ZIndex = 90
		dim.Parent = rootFrame
		Cleanup.TrackInstance(dim)
	end

	function Modal.IsOpen()
		return dim ~= nil and dim.Visible == true
	end

	function Modal.Close()
		if dim then
			dim.Visible = false
		end
		if card then
			card:Destroy()
			card = nil
		end
	end

	-- opts: TitleKey, BodyKey, BodyParams, Field {Initial, PlaceholderKey, ReadOnly, MultiLine, Height},
	--       Buttons { {LabelKey, Style, OnClick(text, close)} }
	function Modal.Open(opts)
		if not dim then return end
		Modal.Close()
		opts = opts or {}
		local colors = ThemeEngine.GetColors()

		card = Instance.new("Frame")
		card.Name = "ModalCard"
		card.AnchorPoint = Vector2.new(0.5, 0.5)
		card.Position = UDim2.fromScale(0.5, 0.5)
		card.Size = UDim2.new(1, -32, 0, 0)
		card.AutomaticSize = Enum.AutomaticSize.Y
		card.BackgroundColor3 = colors.Panel
		card.BorderSizePixel = 0
		card.ZIndex = 91
		card.Parent = dim

		local maxW = math.min(480, (dim.AbsoluteSize.X > 0 and dim.AbsoluteSize.X or 800) - 32)
		card.Size = UDim2.new(0, maxW, 0, 0)

		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0, 10)
		corner.Parent = card

		local stroke = Instance.new("UIStroke")
		stroke.Color = colors.Border
		stroke.Thickness = 1.3
		stroke.Parent = card

		local layout = Instance.new("UIListLayout")
		layout.SortOrder = Enum.SortOrder.LayoutOrder
		layout.Padding = UDim.new(0, 8)
		layout.Parent = card

		local pad = Instance.new("UIPadding")
		pad.PaddingTop = UDim.new(0, 14)
		pad.PaddingBottom = UDim.new(0, 14)
		pad.PaddingLeft = UDim.new(0, 14)
		pad.PaddingRight = UDim.new(0, 14)
		pad.Parent = card

		ThemeEngine.Bind(function(c)
			if card and card.Parent then
				card.BackgroundColor3 = c.Panel
				stroke.Color = c.Border
			end
		end)

		-- หัวเรื่อง
		local title = Instance.new("TextLabel")
		title.Size = UDim2.new(1, 0, 0, 22)
		title.LayoutOrder = 1
		title.BackgroundTransparency = 1
		title.Font = Enum.Font.GothamBold
		title.TextSize = 14
		title.TextColor3 = colors.Accent
		title.TextXAlignment = Enum.TextXAlignment.Left
		title.Parent = card
		Localization.BindText(title, opts.TitleKey or "common.info")

		if opts.BodyKey then
			local body = Instance.new("TextLabel")
			body.Size = UDim2.new(1, 0, 0, 0)
			body.AutomaticSize = Enum.AutomaticSize.Y
			body.LayoutOrder = 2
			body.BackgroundTransparency = 1
			body.Font = Enum.Font.Gotham
			body.TextSize = 11
			body.TextColor3 = colors.TextDim
			body.TextWrapped = true
			body.TextXAlignment = Enum.TextXAlignment.Left
			body.Parent = card
			Localization.BindText(body, opts.BodyKey, "Text", opts.BodyParams)
		end

		local textBox = nil
		if opts.Field then
			textBox = Instance.new("TextBox")
			textBox.Size = UDim2.new(1, 0, 0, opts.Field.Height or 120)
			textBox.LayoutOrder = 3
			textBox.BackgroundColor3 = colors.Background
			textBox.BackgroundTransparency = 0.15
			textBox.BorderSizePixel = 0
			textBox.Font = Enum.Font.Gotham
			textBox.TextSize = 11
			textBox.TextColor3 = colors.Text
			textBox.PlaceholderColor3 = colors.TextDim
			textBox.TextXAlignment = Enum.TextXAlignment.Left
			textBox.TextYAlignment = Enum.TextYAlignment.Top
			textBox.TextWrapped = false
			textBox.MultiLine = opts.Field.MultiLine == true
			textBox.ClearTextOnFocus = false
			textBox.Text = opts.Field.Initial or ""
			textBox.ReadOnly = opts.Field.ReadOnly == true
			textBox.Parent = card

			local tbCorner = Instance.new("UICorner")
			tbCorner.CornerRadius = UDim.new(0, 6)
			tbCorner.Parent = textBox

			local tbPad = Instance.new("UIPadding")
			tbPad.PaddingTop = UDim.new(0, 6)
			tbPad.PaddingBottom = UDim.new(0, 6)
			tbPad.PaddingLeft = UDim.new(0, 8)
			tbPad.PaddingRight = UDim.new(0, 8)
			tbPad.Parent = textBox

			if opts.Field.PlaceholderKey then
				Localization.BindText(textBox, opts.Field.PlaceholderKey, "PlaceholderText")
			end
		end

		-- ปุ่ม
		if opts.Buttons and #opts.Buttons > 0 then
			local btnRow = Instance.new("Frame")
			btnRow.Size = UDim2.new(1, 0, 0, 34)
			btnRow.LayoutOrder = 10
			btnRow.BackgroundTransparency = 1
			btnRow.Parent = card

			local btnLayout = Instance.new("UIListLayout")
			btnLayout.FillDirection = Enum.FillDirection.Horizontal
			btnLayout.HorizontalAlignment = Enum.HorizontalAlignment.Right
			btnLayout.SortOrder = Enum.SortOrder.LayoutOrder
			btnLayout.Padding = UDim.new(0, 8)
			btnLayout.Parent = btnRow

			for i, def in ipairs(opts.Buttons) do
				local b = Instance.new("TextButton")
				b.Size = UDim2.new(0, 96, 0, 32)
				b.LayoutOrder = i
				b.BackgroundColor3 = (def.Style == "danger" and colors.Error)
					or (def.Style == "ghost" and colors.PanelAlt)
					or colors.Accent
				b.BackgroundTransparency = def.Style == "ghost" and 0.2 or 0.1
				b.Font = Enum.Font.GothamBold
				b.TextSize = 12
				b.TextColor3 = def.Style == "ghost" and colors.Text or Color3.fromRGB(15, 15, 20)
				b.BorderSizePixel = 0
				b.Parent = btnRow
				local bCorner = Instance.new("UICorner")
				bCorner.CornerRadius = UDim.new(0, 6)
				bCorner.Parent = b
				Localization.BindText(b, def.LabelKey)
				b.MouseButton1Click:Connect(function()
					local text = textBox and textBox.Text or nil
					if def.OnClick then
						local ok, err = pcall(def.OnClick, text, Modal.Close)
						if not ok then
							ErrorHandling.Report("Modal.Button", err)
						end
					else
						Modal.Close()
					end
				end)
			end
		end

		dim.Visible = true
	end
end

