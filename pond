-- Visual Effects (window aura + FOV circle)
VisualEffects._aura = nil
VisualEffects._auraStroke = nil
VisualEffects._fovGui = nil
VisualEffects._fovCircle = nil
VisualEffects._fovStroke = nil

-- เรียกโดย Window.Open/Close/Minimize เพื่อซ่อน/แสดงเอฟเฟกต์รอบหน้าต่าง
function VisualEffects.SetWindowVisible(visible: boolean)
	if VisualEffects._aura then
		VisualEffects._aura.Visible = visible and not Perf.IsReduceMotion()
	end
end

function VisualEffects.Init()
	if VisualEffects._aura then return end
	local ok, aura = pcall(function()
		local f = Instance.new("Frame")
		f.Name = "AnxAura"
		f.Size = UDim2.new(1, 6, 1, 6)
		f.AnchorPoint = Vector2.new(0.5, 0.5)
		f.Position = UDim2.fromScale(0.5, 0.5)
		f.BackgroundTransparency = 1
		f.BorderSizePixel = 0
		f.ZIndex = 0
		f.Parent = Window.Root
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0, 18)
		corner.Parent = f
		local stroke = Instance.new("UIStroke")
		stroke.Thickness = 2
		stroke.Transparency = 0.55
		stroke.Color = ThemeEngine.GetColors().Accent
		stroke.Parent = f
		return f, stroke
	end)
	if ok then
		VisualEffects._aura = aura
		-- เก็บ stroke ไว้เปลี่ยนสีตามธีม
		VisualEffects._auraStroke = aura and aura:FindFirstChildOfClass("UIStroke") or nil
		ThemeEngine.Bind(function(c)
			if VisualEffects._auraStroke and VisualEffects._auraStroke.Parent then
				VisualEffects._auraStroke.Color = c.Accent
			end
		end)
	end
end

function VisualEffects.StartLoop()
	if VisualEffects._loopStarted then return end
	VisualEffects._loopStarted = true
	local t = 0
	local last = os.clock()
	Perf.RegisterRenderStep("visual_effects", 2, function()
		if Perf.IsReduceMotion() or Perf.IsPerformanceMode() then return end
		local now = os.clock()
		local dt = now - last
		last = now
		t += dt * (State.Get("AnimationSpeed", 1) or 1) * 0.8
		if VisualEffects._auraStroke and VisualEffects._auraStroke.Parent then
			VisualEffects._auraStroke.Transparency = 0.5 + math.sin(t * 1.4) * 0.18
		end
	end)
end

-- FOV circle (ScreenGui แยกจากหน้าต่างหลัก)
function VisualEffects.EnsureFovGui()
	if VisualEffects._fovGui then
		return VisualEffects._fovGui
	end
	local ok, gui = pcall(function()
		local g = Instance.new("ScreenGui")
		g.Name = "AnimeNexusFOVGui"
		g.ResetOnSpawn = false
		g.IgnoreGuiInset = true
		g.DisplayOrder = 90
		g.Enabled = false
		local circle = Instance.new("Frame")
		circle.Name = "FovCircle"
		circle.AnchorPoint = Vector2.new(0.5, 0.5)
		circle.Position = UDim2.fromScale(0.5, 0.5)
		circle.Size = UDim2.fromOffset(160, 160)
		circle.BackgroundTransparency = 1
		circle.BorderSizePixel = 0
		circle.Parent = g
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(1, 0)
		corner.Parent = circle
		local stroke = Instance.new("UIStroke")
		stroke.Thickness = 2
		stroke.Transparency = 0.35
		stroke.Color = ThemeEngine.GetColors().Accent
		stroke.Parent = circle
		VisualEffects._fovStroke = stroke
		ThemeEngine.Bind(function(c)
			if stroke.Parent then stroke.Color = c.Accent end
		end)
		g.Parent = PlayerGui
		return g
	end)
	if ok and gui then
		VisualEffects._fovGui = gui
		VisualEffects._fovCircle = gui:FindFirstChild("FovCircle", true)
		Cleanup.TrackInstance(gui)
	end
	return VisualEffects._fovGui
end

function VisualEffects.SetFovVisible(visible: boolean)
	local gui = VisualEffects.EnsureFovGui()
	if gui then
		gui.Enabled = visible == true
	end
end

function VisualEffects.SetFovSize(size: number)
	if VisualEffects._fovCircle then
		local d = math.clamp(tonumber(size) or 160, 20, 600)
		VisualEffects._fovCircle.Size = UDim2.fromOffset(d, d)
	end
end


-- ==================== MODULE DEFINITIONS ====================
-- contract จริงของ ModuleRegistry:
--   id, nameKey, descKey, category ("Movement"/"Combat"/"Visual"/"System"),
--   statusKey?, availability() -> {available, statusKey, reasonKey?},
--   enable(data), disable(data), action(data) [kind="action"],
--   onRespawn(data)?, buildSettings(content, mod)?
-- data ถูก persist ผ่าน ModuleRegistry.SaveData (เก็บใน State.ModuleData.<id>)

-- Speed (WalkSpeed) — ผลบน Humanoid ของผู้เล่นเอง (local effect จริง)
do
	local def = {
		id = "speed", nameKey = "module.speed", descKey = "module.speed.desc",
		category = "Movement", statusKey = "status.localEffect",
		availability = function()
			-- Humanoid.WalkSpeed ใช้ได้เสมอใน Roblox — พร้อมเมื่อมีตัวละคร
			if not (LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")) then
				return { available = true, statusKey = "status.localEffect", reasonKey = "warn.needCharacter" }
			end
			return { available = true, statusKey = "status.localEffect" }
		end,
		enable = function(data)
			local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
			if hum then
				hum.WalkSpeed = tonumber(data.SpeedValue) or 100
			end
		end,
		disable = function(data)
			local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
			if hum then
				hum.WalkSpeed = 16
			end
		end,
		onRespawn = function(data)
			local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
			if hum then
				hum.WalkSpeed = tonumber(data.SpeedValue) or 100
			end
		end,
		buildSettings = function(content, mod)
			UI.Slider({
				Parent = content,
				LabelKey = "setting.speedValue",
				Min = 16, Max = 500, Step = 1,
				Value = tonumber(mod.data.SpeedValue) or 100,
				LayoutOrder = 1,
				OnChanged = function(v)
					mod.data.SpeedValue = v
					ModuleRegistry.SaveData(mod.id)
					if mod.enabled then
						local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
						if hum then
							hum.WalkSpeed = v
						end
					end
				end,
			})
		end,
	}
	ModuleRegistry.Register(def)
end

