end)
-- หมายเหตุ: WindowOpacity ถูกผูกไว้แล้วตอนสร้างหน้าต่าง (ไม่ผูกซ้ำ)

-- 2) เริ่มระบบ Performance (FPS sampler)
Perf.Init()

-- 3) เริ่มระบบ UI ที่ต้องมี parent (หน้าต่างถูกสร้างไว้แล้ว)
Notify.Init(Window.Root)
Tooltip.Init(Window.Root)
Overlay.Init(Window.Root)
Modal.Init(Window.Root)

-- 4) ใช้ธีม/ภาษาปัจจุบัน + เริ่มเอฟเฟกต์
ThemeEngine.Set(State.Get("Theme", "WaterBreathing"))
Localization.SetLanguage(State.Get("Language", "EN"))
VisualEffects.Init()
