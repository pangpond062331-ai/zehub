					if part:IsA("BasePart") then
						part.CanCollide = true
					end
				end
			end
		end,
		-- render step persist ข้าม respawn อยู่แล้ว จึงไม่ต้องใช้ onRespawn
	}
	ModuleRegistry.Register(def)
end

-- Aim Assist — ถูกล็อกหลัง DevTestMode เท่านั้น (ซื่อสัตย์เรื่องสถานะ)
do
	local def = {
		id = "aimassist", nameKey = "module.aimassist", descKey = "module.aimassist.desc",
		category = "Combat", statusKey = "status.localEffect",
		availability = function()
			if not State.Get("DevTestMode", false) then
				return { available = false, statusKey = "status.devOnly", reasonKey = "warn.devLockReason" }
			end
			return { available = true, statusKey = "status.localEffect" }
		end,
		enable = function(data)
			if not State.Get("DevTestMode", false) then
				Notify.Warning(Localization.L("warn.aimAssistDevLock"))
				error("Aim Assist is locked behind DevTestMode")
			end
			Perf.RegisterRenderStep("aimassist_step", 2, function()
				local c = LocalPlayer.Character
				local cam = workspace.CurrentCamera
				if not (c and cam) then return end
				local myPos = cam.CFrame.Position
				local best, bestDist = nil, math.huge
				for _, plr in ipairs(Players:GetPlayers()) do
					if plr ~= LocalPlayer then
						local oh = plr.Character and plr.Character:FindFirstChildOfClass("Humanoid")
						local hrp = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
						if oh and hrp and oh.Health > 0 then
							local dist = (hrp.Position - myPos).Magnitude
							if dist < bestDist then
								bestDist = dist
								best = hrp
							end
						end
					end
				end
				if best then
					local targetCFrame = CFrame.new(myPos, best.Position)
					cam.CFrame = cam.CFrame:Lerp(targetCFrame, 0.3)
				end
			end)
		end,
		disable = function(data)
			Perf.UnregisterRenderStep("aimassist_step")
		end,
	}
	ModuleRegistry.Register(def)
end

