-- คีย์ B: เสก Part สีแดงโปร่งแสง 4x4x4 ตรงหน้าตัวละคร แล้วพิมพ์พิกัดลง Output
local function spawnTestPart()
	if not rootPart then                                        -- ยังไม่มีตัวละคร (rootPart ยังไม่ถูกโหลด)
		print("[DevUtility] ยังไม่มีตัวละคร — ยังเสก Part ไม่ได้") -- แจ้งเตือนผู้ใช้
		return                                                  -- จบการทำงาน
	end
	spawnCounter = spawnCounter + 1                             -- เพิ่มตัวนับเพื่อตั้งชื่อ Part ไม่ให้ซ้ำกัน
	local part = Instance.new("Part")                           -- สร้าง Part ใหม่ (ยังไม่ได้ผูกกับ Workspace)
	part.Name = "DevTestPart_" .. spawnCounter                  -- ตั้งชื่อพร้อมเลขลำดับ เช่น DevTestPart_1
	part.Size = Vector3.new(4, 4, 4)                            -- ขนาด 4x4x4 ตามข้อกำหนด
	part.Color = Color3.fromRGB(255, 0, 0)                      -- สีแดงสด
	part.Transparency = 0.5                                     -- โปร่งแสง 50% ตามข้อกำหนด
	part.Material = Enum.Material.Plastic                        -- วัสดุพลาสติก (ค่าปกติของ Part)
	part.Anchored = true                                        -- ยึดค้างไว้ ไม่ให้ตกจากที่ที่เสก
	part.CFrame = rootPart.CFrame * CFrame.new(0, 0, -5)        -- วางห่างหน้าตัวละคร 5 สตั๊ด (แกน -Z คือด้านหน้า)
	part.Parent = workspace                                     -- ใส่เข้า Workspace เพื่อให้มองเห็นในโลก
	spawnedParts[#spawnedParts + 1] = part                      -- บันทึกลงตาราง เพื่อให้คีย์ C ล้างได้ภายหลัง
	print("[DevUtility] เสก Part ทดสอบแล้ว | พิกัด: " .. formatVector3(part.Position)) -- พิมพ์พิกัดที่เสกลง Output
end

-- สร้างซอร์สโค้ดของสคริปต์วาร์ป (Script ฝั่งเซิร์ฟเวอร์) โดยฝังค่าตำแหน่งปลายทางจริงเข้าไปในเทมเพลต
local GATE_SOURCE_TEMPLATE = [==[
--[[
	สคริปต์วาร์ปประตู (Script ฝั่งเซิร์ฟเวอร์)
	วิธีใช้  : วาง Script นี้ไว้เป็นลูกของ Part ประตูวาร์ปใน Workspace
	หน้าที่  : ตรวจจับการแตะประตู → Fade หน้าจอดำ → วาร์ป → คูลดาวน์ 2 วินาที
	หมายเหตุ: ตำแหน่ง/มุมปลายทางถูกฝังเป็นค่าคงที่ตอนสร้างประตูด้วยคีย์ L
]]
local Players = game:GetService("Players")             -- ใช้หาผู้เล่นจากตัวละครที่แตะประตู
local TweenService = game:GetService("TweenService")   -- ใช้ทำเอฟเฟกต์ Fade หน้าจอดำ

local gate = script.Parent                             -- อ้างอิง Part ประตูวาร์ป (ต้องเป็นลูกของ Part)
local COOLDOWN_TIME = 2                                -- คูลดาวน์ 2 วินาที กันวาร์ปรัว
local FADE_TIME = 0.35                                 -- ระยะเวลา fade เข้า/ออก 1 รอบ (วินาที)
local EXIT_POSITION = Vector3.new(__X__, __Y__, __Z__) -- ตำแหน่งปลายทาง (ค่าจริงตอนกด L)
local EXIT_YAW = math.rad(__YAW__)                     -- มุมหันของตัวละคร ณ ปลายทาง (หน่วยองศา)

local lastTeleportTime = {}                            -- เก็บเวลาวาร์ปล่าสุดของผู้เล่นแต่ละคน

-- ฟังก์ชัน Fade หน้าจอดำ + วาร์ปตัวละคร (เรียกจากอีเวนต์ Touched)
local function fadeAndTeleport(targetPlayer, character)
	local gui = Instance.new("ScreenGui")               -- สร้าง GUI ชั่วคราวสำหรับจอดำ
	gui.Name = "TeleportFadeGui"                        -- ตั้งชื่อ GUI
	gui.IgnoreGuiInset = true                           -- ให้ครอบคลุมถึงแถบ UI ด้านบน
	gui.ResetOnSpawn = false                            -- ไม่ล้างตอนตัวละครเกิดใหม่
	gui.DisplayOrder = 9999                             -- ให้ทับ GUI อื่นทั้งหมด
	local frame = Instance.new("Frame")                 -- กรอบสีดำเต็มจอ
	frame.Size = UDim2.fromScale(1, 1)                  -- ครอบคลุมทั้งจอ
	frame.BackgroundColor3 = Color3.new(0, 0, 0)        -- สีดำสนิท
	frame.BackgroundTransparency = 1                    -- เริ่มโปร่งใส 100%
	frame.BorderSizePixel = 0                           -- ปิดเส้นขอบ
	frame.Parent = gui                                  -- ใส่ Frame เข้า GUI
	gui.Parent = targetPlayer:WaitForChild("PlayerGui") -- ใส่ GUI เข้า PlayerGui ของผู้เล่น
	local fadeIn = TweenService:Create(frame, TweenInfo.new(FADE_TIME, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {BackgroundTransparency = 0})
	fadeIn:Play()                                       -- เริ่ม fade เป็นสีดำ
	fadeIn.Completed:Wait()                             -- รอจนจอดำสนิท
	if character and character.Parent and character:FindFirstChild("HumanoidRootPart") then
		character.HumanoidRootPart.CFrame = CFrame.new(EXIT_POSITION) * CFrame.Angles(0, EXIT_YAW, 0)
	end                                                 -- ย้ายตัวละครไปตำแหน่งปลายทาง
	local fadeOut = TweenService:Create(frame, TweenInfo.new(FADE_TIME, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {BackgroundTransparency = 1})
	fadeOut:Play()                                      -- เริ่ม fade กลับเป็นจอใส
	fadeOut.Completed:Wait()                            -- รอจนจอใสสนิท
	gui:Destroy()                                       -- ลบ GUI ชั่วคราวทิ้ง
end

-- หา Model ตัวละครจาก Part ที่แตะประตู (คืน nil ถ้าไม่ใช่ตัวละคร)
local function findCharacterFromHit(hitPart)
	local model = hitPart:FindFirstAncestorOfClass("Model")     -- หา ancestor ที่ใกล้ที่สุดซึ่งเป็น Model
	if model and model:FindFirstChildOfClass("Humanoid") then    -- Model ที่มี Humanoid อยู่ = ตัวละคร
		return model                                             -- คืน Model ตัวละคร
	end
	return nil                                                   -- ไม่ใช่ตัวละคร → คืน nil
end

gate.Touched:Connect(function(hit)                      -- ฟังอีเวนต์ทุกครั้งที่มีอะไรแตะประตู
	local hitCharacter = findCharacterFromHit(hit)       -- หาตัวละครจากสิ่งที่แตะ
	if not hitCharacter then return end                  -- ไม่ใช่ตัวละคร → จบการทำงาน
	local hitHumanoid = hitCharacter:FindFirstChildOfClass("Humanoid") -- ดึง Humanoid มาตรวจ
	if not hitHumanoid or hitHumanoid.Health <= 0 then return end      -- ไม่มี Humanoid/ตายแล้ว → ข้าม
	local touchPlayer = Players:GetPlayerFromCharacter(hitCharacter)   -- หาผู้เล่นที่เป็นเจ้าของตัวละคร
	if not touchPlayer then return end                   -- ไม่ใช่ผู้เล่น (เช่น NPC) → ข้าม
	local now = os.clock()                               -- อ่านเวลาปัจจุบัน (หน่วย วินาที)
	local last = lastTeleportTime[touchPlayer]           -- เวลาที่ผู้เล่นคนนี้วาร์ปล่าสุด
	if last and (now - last) < COOLDOWN_TIME then return end   -- ยังไม่ครบ 2 วิ → ห้ามวาร์ปซ้ำ
	lastTeleportTime[touchPlayer] = now                  -- บันทึกเวลาวาร์ปล่าสุดของผู้เล่นคนนี้
	task.spawn(fadeAndTeleport, touchPlayer, hitCharacter) -- รัน fade+วาร์ปแบบไม่บล็อกอีเวนต์
end)

Players.PlayerRemoving:Connect(function(leavingPlayer)  -- เมื่อผู้เล่นคนใดออกจากเกม
	lastTeleportTime[leavingPlayer] = nil                -- ลบข้อมูลคูลดาวน์ของผู้เล่นคนนั้น
end)
]==]

-- คืนซอร์สโค้ดสคริปต์วาร์ปที่ฝังค่าตำแหน่ง/มุมปลายทาง (Point 2) จริงเรียบร้อยแล้ว
local function buildGateSource(exitCFrame)
	local position = exitCFrame.Position                     -- ดึงเฉพาะตำแหน่ง (Vector3) ของจุดปลายทาง
	local _, yaw = exitCFrame:ToEulerAnglesYXZ()              -- ดึงมุมหันรอบแกน Y (Yaw) ของจุดปลายทาง
	local result = GATE_SOURCE_TEMPLATE                      -- เริ่มจากเทมเพลตที่เตรียมไว้
	result = string.gsub(result, "__X__", tostring(position.X))     -- แทนที่ค่า X ด้วยค่าจริง
	result = string.gsub(result, "__Y__", tostring(position.Y))     -- แทนที่ค่า Y ด้วยค่าจริง
	result = string.gsub(result, "__Z__", tostring(position.Z))     -- แทนที่ค่า Z ด้วยค่าจริง
	result = string.gsub(result, "__YAW__", tostring(math.deg(yaw))) -- แทนที่มุมหันด้วยหน่วยองศา
	return result                                             -- คืนซอร์สโค้ดที่สมบูรณ์
end

-- คีย์ L: สร้างประตูวาร์ปที่ Point 1 พร้อมใส่ Script วาร์ป และพิมพ์ซอร์สโค้ดลง Output
local function buildGate()
	if not point1 then                                        -- ยังไม่ได้ตั้ง Point 1
		print("[DevUtility] ยังไม่ได้ตั้ง Point 1 — กด K เพื่อบันทึกจุดเริ่มต้นก่อน") -- แจ้งเตือน
		return                                                 -- หยุด ไม่สร้างประตู
	end
	if not rootPart then                                      -- ยังไม่มีตัวละคร
		print("[DevUtility] ยังไม่มีตัวละคร — ยังสร้างประตูวาร์ปไม่ได้") -- แจ้งเตือน
		return                                                 -- หยุด
	end
	point2 = rootPart.CFrame                                  -- บันทึกจุดปลายทาง (Exit) จากตำแหน่งที่ยืนอยู่ตอนกด L
	local gate = Instance.new("Part")                         -- สร้าง Part สำหรับเป็นประตูวาร์ป
	gate.Name = "TeleportGate"                                -- ตั้งชื่อประตู
	gate.Size = Vector3.new(8, 10, 1)                         -- รูปทรงประตู: กว้าง 8 สูง 10 หนา 1 สตั๊ด
	gate.Color = Color3.fromRGB(0, 140, 255)                  -- สีฟ้าตามข้อกำหนด
	gate.Transparency = 0.5                                   -- โปร่งแสง 50% ตามข้อกำหนด
	gate.Material = Enum.Material.Neon                        -- วัสดุเรืองแสง ให้ดูเหมือนประตูวาร์ป
	gate.Anchored = true                                      -- ยึดค้างไว้ไม่ให้ตกหรือถูกดัน
	gate.CanCollide = false                                   -- ไม่มีการชน เพื่อให้เดินเข้าไปกระตุ้นได้โดยไม่ติด
	-- วางประตูให้ "ตั้งอยู่บนพื้น" โดยกะว่าพื้นอยู่ใต้จุดที่ยืน ~3 สตั๊ด (ความสูง HumanoidRootPart โดยประมาณ)
	local floorPosition = point1.Position - Vector3.new(0, 3, 0)            -- ตำแหน่งพื้นโดยประมาณใต้จุดเริ่มต้น
	local gatePosition = floorPosition + Vector3.new(0, gate.Size.Y / 2, 0) -- ยกกึ่งกลางประตูให้เท่ากับครึ่งความสูง
	local _, yaw = point1:ToEulerAnglesYXZ()                                -- ดึงมุมหัน (Yaw) ของจุดเริ่มต้น
	gate.CFrame = CFrame.new(gatePosition) * CFrame.Angles(0, yaw, 0)       -- ตั้งตำแหน่ง + หันหน้าตามตัวละครตอนกด K
	gate.Parent = workspace                                     -- ใส่ประตูเข้า Workspace เพื่อให้มองเห็น
	-- สร้างซอร์สโค้ดของสคริปต์วาร์ปสำหรับจุดปลายทางรอบนี้
	local source = buildGateSource(point2)
	-- สร้าง Script (server) เป็นลูกของประตูตามที่ขอ
	local gateScript = Instance.new("Script")
	gateScript.Name = "TeleportGateHandler"                    -- ตั้งชื่อสคริปต์ให้สื่อความหมาย
	local sourceOK, sourceErr = pcall(function()               -- พยายามใส่เนื้อหาสคริปต์ (อาจติดข้อจำกัดสิทธิ์)
		gateScript.Source = source                             -- กำหนดเนื้อหาของ Script
	end)
	if not sourceOK then                                       -- เขียน Script.Source ไม่สำเร็จ (คาดว่าติดสิทธิ์ Plugin)
		local stash = Instance.new("StringValue")               -- สร้าง StringValue สำรองเก็บซอร์ส
		stash.Name = "SourceCode_คัดลอกไปใส่ในScript"           -- ตั้งชื่อบอกวิธีใช้
		stash.Value = source                                   -- เก็บซอร์สโค้ดทั้งหมดไว้ในนี้
		stash.Parent = gate                                    -- ใส่ StringValue เข้าไปในประตู
		print("[DevUtility] แจ้งเตือน: เขียน Script.Source ไม่ได้ (" .. tostring(sourceErr) .. ") → เก็บซอร์สไว้ใน StringValue แล้ว")
	end
	gateScript.Parent = gate                                   -- ใส่ Script เข้าไปใน Part ประตู
	-- บันทึกข้อมูลประตูลงตาราง เพื่อใช้ตรวจจับฝั่ง Client และให้คีย์ C ล้างได้
	gates[#gates + 1] = {
		part = gate,                                           -- อ้างอิง Part ประตู
		exitCFrame = point2,                                   -- CFrame ปลายทาง (จุดที่ยืนตอนกด L)
		lastTeleport = 0,                                      -- เวลาอนุญาตวาร์ปครั้งถัดไป (0 = วาร์ปได้ทันที)
	}
	print("[DevUtility] สร้างประตูวาร์ปแล้ว | Point 1 (ประตู): " .. formatVector3(point1.Position) .. " | Point 2 (ปลายทาง): " .. formatVector3(point2.Position))
	print("[DevUtility] ===== ซอร์สโค้ดสคริปต์วาร์ป (คัดลอกไปวางใน Part ประตู) =====\n" .. source .. "\n[DevUtility] ===== สิ้นสุดซอร์สโค้ด =====")
end

-- คีย์ C: ลบ Part ทดสอบและประตูวาร์ปทั้งหมดที่เสกออกมาทิ้ง (Clean Up)
local function cleanUp()
	local removed = 0                                          -- ตัวนับจำนวน Instance ที่ถูกลบ
	for i = #spawnedParts, 1, -1 do                            -- วนจากท้ายตารางของ Part ทดสอบ
		local part = spawnedParts[i]                           -- หยิบ Part แต่ละชิ้น
		if part and part.Parent then                           -- ถ้ายังอยู่ในเกม
			part:Destroy()                                     -- ทำลาย Part ทิ้ง
			removed = removed + 1                              -- นับจำนวนที่ลบ
		end
		spawnedParts[i] = nil                                  -- เคลียร์ค่าออกจากตาราง
	end
	for i = #gates, 1, -1 do                                   -- วนจากท้ายตารางของประตูวาร์ป
		local gateInfo = gates[i]                              -- หยิบข้อมูลประตูแต่ละบาน
		if gateInfo.part and gateInfo.part.Parent then         -- ถ้าประตูยังอยู่ในเกม
			gateInfo.part:Destroy()                            -- ทำลายทั้งประตูและ Script/StringValue ข้างใน
			removed = removed + 1                              -- นับจำนวนที่ลบ
		end
		gates[i] = nil                                         -- เคลียร์ค่าออกจากตาราง
	end
	print("[DevUtility] Clean Up: ลบ Instance ที่เสกออกมาทั้งหมดแล้ว " .. removed .. " ชิ้น")
	print("[DevUtility] (จุด Point 1/Point 2 ยังถูกเก็บไว้ — กด K/L ใหม่เพื่อทับค่าเดิมได้)")
end

-- ===================== จัดการคีย์ลัดทั้งหมด =====================
UserInputService.InputBegan:Connect(function(input, gameProcessedEvent)
	if gameProcessedEvent then return end                       -- ถ้ามี GUI/ช่องแชทรับเหตุการณ์นี้ไปแล้ว (เช่นกำลังพิมพ์แชท) → ไม่ตอบสนอง
	if input.UserInputType ~= Enum.UserInputType.Keyboard then return end -- รับเฉพาะการกดคีย์บอร์ดเท่านั้น
	local key = input.KeyCode                                   -- คีย์ที่ผู้ใช้กดเข้ามา

	if key == Enum.KeyCode.P then                               -- คีย์ P: พิมพ์พิกัดตัวละครปัจจุบัน
		if rootPart then                                        -- ถ้ามีตัวละคร
			print("[DevUtility] ตำแหน่งตัวละครปัจจุบัน: " .. formatVector3(rootPart.Position)) -- พิมพ์เป็น Vector3.new(...)
		else                                                    -- ยังไม่มีตัวละคร
			print("[DevUtility] ยังไม่มีตัวละคร")               -- แจ้งเตือน
		end

	elseif key == Enum.KeyCode.B then                           -- คีย์ B: เสก Part สีแดง 4x4x4 ตรงหน้าตัวละคร
		spawnTestPart()                                         -- เรียกฟังก์ชันเสก Part

	elseif key == Enum.KeyCode.M then                           -- คีย์ M: คำนวณระยะห่างถึงจุดที่เมาส์ชี้
		local hit = getMouseHit()                               -- ยิง Ray หาจุดที่เมาส์ชี้
		if rootPart and hit then                                -- มีทั้งตัวละครและจุดที่ชี้เจอ
			local distance = (rootPart.Position - hit.Position).Magnitude -- คำนวณระยะทางระหว่าง 2 จุด (สตั๊ด)
			print("[DevUtility] ระยะห่างถึงจุดที่เมาส์ชี้: " .. string.format("%.2f", distance) .. " Studs") -- พิมพ์ระยะทาง
		elseif not hit then                                     -- ชี้ไปที่ว่าง (ไม่โดนวัตถุ)
			print("[DevUtility] ไม่พบพื้นผิวที่เมาส์ชี้ (ชี้ไปที่ว่าง)") -- แจ้งเตือน
		else                                                    -- ยังไม่มีตัวละคร
			print("[DevUtility] ยังไม่มีตัวละคร")               -- แจ้งเตือน
		end

	elseif key == Enum.KeyCode.F2 then                          -- คีย์ F2: เพิ่ม Coins ใน leaderstats +1,000
		local leaderstats = player:FindFirstChild("leaderstats") -- หาโฟลเดอร์ leaderstats ของผู้เล่น
		local coins = leaderstats and leaderstats:FindFirstChild("Coins") -- หาค่า Coins ข้างใน (ถ้ามี)
		if coins and (coins:IsA("IntValue") or coins:IsA("NumberValue")) then -- เจอค่า Coins ประเภทตัวเลข
			coins.Value = coins.Value + 1000                   -- เพิ่มค่า Coins ให้ผู้เล่น 1,000
			print("[DevUtility] Coins +1,000 → ปัจจุบัน = " .. tostring(coins.Value)) -- พิมพ์ค่าใหม่
		else                                                    -- ไม่พบ leaderstats หรือค่า Coins
			print("[DevUtility] ไม่พบค่า Coins ใน leaderstats — ไม่ได้เพิ่มค่า") -- แจ้งเตือนตามจริง
		end

	elseif key == Enum.KeyCode.F3 then                          -- คีย์ F3: สลับโหมดวิ่งเร็ว + รีเลือดเต็ม
		if not humanoid then                                    -- ยังไม่มี Humanoid
			print("[DevUtility] ยังไม่มีตัวละคร")               -- แจ้งเตือน
		else                                                    -- มี Humanoid พร้อมใช้งาน
			speedMode = not speedMode                           -- สลับสถานะโหมดวิ่งเร็ว
			if speedMode then                                   -- ถ้าเพิ่งเปิดโหมดวิ่งเร็ว
				humanoid.WalkSpeed = 50                         -- ตั้งความเร็ววิ่งเป็น 50 ตามข้อกำหนด
				humanoid.Health = humanoid.MaxHealth            -- รีเลือดกลับมาเต็มหลอด
				print("[DevUtility] เปิดโหมดวิ่งเร็ว: WalkSpeed = 50 + รีเลือดเต็ม")
			else                                                -- ถ้าเพิ่งปิดโหมดวิ่งเร็ว
				humanoid.WalkSpeed = 16                         -- คืนค่าความเร็วเป็นค่าเริ่มต้นของ Roblox
				print("[DevUtility] ปิดโหมดวิ่งเร็ว → WalkSpeed = 16")
			end
		end

	elseif key == Enum.KeyCode.T then                           -- คีย์ T: วาร์ปตัวละครไปยังจุดที่เมาส์ชี้
		local hit = getMouseHit()                               -- ยิง Ray หาจุดที่เมาส์ชี้
		if rootPart and hit then                                -- มีทั้งตัวละครและจุดที่ชี้เจอ
			local targetPosition = hit.Position + Vector3.new(0, 3, 0) -- ยกขึ้น 3 สตั๊ด กันตัวละครจมลงในพื้น
			local currentCFrame = rootPart.CFrame               -- เก็บ CFrame ปัจจุบันไว้ใช้ต่อ
			rootPart.CFrame = CFrame.new(targetPosition) * (currentCFrame - currentCFrame.Position) -- วาร์ปแบบรักษาทิศทางเดิม
			print("[DevUtility] วาร์ปไปยัง " .. formatVector3(targetPosition)) -- พิมพ์ตำแหน่งปลายทาง
		elseif not hit then                                     -- ชี้ไปที่ว่าง
			print("[DevUtility] ไม่พบพื้นผิวที่เมาส์ชี้ — ยังวาร์ปไม่ได้") -- แจ้งเตือน
		else                                                    -- ยังไม่มีตัวละคร
			print("[DevUtility] ยังไม่มีตัวละคร")               -- แจ้งเตือน
		end

	elseif key == Enum.KeyCode.N then                           -- คีย์ N: สลับเปิด/ปิดโหมด NoClip
		noClipEnabled = not noClipEnabled                       -- สลับสถานะโหมด NoClip
		if noClipEnabled then                                   -- ถ้าเพิ่งเปิด NoClip
			print("[DevUtility] เปิดโหมด NoClip — เดินทะลุกำแพงได้แล้ว")
		else                                                    -- ถ้าเพิ่งปิด NoClip
			if character then                                   -- ถ้ามีตัวละคร
				for _, part in ipairs(character:GetDescendants()) do -- วนทุก Instance ภายในตัวละคร
					if part:IsA("BasePart") then                -- เฉพาะ Part ที่มีรูปร่างเท่านั้น
						part.CanCollide = true                  -- คืนค่าให้ชนของแข็งได้ตามปกติ
					end
				end
			end
			print("[DevUtility] ปิดโหมด NoClip — การชนกลับมาปกติแล้ว (ถ้าอยู่กลางกำแพงให้เดินออกมาก่อน)")
		end

	elseif key == Enum.KeyCode.C then                           -- คีย์ C: Clean Up ล้างสิ่งที่เสกออกมา
		cleanUp()                                               -- เรียกฟังก์ชันล้าง Part ทดสอบและประตูวาร์ป

	elseif key == Enum.KeyCode.K then                           -- คีย์ K: Set Point 1 (Entrance)
		if rootPart then                                        -- ถ้ามีตัวละคร
			point1 = rootPart.CFrame                            -- บันทึกจุดเริ่มต้นจากตำแหน่งที่ยืนอยู่ (เก็บทั้งตำแหน่ง+ทิศทาง)
			print("[DevUtility] บันทึก Point 1 (Entrance) ที่ " .. formatVector3(point1.Position)) -- ยืนยันการบันทึก
		else                                                    -- ยังไม่มีตัวละคร
			print("[DevUtility] ยังไม่มีตัวละคร — ยังตั้ง Point 1 ไม่ได้") -- แจ้งเตือน
		end

	elseif key == Enum.KeyCode.L then                           -- คีย์ L: Set Point 2 (Exit) + สร้างประตูวาร์ป
		buildGate()                                             -- เรียกฟังก์ชันสร้างประตู (เช็ค Point 1 ข้างในเอง)
	end
end)

-- ===================== ลูปทำงานทุกเฟรม (HUD + ตรวจจับประตูวาร์ป) =====================
RunService.Heartbeat:Connect(function()
	-- 1) อัปเดต HUD: พิกัดแบบเรียลไทม์ + สถานะ Speed/NoClip
	if rootPart and rootPart.Parent then                        -- ถ้ามีตัวละครและยังอยู่ในเกม
		hudText.Text = table.concat({                           -- ต่อข้อความหลายบรรทัดเป็นก้อนเดียว
			"[ DEV UTILITY & TELEPORT ]",                       -- บรรทัดหัวเรื่อง
			"POS: " .. formatVector3(rootPart.Position),        -- บรรทัดพิกัดตัวละครปัจจุบัน
			"Speed: " .. (speedMode and "ON" or "OFF")          -- บรรทัดสถานะโหมดวิ่งเร็ว
				.. "  |  NoClip: " .. (noClipEnabled and "ON" or "OFF"), -- ต่อด้วยสถานะโหมด NoClip
		}, "\n")                                                -- คั่นแต่ละบรรทัดด้วยขึ้นบรรทัดใหม่
	else                                                        -- ยังไม่มีตัวละคร
		hudText.Text = table.concat({                           -- แสดงข้อความรอตัวละคร
			"[ DEV UTILITY & TELEPORT ]",                       -- บรรทัดหัวเรื่อง
			"POS: (waiting for character)",                     -- ยังไม่มีตัวละครให้อ่านพิกัด
			"Speed: " .. (speedMode and "ON" or "OFF")          -- สถานะโหมดวิ่งเร็ว
				.. "  |  NoClip: " .. (noClipEnabled and "ON" or "OFF"), -- สถานะโหมด NoClip
		}, "\n")                                                -- คั่นด้วยขึ้นบรรทัดใหม่
	end

	-- 2) ตรวจจับการเดินเข้าไปในประตูวาร์ป (ระบบฝั่ง Client สำหรับทดสอบทันที)
	if rootPart and rootPart.Parent and #gates > 0 then         -- มีตัวละครและมีประตูที่ต้องตรวจ
		local now = os.clock()                                  -- อ่านเวลาปัจจุบันไว้ใช้เช็ค Cooldown
		for _, gateInfo in ipairs(gates) do                      -- วนตรวจประตูทุกบานที่เคยสร้าง
			local gatePart = gateInfo.part                      -- Part ของประตูบานนี้
			if gatePart and gatePart.Parent                     -- ประตูยังอยู่ในเกม
				and now >= gateInfo.lastTeleport                -- และพ้นคูลดาวน์ 2 วินาทีแล้ว
				and (rootPart.Position - gatePart.Position).Magnitude <= 40 then -- อยู่ใกล้ประตูไม่เกิน 40 สตั๊ด (ประหยัดการคำนวณ)
				local localPosition = gatePart.CFrame:PointToObjectSpace(rootPart.Position) -- แปลงพิกัดตัวละครเป็นระบบพิกัดของประตู
				local half = gatePart.Size * 0.5                -- ครึ่งหนึ่งของขนาดประตู (ใช้เป็นขอบเขตตรวจจับ)
				local inside = math.abs(localPosition.X) <= half.X + 2 -- อยู่ในแนวกว้าง (เผื่อ 2 สตั๊ด)
					and math.abs(localPosition.Z) <= half.Z + 2         -- อยู่ในแนวหน้า-หลัง (เผื่อ 2 สตั๊ด)
					and math.abs(localPosition.Y) <= half.Y + 3         -- อยู่ในแนวสูง (เผื่อ 3 สตั๊ด)
				if inside then                                   -- ตัวละครเดินเข้าเขตประตูแล้ว
					gateInfo.lastTeleport = now + 2              -- ตั้งคูลดาวน์ 2 วินาที กันวาร์ปรัว
					task.spawn(fadeOverlay, function()           -- รัน Fade + วาร์ปแบบไม่บล็อกเฟรมเกม
						if rootPart and rootPart.Parent then      -- เช็คอีกครั้งว่าตัวภาพยังอยู่ในเกม
							rootPart.CFrame = gateInfo.exitCFrame -- ย้ายตัวละครไปจุดปลายทาง (Point 2)
						end
					end)
				end
			end
		end
	end
end)

-- ===================== ลูป NoClip (ปิดการชนก่อนขั้นตอนฟิสิกส์ทุกเฟรม) =====================
RunService.Stepped:Connect(function()
	if noClipEnabled and character and character.Parent then     -- ถ้าเปิด NoClip และมีตัวละคร
		for _, part in ipairs(character:GetDescendants()) do      -- วนทุก Instance ภายในตัวละคร
			if part:IsA("BasePart") then                          -- เฉพาะ Part ที่มีรูปร่างเท่านั้น
				part.CanCollide = false                           -- ปิดการชน → เดินทะลุกำแพงได้ (ทุกเฟรม)
			end
		end
	end
end)
