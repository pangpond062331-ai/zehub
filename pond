-- ==================== INITIALIZATION ====================
-- 0) โหลดการตั้งค่าที่บันทึกไว้ก่อน — LoadValidated จะ fire listeners ที่ผูกไว้แล้ว
--    (เช่น WindowOpacity ที่ผูกไว้ตอนสร้างหน้าต่าง) และค่าที่โหลดจะถูกใช้โดย
--    State.Bind ในขั้นถัดไปที่ fire ทันทีด้วยค่าปัจจุบัน
pcall(function()
	SaveService.RefreshBridge()
end)
pcall(function()
	SaveService.LoadAutosave()
end)

-- 0b) โมดูลถูกลงทะเบียนก่อนที่ autosave จะถูกโหลด ดังนั้น mod.data ยังเป็นค่า default
--     จึงต้อง sync ค่าจาก State ที่เพิ่งโหลดเข้า mod.data ใหม่ก่อน RestoreStates
for _, mod in ipairs(ModuleRegistry.list) do
	local saved = State.Get("ModuleData." .. mod.id)
	if type(saved) == "table" then
		mod.data = deepCopy(saved)
	end
end

-- 1) ผูก State -> ระบบ (แต่ละตัว fire ทันทีด้วยค่าปัจจุบันที่เพิ่งโหลด)
--    Localization.SetLanguage กับ ThemeEngine.Set มีการ refresh bindings ภายในอยู่แล้ว
State.Bind("Language", function(lang)
	Localization.SetLanguage(lang)
end)
