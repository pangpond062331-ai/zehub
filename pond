-- PAGE: MODULE MANAGER
-- ═══════════════════════════════════════════════════════════════════════════
local function buildModulesPage(page)
	local scroll = UI.MakeScroll(page)

	UI.Section(scroll, "modules.title", 1)

	-- Development test tools (ปิดเป็นค่าเริ่มต้น)
	UI.Toggle({
		Parent = scroll,
		LabelKey = "modules.devTools",
		LayoutOrder = 2,
		StatePath = "DevTestMode",
		TooltipKey = "tip.devTools",
		OnChanged = function(v)
			Notify.Show(v and "warning" or "info",
				v and "notify.devToolsOn" or "notify.devToolsOff",
				v and "modules.devToolsWarning" or "notify.devToolsOff", nil, 4)
			ModuleRegistry.changed:Fire()
		end,
	})

	local devWarning = Instance.new("TextLabel")
	devWarning.LayoutOrder = 3
	devWarning.Size = UDim2.new(1, 0, 0, 0)
	devWarning.AutomaticSize = Enum.AutomaticSize.Y
	devWarning.BackgroundTransparency = 1
	devWarning.Font = Enum.Font.Gotham
	devWarning.TextSize = 10
	devWarning.TextWrapped = true
	devWarning.TextXAlignment = Enum.TextXAlignment.Left
	devWarning.Parent = scroll
	Localization.BindText(devWarning, "modules.devToolsWarning")
	ThemeEngine.Bind(function(c)
		if devWarning.Parent then devWarning.TextColor3 = c.Warning end
	end)

	UI.Button({
		Parent = scroll,
		LabelKey = "common.refresh",
		Style = "secondary",
		LayoutOrder = 4,
		OnClick = function()
			SaveService.RefreshBridge()
			ModuleRegistry.changed:Fire()
			Notify.Show("info", "adv.diagRan", "adv.diagRan", nil, 2)
		end,
	})

	local listFrame = Instance.new("Frame")
	listFrame.LayoutOrder = 5
	listFrame.Size = UDim2.new(1, 0, 0, 0)
	listFrame.AutomaticSize = Enum.AutomaticSize.Y
	listFrame.BackgroundTransparency = 1
	listFrame.Parent = scroll
	local listLayout = Instance.new("UIListLayout")
	listLayout.SortOrder = Enum.SortOrder.LayoutOrder
	listLayout.Padding = UDim.new(0, 6)
	listLayout.Parent = listFrame

	local function rebuildRows()
		for _, child in ipairs(listFrame:GetChildren()) do
			if child:IsA("Frame") or child:IsA("TextLabel") then
				child:Destroy()
			end
		end
		local c = ThemeEngine.GetColors()
		if #ModuleRegistry.list == 0 then
			local empty = Instance.new("TextLabel")
			empty.Size = UDim2.new(1, 0, 0, 30)
			empty.BackgroundTransparency = 1
			empty.Font = Enum.Font.Gotham
			empty.TextSize = 12
			empty.TextColor3 = c.TextDim
			empty.Text = Localization.L("modules.empty")
			empty.Parent = listFrame
			return
		end
		for order, mod in ipairs(ModuleRegistry.list) do
			local avail = ModuleRegistry.GetAvailability(mod)
			local statusKey = ModuleRegistry.GetStatusKey(mod)
			local rowH = mod.lastError and 78 or 58
			local row = Instance.new("Frame")
			row.Size = UDim2.new(1, 0, 0, rowH)
			row.LayoutOrder = order
			row.BackgroundColor3 = c.PanelAlt
			row.BackgroundTransparency = 0.45
			row.BorderSizePixel = 0
			row.Parent = listFrame
			UI.Corner(row, 8)
			local stroke = UI.Stroke(row, mod.enabled and c.Accent or c.Border, 1, mod.enabled and 0.45 or 0.65)

			local name = Instance.new("TextLabel")
			name.Size = UDim2.new(1, -130, 0, 22)
			name.Position = UDim2.new(0, 12, 0, 6)
			name.BackgroundTransparency = 1
			name.Font = Enum.Font.GothamBold
			name.TextSize = 13
			name.TextColor3 = c.Text
			name.TextXAlignment = Enum.TextXAlignment.Left
			name.TextTruncate = Enum.TextTruncate.AtEnd
			name.Parent = row
			Localization.BindText(name, mod.nameKey)

			local meta = Instance.new("TextLabel")
			meta.Size = UDim2.new(1, -130, 0, 18)
			meta.Position = UDim2.new(0, 12, 0, 28)
			meta.BackgroundTransparency = 1
			meta.Font = Enum.Font.Gotham
			meta.TextSize = 10
			meta.TextColor3 = c.TextDim
			meta.TextXAlignment = Enum.TextXAlignment.Left
			meta.Parent = row
			Localization.Bind(meta, function()
				meta.Text = string.format("v%s  ·  %s", tostring(mod.version or "1.0.0"),
					Localization.L("category." .. tostring(mod.category or "system"):lower()))
			end)

			if mod.lastError then
				local errLabel = Instance.new("TextLabel")
				errLabel.Size = UDim2.new(1, -24, 0, 28)
				errLabel.Position = UDim2.new(0, 12, 0, 47)
				errLabel.BackgroundTransparency = 1
				errLabel.Font = Enum.Font.Gotham
				errLabel.TextSize = 10
				errLabel.TextColor3 = c.Error
				errLabel.TextXAlignment = Enum.TextXAlignment.Left
				errLabel.TextTruncate = Enum.TextTruncate.AtEnd
				errLabel.Parent = row
				errLabel.Text = Localization.L("modules.lastError") .. ": " .. tostring(mod.lastError):sub(1, 80)
			end

			local chip = UI.StatusChip(row, 0, 108)
			chip.GetFrame().Position = UDim2.new(1, -120, 0, 8)
			chip.SetKey(statusKey, ModuleRegistry.StatusKind(statusKey))

			if mod.kind == "action" then
				UI.Button({
					Parent = row,
					LabelKey = "features.run",
					Style = "primary",
					Size = UDim2.new(0, 72, 0, 24),
					LayoutOrder = 0,
					Disabled = not avail.available,
					OnClick = function()
						ModuleRegistry.RunAction(mod.id)
					end,
				}).GetButton().Position = UDim2.new(1, -84, 0, 32)
			else
				UI.Button({
					Parent = row,
					Text = mod.enabled and Localization.L("common.on") or Localization.L("common.off"),
					Style = "secondary",
					Size = UDim2.new(0, 72, 0, 24),
					LayoutOrder = 0,
					Disabled = not avail.available,
					OnClick = function()
						ModuleRegistry.Toggle(mod.id)
					end,
				}).GetButton().Position = UDim2.new(1, -84, 0, 32)
			end

			if not avail.available then
				Tooltip.Attach(row, avail.reasonKey or "tip.moduleUnavailable")
			end

			local thToken
			thToken = ThemeEngine.Bind(function(cl)
				if not row.Parent then
					ThemeEngine.Unbind(thToken)
					return
				end
				row.BackgroundColor3 = cl.PanelAlt
				stroke.Color = mod.enabled and cl.Accent or cl.Border
				name.TextColor3 = cl.Text
				meta.TextColor3 = cl.TextDim
			end)
		end
	end

	rebuildRows()
	ModuleRegistry.changed:Connect(rebuildRows)
	Localization.Bind(rebuildRows)
end

