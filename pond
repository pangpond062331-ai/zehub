-- INPUT MANAGER (คีย์บอร์ด / เมาส์ / สัมผัส + ระบบจับคีย์ลัด)
-- ═══════════════════════════════════════════════════════════════════════════
do
	local binds = {}          -- { {key=Enum.KeyCode, fn=fn, fireOnProcessed=bool} }
	local capturing = false
	local captureCb = nil
	local platformIsTouch = UserInputService.TouchEnabled
	local platformHasKeyboard = UserInputService.KeyboardEnabled

	function InputManager.GetPlatformName()
		if platformIsTouch and not platformHasKeyboard then
			return "Mobile"
		elseif platformHasKeyboard then
			return "PC"
		elseif platformIsTouch then
			return "Tablet"
		end
		return "Unknown"
	end

	function InputManager.IsTouch()
		return platformIsTouch
	end

	-- ผูกปุ่มลัด; คืน handle ที่มี Rebind/Disconnect
	function InputManager.Bind(key, fn, opts)
		if type(key) ~= "userdata" or type(fn) ~= "function" then
			ErrorHandling.Report("InputManager", "Bind: invalid key or fn", "warn")
			return nil
		end
		opts = opts or {}
		local bind = {
			key = key,
			fn = fn,
			fireOnProcessed = opts.FireOnGameProcessed == true,
		}
		table.insert(binds, bind)
		local handle = {}
		function handle.Rebind(newKey)
			if type(newKey) ~= "userdata" then return false end
			bind.key = newKey
			return true
		end
		function handle.GetKey()
			return bind.key
		end
		function handle.Disconnect()
			for i, b in ipairs(binds) do
				if b == bind then
					table.remove(binds, i)
					break
				end
			end
		end
		return handle
	end

	-- เริ่มโหมดจับคีย์: cb(key หรือ nil ถ้าล้าง, cancelled)
	function InputManager.BeginCapture(cb)
		capturing = true
		captureCb = cb
	end

	function InputManager.CancelCapture()
		if capturing then
			capturing = false
			local cb = captureCb
			captureCb = nil
			if cb then pcall(cb, nil, true) end
		end
	end

	function InputManager.IsCapturing()
		return capturing
	end

	function InputManager.GetBindCount()
		return #binds
	end

	-- ตัวรับ input หลัก
	UserInputService.InputBegan:Connect(function(input, gameProcessed)
		-- โหมดจับคีย์ลัด (ให้ทำงานแม้ gameProcessed เพื่อจับได้ทุกปุ่ม)
		if capturing then
			if input.UserInputType == Enum.UserInputType.Keyboard then
				local key = input.KeyCode
				if key == Enum.KeyCode.Escape then
					capturing = false
					local cb = captureCb
					captureCb = nil
					if cb then pcall(cb, nil, true) end
				elseif key == Enum.KeyCode.Backspace or key == Enum.KeyCode.Delete then
					capturing = false
					local cb = captureCb
					captureCb = nil
					if cb then pcall(cb, nil, false) end
				elseif key ~= Enum.KeyCode.Unknown then
					capturing = false
					local cb = captureCb
					captureCb = nil
					if cb then pcall(cb, key, false) end
				end
			end
			return
		end

		-- ไม่ตอบสนองคีย์เมื่อกำลังพิมพ์ใน TextBox
		local focused = UserInputService:GetFocusedTextBox()
		if focused and input.UserInputType == Enum.UserInputType.Keyboard then
			return
		end
		if gameProcessed and input.UserInputType ~= Enum.UserInputType.Keyboard then
			return
		end

		if input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode ~= Enum.KeyCode.Unknown then
			for _, b in ipairs(binds) do
				if b.key == input.KeyCode then
					local ok, err = pcall(b.fn)
					if not ok then
						ErrorHandling.Report("InputManager.Bind(" .. b.key.Name .. ")", err)
					end
				end
			end
		end
	end)

	Cleanup.OnTeardown(function()
		binds = {}
		InputManager.CancelCapture()
	end)
end

-- ═══════════════════════════════════════════════════════════════════════════
-- SAVE SERVICE
-- · Session profiles : เก็บในหน่วยความจำ + Attribute (เฉพาะรอบการเล่น)
-- · Server bridge    : ตรวจพบ ReplicatedStorage.AnimeNexusBridge อัตโนมัติ
-- · Import/Export    : JSON ผ่านกล่องข้อความ (ทำงานได้จริง)
-- ห้ามอ้างว่าบันทึกถาวรสำเร็จถ้าไม่ได้ต่อ bridge จริง
-- ═══════════════════════════════════════════════════════════════════════════
do
	local AUTOSAVE_ATTR = "ANX_ConfigV2"
	local bridge = nil
	local bridgeChecked = false
	local sessionProfiles = {}

	local function getBridge()
		if bridgeChecked then return bridge end
		bridgeChecked = true
		local ok, obj = pcall(function()
			return ReplicatedStorage:FindFirstChild("AnimeNexusBridge")
		end)
		if ok and obj and obj:IsA("RemoteFunction") then
			bridge = obj
		end
		return bridge
	end

	function SaveService.HasServerStorage()
		return getBridge() ~= nil
	end

	function SaveService.RefreshBridge()
		bridgeChecked = false
		bridge = nil
		return getBridge() ~= nil
	end

	local function bridgeSave(name, jsonStr)
		local b = getBridge()
		if not b then return false, "no-bridge" end
		local ok, result = pcall(function()
			return b:InvokeServer("Save", name, jsonStr)
		end)
		if not ok then
			ErrorHandling.Report("SaveService.Bridge", "Save invoke failed: " .. tostring(result))
			return false, tostring(result)
		end
		if result == true then return true end
		return false, tostring(result)
	end

	local function bridgeLoad(name)
		local b = getBridge()
		if not b then return nil, "no-bridge" end
		local ok, result = pcall(function()
			return b:InvokeServer("Load", name)
		end)
		if not ok then
			ErrorHandling.Report("SaveService.Bridge", "Load invoke failed: " .. tostring(result))
			return nil, tostring(result)
		end
		if type(result) == "string" and result ~= "" then
			return result
		end
		return nil, "empty"
	end

	-- Autosave ลง Attribute ของ LocalPlayer (หน่วยความจำ client — ข้าม respawn แต่ไม่ข้ามรอบ)
	function SaveService.Autosave()
		local ok, json = pcall(function()
			return HttpService:JSONEncode(State.GetAll())
		end)
		if not ok then
			ErrorHandling.Report("SaveService.Autosave", "JSONEncode failed: " .. tostring(json))
			return false
		end
		local okSet = pcall(function()
			LocalPlayer:SetAttribute(AUTOSAVE_ATTR, json)
		end)
		if not okSet then
			ErrorHandling.Report("SaveService.Autosave", "SetAttribute failed", "warn")
			return false
		end
		return true
	end

	function SaveService.LoadAutosave()
		local raw = nil
		pcall(function()
			raw = LocalPlayer:GetAttribute(AUTOSAVE_ATTR)
		end)
		if type(raw) ~= "string" or raw == "" then return false end
		local ok, decoded = pcall(function()
			return HttpService:JSONDecode(raw)
		end)
		if not ok or type(decoded) ~= "table" then
			ErrorHandling.Report("SaveService.LoadAutosave", "Autosave data is corrupt; using defaults", "warn")
			return false
		end
		local clean, issues = ValidateConfig(decoded)
		for _, issue in ipairs(issues) do
			ErrorHandling.Report("SaveService.Validate", "Autosave issue: " .. issue, "warn")
		end
		State.LoadValidated(clean)
		return true
	end

	function SaveService.GetProfileNames()
		local names = {}
		for name in pairs(sessionProfiles) do
			table.insert(names, name)
		end
		table.sort(names)
		return names
	end

	-- บันทึกโปรไฟล์: snapshot ปัจจุบัน → session + bridge (ถ้ามี)
	function SaveService.SaveProfile(name)
		name = trimString(name)
		if name == "" then return false, "config.invalidName" end
		local snapshot = State.GetAll()
		sessionProfiles[name] = snapshot
		SaveService.Autosave()
		if getBridge() then
			local jsonOk, json = pcall(function()
				return HttpService:JSONEncode(snapshot)
			end)
			if jsonOk then
				local ok, err = bridgeSave(name, json)
				if not ok then
					return false, "config.saveFailed"
				end
			else
				ErrorHandling.Report("SaveService.SaveProfile", "JSONEncode failed: " .. tostring(json))
				return false, "config.saveFailed"
			end
		end
		return true
	end

	function SaveService.LoadProfile(name)
		name = trimString(name)
		local raw = nil
		local data = sessionProfiles[name]
		if type(data) == "table" then
			raw = data
		else
			-- ลองโหลดจาก bridge
			local json, err = bridgeLoad(name)
			if json then
				local ok, decoded = pcall(function()
					return HttpService:JSONDecode(json)
				end)
				if ok and type(decoded) == "table" then
					raw = decoded
				else
					ErrorHandling.Report("SaveService.LoadProfile", "Bridge data corrupt for '" .. name .. "'")
					return false, "config.loadFailed"
				end
			elseif err ~= "no-bridge" and err ~= "empty" then
				return false, "config.loadFailed"
			end
		end
		if type(raw) ~= "table" then
			return false, "config.notFound"
		end
		local clean, issues = ValidateConfig(raw)
		for _, issue in ipairs(issues) do
			ErrorHandling.Report("SaveService.Validate", "Profile issue: " .. issue, "warn")
		end
		State.LoadValidated(clean)
		SaveService.Autosave()
		return true
	end

	function SaveService.DeleteProfile(name)
		name = trimString(name)
		sessionProfiles[name] = nil
		if getBridge() then
			pcall(function()
				bridge:InvokeServer("Delete", name)
			end)
		end
		return true
	end

	function SaveService.ExportString()
		local ok, json = pcall(function()
			return HttpService:JSONEncode(State.GetAll())
		end)
		if not ok then
			ErrorHandling.Report("SaveService.Export", "JSONEncode failed: " .. tostring(json))
			return nil
		end
		return json
	end

	function SaveService.ImportString(text)
		if type(text) ~= "string" or trimString(text) == "" then
			return false, { "empty input" }
		end
		local ok, decoded = pcall(function()
			return HttpService:JSONDecode(text)
		end)
		if not ok or type(decoded) ~= "table" then
			return false, { "invalid JSON" }
		end
		local clean, issues = ValidateConfig(decoded)
		if #issues > 0 then
			for _, issue in ipairs(issues) do
				ErrorHandling.Report("SaveService.Import", "Import issue: " .. issue, "warn")
			end
		end
		State.LoadValidated(clean)
		SaveService.Autosave()
		return true, issues
	end
end

-- ═══════════════════════════════════════════════════════════════════════════
-- NOTIFICATION MANAGER (Toast)
-- ═══════════════════════════════════════════════════════════════════════════
do
	local holder = nil
	local MAX_TOASTS = 4
	local createdCount = 0

	local KIND_ICON = {
		success = "✓",
		warning = "!",
		error   = "✕",
		info    = "i",
	}

	function Notify.Init(parentFrame)
		holder = Instance.new("Frame")
		holder.Name = "ToastHolder"
		holder.Size = UDim2.new(0, 300, 1, -20)
		holder.Position = UDim2.new(1, -312, 0, 10)
		holder.AnchorPoint = Vector2.new(0, 0)
		holder.BackgroundTransparency = 1
		holder.BorderSizePixel = 0
		holder.ClipsDescendants = false
		holder.Parent = parentFrame

		local layout = Instance.new("UIListLayout")
		layout.SortOrder = Enum.SortOrder.LayoutOrder
		layout.VerticalAlignment = Enum.VerticalAlignment.Top
		layout.HorizontalAlignment = Enum.HorizontalAlignment.Right
		layout.Padding = UDim.new(0, 6)
		layout.Parent = holder

		Cleanup.TrackInstance(holder)
	end

	-- เรียกโดย Window.ApplyLayout ปรับตำแหน่งตามแนวตั้ง/แนวนอน
	function Notify.SetNarrowLayout(isNarrow)
		if not holder then return end
		if isNarrow then
			holder.AnchorPoint = Vector2.new(0.5, 0)
			holder.Position = UDim2.new(0.5, 0, 0, 8)
		else
			holder.AnchorPoint = Vector2.new(0, 0)
			holder.Position = UDim2.new(1, -312, 0, 10)
		end
	end

	function Notify.SetWidth(width)
		if not holder then return end
		holder.Size = UDim2.new(0, width, 1, -20)
	end

	function Notify.Show(kind, titleKey, messageKey, params, duration, raw)
		if not holder then
			ErrorHandling.Report("Notify", "Notify.Show called before Init", "warn")
			return
		end
		local colors = ThemeEngine.GetColors()
		local styleColor = colors.Accent
		if kind == "success" then styleColor = colors.Success
		elseif kind == "warning" then styleColor = colors.Warning
		elseif kind == "error" then styleColor = colors.Error
		end

		-- จำกัดจำนวน toast (นับเฉพาะ Frame ที่เป็น toast)
		local function countToasts()
			local n = 0
			for _, child in ipairs(holder:GetChildren()) do
				if child:IsA("Frame") then n = n + 1 end
			end
			return n
		end
		while countToasts() >= MAX_TOASTS do
			local oldest = nil
			for _, child in ipairs(holder:GetChildren()) do
				if child:IsA("Frame") then
					oldest = child
					break
				end
			end
			if not oldest then break end
			oldest:Destroy()
		end

		createdCount = createdCount + 1
		local dur = duration or (kind == "error" and 6 or 4)

		local toast = Instance.new("Frame")
		toast.Name = "Toast" .. createdCount
		toast.Size = UDim2.new(1, 0, 0, 0)
		toast.AutomaticSize = Enum.AutomaticSize.Y
		toast.BackgroundColor3 = colors.Panel
		toast.BackgroundTransparency = 0.06
		toast.BorderSizePixel = 0
		toast.LayoutOrder = createdCount
		toast.ClipsDescendants = false
		toast.Parent = holder

		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0, 8)
		corner.Parent = toast

		local stroke = Instance.new("UIStroke")
		stroke.Color = styleColor
		stroke.Thickness = 1.4
		stroke.Transparency = 0.25
		stroke.Parent = toast

		local accentBar = Instance.new("Frame")
		accentBar.Size = UDim2.new(0, 4, 1, 0)
		accentBar.BackgroundColor3 = styleColor
		accentBar.BorderSizePixel = 0
		accentBar.Parent = toast
		local barCorner = Instance.new("UICorner")
		barCorner.CornerRadius = UDim.new(0, 2)
		barCorner.Parent = accentBar

		local icon = Instance.new("TextLabel")
		icon.Size = UDim2.new(0, 26, 0, 26)
		icon.Position = UDim2.new(0, 10, 0, 8)
		icon.BackgroundTransparency = 1
		icon.Text = KIND_ICON[kind] or "i"
		icon.TextColor3 = styleColor
		icon.Font = Enum.Font.GothamBold
		icon.TextSize = 15
		icon.Parent = toast

		local title = Instance.new("TextLabel")
		title.Size = UDim2.new(1, -70, 0, 18)
		title.Position = UDim2.new(0, 42, 0, 8)
		title.BackgroundTransparency = 1
		title.Font = Enum.Font.GothamBold
		title.TextSize = 12
		title.TextColor3 = colors.Text
		title.TextXAlignment = Enum.TextXAlignment.Left
		title.TextTruncate = Enum.TextTruncate.AtEnd
		title.Parent = toast
		if raw then
			title.Text = tostring(titleKey or "")
		else
			Localization.BindText(title, titleKey or ("common." .. kind), "Text", params)
		end

		local msg = Instance.new("TextLabel")
		msg.Size = UDim2.new(1, -70, 0, 0)
		msg.AutomaticSize = Enum.AutomaticSize.Y
		msg.Position = UDim2.new(0, 42, 0, 28)
		msg.BackgroundTransparency = 1
		msg.Font = Enum.Font.Gotham
		msg.TextSize = 11
		msg.TextColor3 = colors.TextDim
		msg.TextXAlignment = Enum.TextXAlignment.Left
		msg.TextWrapped = true
		msg.Parent = toast
		if raw then
			msg.Text = tostring(messageKey or "")
		else
			Localization.BindText(msg, messageKey or "err.generic", "Text", params)
		end

		local pad = Instance.new("UIPadding")
		pad.PaddingBottom = UDim.new(0, 8)
		pad.Parent = toast

		-- ปุ่มปิด
		local closeBtn = Instance.new("TextButton")
		closeBtn.Size = UDim2.new(0, 18, 0, 18)
		closeBtn.Position = UDim2.new(1, -22, 0, 6)
		closeBtn.BackgroundTransparency = 1
		closeBtn.Text = "×"
		closeBtn.Font = Enum.Font.GothamBold
		closeBtn.TextSize = 14
		closeBtn.TextColor3 = colors.TextDim
		closeBtn.Parent = toast

		local removed = false
		local function dismiss()
			if removed then return end
			removed = true
			if toast.Parent then
				if Perf.IsHeavyAllowed() and State.Get("Effects.ToastAnimation") then
					Perf.Tween(toast, { BackgroundTransparency = 1 }, 0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
					task.delay(Perf.Duration(0.22), function()
						if toast.Parent then toast:Destroy() end
					end)
				else
					toast:Destroy()
				end
			end
		end

		closeBtn.MouseButton1Click:Connect(dismiss)
		toast.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1
				or input.UserInputType == Enum.UserInputType.Touch then
				dismiss()
			end
		end)

		ThemeEngine.Bind(function(c)
			if toast.Parent then
				toast.BackgroundColor3 = c.Panel
				title.TextColor3 = c.Text
				msg.TextColor3 = c.TextDim
				closeBtn.TextColor3 = c.TextDim
			end
		end)

		-- แอนิเมชันเข้า
		if Perf.IsHeavyAllowed() and State.Get("Effects.ToastAnimation") then
			toast.BackgroundTransparency = 1
			toast.Position = UDim2.new(1, 24, 0, 0)
			Perf.Tween(toast, { BackgroundTransparency = 0.06, Position = UDim2.new(0, 0, 0, 0) }, 0.26, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
		end

		task.delay(dur, dismiss)
	end

	-- Convenience wrappers: pass raw text (not a key) for notifications that don't need translation
	function Notify.Success(message, duration)
		Notify.Show("success", message, message, nil, duration, true)
	end
	function Notify.Warning(message, duration)
		Notify.Show("warning", message, message, nil, duration, true)
	end
	function Notify.Error(message, duration)
		Notify.Show("error", message, message, nil, duration, true)
	end
	function Notify.Info(message, duration)
		Notify.Show("info", message, message, nil, duration, true)
	end

	function Notify.ClearAll()
		if not holder then return end
		for _, child in ipairs(holder:GetChildren()) do
			if child:IsA("Frame") then
				child:Destroy()
			end
		end
	end
end

-- ═══════════════════════════════════════════════════════════════════════════
-- TOOLTIP (hover บน PC / long-press บนมือถือ)
-- ═══════════════════════════════════════════════════════════════════════════
do
	local tipFrame = nil
	local tipLabel = nil
	local followConn = nil
	local hideDelay = nil

	function Tooltip.Init(rootFrame)
		tipFrame = Instance.new("Frame")
		tipFrame.Name = "Tooltip"
		tipFrame.Size = UDim2.new(0, 220, 0, 0)
		tipFrame.AutomaticSize = Enum.AutomaticSize.Y
		tipFrame.BackgroundColor3 = Color3.fromRGB(15, 15, 22)
		tipFrame.BackgroundTransparency = 0.05
		tipFrame.BorderSizePixel = 0
		tipFrame.Visible = false
		tipFrame.ZIndex = 80
		tipFrame.Parent = rootFrame

		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0, 6)
		corner.Parent = tipFrame

		local stroke = Instance.new("UIStroke")
		stroke.Thickness = 1
		stroke.Transparency = 0.4
		stroke.Parent = tipFrame

		tipLabel = Instance.new("TextLabel")
		tipLabel.Size = UDim2.new(1, -16, 0, 0)
		tipLabel.AutomaticSize = Enum.AutomaticSize.Y
		tipLabel.BackgroundTransparency = 1
		tipLabel.Font = Enum.Font.Gotham
		tipLabel.TextSize = 11
		tipLabel.TextWrapped = true
		tipLabel.TextXAlignment = Enum.TextXAlignment.Left
		tipLabel.TextColor3 = Color3.fromRGB(220, 225, 240)
		tipLabel.Parent = tipFrame

		local pad = Instance.new("UIPadding")
		pad.PaddingTop = UDim.new(0, 6)
		pad.PaddingBottom = UDim.new(0, 6)
		pad.PaddingLeft = UDim.new(0, 8)
		pad.PaddingRight = UDim.new(0, 8)
		pad.Parent = tipFrame

		ThemeEngine.Bind(function(c)
			if tipFrame then
				stroke.Color = c.Border
				tipLabel.TextColor3 = c.Text
			end
		end)
	end

	local function hideNow()
		if hideDelay then
			task.cancel(hideDelay)
			hideDelay = nil
		end
		if tipFrame then
			tipFrame.Visible = false
		end
		if followConn then
			followConn:Disconnect()
			followConn = nil
		end
	end

	local function positionTip(anchorPos)
		if not tipFrame then return end
		local rootSize = tipFrame.Parent and tipFrame.Parent.AbsoluteSize or Vector2.new(1280, 720)
		local tipSize = tipFrame.AbsoluteSize
		local x = anchorPos.X + 14
		local y = anchorPos.Y + 18
		if x + tipSize.X > rootSize.X - 8 then
			x = math.max(8, anchorPos.X - tipSize.X - 14)
		end
		if y + tipSize.Y > rootSize.Y - 8 then
			y = math.max(8, anchorPos.Y - tipSize.Y - 10)
		end
		tipFrame.Position = UDim2.fromOffset(x, y)
	end

	function Tooltip.Show(text, anchorPos)
		if not tipFrame or type(text) ~= "string" or text == "" then return end
		hideNow()
		tipLabel.Text = text
		tipFrame.Visible = true
		task.defer(function()
			if tipFrame and tipFrame.Visible then
				positionTip(anchorPos or UserInputService:GetMouseLocation())
			end
		end)
		-- ติดตามเมาส์เฉพาะตอนแสดง (ไม่มีลูปถาวร)
		followConn = RunService.RenderStepped:Connect(function()
			if not tipFrame or not tipFrame.Visible then
				hideNow()
				return
			end
			positionTip(UserInputService:GetMouseLocation())
		end)
	end

	function Tooltip.Hide()
		hideNow()
	end

	-- ผูก tooltip กับออบเจกต์: key หรือ function ที่คืนข้อความ
	function Tooltip.Attach(guiObject, keyOrFn)
		if not guiObject then return end
		local function resolve()
			if type(keyOrFn) == "function" then
				local ok, res = pcall(keyOrFn)
				if ok then return tostring(res) end
				return nil
			end
			return Localization.L(keyOrFn)
		end

		local touchTimer = nil
		local connEnter = guiObject.MouseEnter:Connect(function()
			if UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled then return end
			local text = resolve()
			if text then Tooltip.Show(text) end
		end)
		local connLeave = guiObject.MouseLeave:Connect(function()
			hideNow()
		end)
		local connBeg = guiObject.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.Touch then
				if touchTimer then task.cancel(touchTimer) end
				local pos = input.Position
				touchTimer = task.delay(0.45, function()
					touchTimer = nil
					local text = resolve()
					if text then
						Tooltip.Show(text, Vector2.new(pos.X, pos.Y))
					end
				end)
			end
		end)
		local connEnd = guiObject.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.Touch then
				if touchTimer then
					task.cancel(touchTimer)
					touchTimer = nil
				end
				hideNow()
			end
		end)
		Cleanup.Watch(connEnter, function() end)
		Cleanup.Watch(connLeave, function() end)
		Cleanup.Watch(connBeg, function() end)
		Cleanup.Watch(connEnd, function() end)
	end
end

-- ═══════════════════════════════════════════════════════════════════════════
-- OVERLAY (แผงลอย เช่น รายการ Dropdown) — แก้ปัญหาถูกตัดโดย ScrollingFrame
-- ═══════════════════════════════════════════════════════════════════════════
do
	local layer = nil
	local openContainer = nil
	local outsideConn = nil
	local anchorRef = nil

	function Overlay.Init(rootFrame)
		layer = Instance.new("Frame")
		layer.Name = "OverlayLayer"
		layer.Size = UDim2.fromScale(1, 1)
		layer.BackgroundTransparency = 1
		layer.BorderSizePixel = 0
		layer.Visible = false
		layer.ZIndex = 50
		layer.Parent = rootFrame
	end

	function Overlay.IsOpen()
		return openContainer ~= nil
	end

	function Overlay.Dismiss()
		if outsideConn then
			outsideConn:Disconnect()
			outsideConn = nil
		end
		if openContainer then
			openContainer:Destroy()
			openContainer = nil
		end
		anchorRef = nil
		if layer then
			layer.Visible = false
		end
	end

	-- buildFn(contentFrame, closeFn) สร้างเนื้อหาใน container
	function Overlay.Open(anchor, width, buildFn)
		if not layer then return end
		Overlay.Dismiss()
		local colors = ThemeEngine.GetColors()

		local container = Instance.new("Frame")
		container.Name = "OverlayPanel"
		container.Size = UDim2.new(0, width, 0, 0)
		container.AutomaticSize = Enum.AutomaticSize.Y
		container.BackgroundColor3 = colors.Panel
		container.BackgroundTransparency = 0.03
		container.BorderSizePixel = 0
		container.ZIndex = 51
		container.ClipsDescendants = false
		container.Parent = layer

		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0, 8)
		corner.Parent = container

		local stroke = Instance.new("UIStroke")
		stroke.Color = colors.Border
		stroke.Thickness = 1.2
		stroke.Parent = container

		ThemeEngine.Bind(function(c)
			if container.Parent then
				container.BackgroundColor3 = c.Panel
				stroke.Color = c.Border
			end
		end)

		openContainer = container
		anchorRef = anchor

		local okBuild, buildErr = pcall(buildFn, container, Overlay.Dismiss)
		if not okBuild then
			ErrorHandling.Report("Overlay.Build", buildErr)
			Overlay.Dismiss()
			return
		end

		-- จัดตำแหน่ง: ใต้ anchor ก่อน ถ้าล้นก็วางเหนือ anchor
		task.defer(function()
			if not container.Parent then return end
			local rootObj = layer.Parent
			if not rootObj then return end
			local rootSize = rootObj.AbsoluteSize
			local rootPos = rootObj.AbsolutePosition
			local cSize = container.AbsoluteSize
			local aPos = anchor.AbsolutePosition
			local aSize = anchor.AbsoluteSize

			local x = (aPos.X - rootPos.X)
			if x + cSize.X > rootSize.X - 8 then
				x = math.max(8, rootSize.X - cSize.X - 8)
			end
			local y = (aPos.Y - rootPos.Y) + aSize.Y + 4
			if y + cSize.Y > rootSize.Y - 8 then
				local yAbove = (aPos.Y - rootPos.Y) - cSize.Y - 4
				if yAbove < 8 then
					y = math.max(8, rootSize.Y - cSize.Y - 8)
				else
					y = yAbove
				end
			end
			container.Position = UDim2.fromOffset(x, y)
		end)

		-- คลิกนอกแผง → ปิด
		outsideConn = UserInputService.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1
				or input.UserInputType == Enum.UserInputType.Touch then
				if not openContainer or not openContainer.Parent then
					Overlay.Dismiss()
					return
				end
				local inPos = Vector2.new(input.Position.X, input.Position.Y)
				local cPos = openContainer.AbsolutePosition
				local cSize = openContainer.AbsoluteSize
				local inside = inPos.X >= cPos.X and inPos.X <= cPos.X + cSize.X
					and inPos.Y >= cPos.Y and inPos.Y <= cPos.Y + cSize.Y
				if not inside then
					Overlay.Dismiss()
				end
			end
		end)
	end
end

