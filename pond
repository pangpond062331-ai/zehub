-- ERROR HANDLING
-- เก็บประวัติข้อผิดพลาดเพื่อ Diagnostics และป้องกันข้อผิดพลาดของโมดูลหนึ่ง
-- ทำให้ทั้งระบบล่ม
-- ═══════════════════════════════════════════════════════════════════════════
local ErrorHandling = {}
do
	local LOG_MAX = 100
	local log = {}
	local listeners = {}

	function ErrorHandling.Report(context, message, level)
		local entry = {
			time     = os.time(),
			context  = tostring(context or "Unknown"),
			message  = tostring(message or "Unknown error"),
			level    = level or "error",
		}
		table.insert(log, 1, entry)
		while #log > LOG_MAX do
			table.remove(log)
		end
		warn(string.format("[AnimeNexus][%s][%s] %s", entry.level, entry.context, entry.message))
		for _, fn in ipairs(listeners) do
			pcall(fn, entry)
		end
		return entry
	end

	function ErrorHandling.AddListener(fn)
		if type(fn) ~= "function" then return function() end end
		table.insert(listeners, fn)
		return function()
			for i, f in ipairs(listeners) do
				if f == fn then
					table.remove(listeners, i)
					break
				end
			end
		end
	end

	function ErrorHandling.GetLog()
		return log
	end

	function ErrorHandling.GetRecent(n)
		local out = {}
		for i = 1, math.min(n or 10, #log) do
			out[i] = log[i]
		end
		return out
	end

	function ErrorHandling.Clear()
		for i = #log, 1, -1 do
			log[i] = nil
		end
	end

	function ErrorHandling.Count()
		return #log
	end

	-- เรียก fn แบบปลอดภัย; ถ้า error จะบันทึกลง log แล้วคืนค่า nil
	function ErrorHandling.Wrap(context, fn, ...)
		local results = table.pack(pcall(fn, ...))
		if not results[1] then
			ErrorHandling.Report(context, tostring(results[2]))
		end
		return table.unpack(results, 1, results.n)
	end
end

