-- ===================== ฟังก์ชันช่วยเหลือ (Helpers) =====================

-- ปัดเศษตัวเลขให้เหลือทศนิยม 2 ตำแหน่ง เพื่อให้ค่าที่พิมพ์อ่านง่ายและยังก๊อปปี้ใช้ได้
local function round2(n)
	return math.round(n * 100) / 100                          -- คูณ 100 → ปัดเศษ → หาร 100 คืนเป็นทศนิยม 2 ตำแหน่ง
end

-- แปลง Vector3 เป็นข้อความรูปแบบ Vector3.new(X, Y, Z) เพื่อพิมพ์ลง Output ให้ก๊อปปี้เป็นโค้ดได้ทันที
local function formatVector3(v)
	return "Vector3.new("                                       -- เริ่มด้วยข้อความ Vector3.new(
		.. tostring(round2(v.X)) .. ", "                        -- ตามด้วยค่า X ปัดเศษแล้ว + จุลภาค
		.. tostring(round2(v.Y)) .. ", "                        -- ตามด้วยค่า Y ปัดเศษแล้ว + จุลภาค
		.. tostring(round2(v.Z)) .. ")"                         -- ตามด้วยค่า Z ปัดเศษแล้ว + ปิดวงเล็บ
end

-- ยิง Ray จากกล้องผ่านตำแหน่งเมาส์ เพื่อหา "จุดที่เมาส์ชี้" บนวัตถุในโลก (คืน nil ถ้าไม่โดนอะไรเลย)
local function getMouseHit()
	local cam = workspace.CurrentCamera                         -- ดึงกล้องปัจจุบันใหม่ทุกครั้ง (กันกล้องถูกเปลี่ยนระหว่างเล่น)
	if not cam then return nil end                             -- ยังไม่มีกล้อง → คืน nil ไปก่อน
	local mouseLocation = UserInputService:GetMouseLocation()  -- อ่านตำแหน่งเมาส์บนหน้าจอ (หน่วย Pixel)
	local ray = cam:ViewportPointToRay(mouseLocation.X, mouseLocation.Y) -- แปลงตำแหน่งหน้าจอเป็น Ray ยิงออกจากกล้อง
	local params = RaycastParams.new()                         -- สร้างตั้งค่าสำหรับการยิง Ray
	params.FilterType = Enum.RaycastFilterType.Exclude         -- ใช้โหมด "ยกเว้น" Instance ที่ระบุไว้
	params.FilterDescendantsInstances = { character }          -- ยกเว้นตัวละครตัวเอง (กันชี้โดนตัวเราเอง)
	return workspace:Raycast(ray.Origin, ray.Direction * 5000, params) -- ยิง Ray ไกล 5,000 สตั๊ด แล้วคืนผลที่เจอ
end

-- ===================== จัดการตัวละคร (รันใหม่ทุกครั้งที่ตัวละครเกิด) =====================
local function onCharacterAdded(newCharacter)
	character = newCharacter                                     -- เก็บ Model ตัวละครตัวใหม่
	rootPart = newCharacter:WaitForChild("HumanoidRootPart", 10) -- รอ Part หลักของตัวละคร (สูงสุด 10 วินาที)
	humanoid = newCharacter:WaitForChild("Humanoid", 10)         -- รอ Humanoid (สูงสุด 10 วินาที)
	if humanoid then                                            -- ถ้าหา Humanoid เจอ
		humanoid.WalkSpeed = 16                                  -- คืนค่าความเร็วเป็นค่าเริ่มต้นของ Roblox (16)
	end
	speedMode = false                                           -- รีเซ็ตสถานะโหมดวิ่งเร็วไม่ให้ค้างไว้ข้ามการเกิดใหม่
	-- * NoClip ไม่รีเซ็ต เพราะเป็นสวิตช์ระดับ "การเล่น" ตัวละครใหม่จะยังคงโหมดเดิม
	if rootPart then                                            -- ถ้ามี rootPart พร้อมใช้งาน
		print("[DevUtility] พร้อมใช้งาน | พิกัดตัวละคร: " .. formatVector3(rootPart.Position)) -- แจ้งสถานะลง Output
	end
end

player.CharacterAdded:Connect(onCharacterAdded)                -- ผูกฟังก์ชันไว้กับอีเวนต์ "ตัวละครเกิดใหม่"
if player.Character then                                       -- กรณีสคริปต์รันช้ากว่าการเกิดตัวละคร (ตัวละครมีอยู่แล้ว)
	onCharacterAdded(player.Character)                          -- เรียกใช้ทันทีเพื่ออ้างอิงตัวละครเดิม
end

-- ===================== เอฟเฟกต์ Fade หน้าจอดำ (ใช้ตอนวาร์ป) =====================
local FADE_DURATION = 0.3                                       -- ระยะเวลา Fade 1 รอบ (วินาที)

-- ทำเอฟเฟกต์จอดำ → รันงานที่ส่งมา (action) → จอกลับใส → ลบ GUI ทิ้ง (ใช้งานร่วมกับ task.spawn)
local function fadeOverlay(action)
	local gui = Instance.new("ScreenGui")                       -- สร้าง GUI ชั่วคราวสำหรับเอฟเฟกต์จอดำ
	gui.Name = "DevUtilityFadeGui"                              -- ตั้งชื่อ GUI ให้จำง่าย
	gui.IgnoreGuiInset = true                                   -- ให้ครอบคลุมถึงแถบ UI ด้านบนของหน้าจอ
	gui.ResetOnSpawn = false                                    -- ไม่ให้หายไปตอนตัวละครเกิดใหม่
	gui.DisplayOrder = 1000                                     -- ให้แสดงทับ GUI อื่นทั้งหมด
	local frame = Instance.new("Frame")                         -- สร้างกรอบสีดำเต็มจอ
	frame.Size = UDim2.fromScale(1, 1)                          -- ครอบคลุมทั้งจอ (สัดส่วน 100% ทั้งกว้างและสูง)
	frame.BackgroundColor3 = Color3.new(0, 0, 0)                -- สีดำสนิท
	frame.BackgroundTransparency = 1                            -- เริ่มต้นโปร่งใส 100% (ยังมองไม่เห็น)
	frame.BorderSizePixel = 0                                   -- ปิดเส้นขอบของกรอบ
	frame.Parent = gui                                          -- ใส่ Frame เข้าไปใน GUI
	gui.Parent = playerGui                                      -- ใส่ GUI เข้า PlayerGui ของเราให้มองเห็นบนหน้าจอ
	local fadeIn = TweenService:Create(                         -- สร้าง Tween สำหรับ Fade เข้า (จอค่อย ๆ ดำ)
		frame,                                                  -- เป้าหมายที่จะเปลี่ยนค่า
		TweenInfo.new(FADE_DURATION, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), -- ตั้งเวลา/สไตล์การเคลื่อนที่
		{ BackgroundTransparency = 0 }                          -- ค่าปลายทาง = ทึบสนิท (ดำสนิท)
	)
	fadeIn:Play()                                               -- เริ่มเล่น Tween Fade เข้า
	fadeIn.Completed:Wait()                                     -- รอจนจอดำสนิทก่อนทำขั้นถัดไป
	if action then                                              -- ถ้ามีงานต้องทำระหว่างจอดำ (เช่น การวาร์ป)
		action()                                                -- รันงานนั้นตอนจอดำ เพื่อไม่ให้เห็นตัวละครกระโดด
	end
	local fadeOut = TweenService:Create(                        -- สร้าง Tween สำหรับ Fade ออก (จอค่อย ๆ ใส)
		frame,                                                  -- เป้าหมายที่จะเปลี่ยนค่า
		TweenInfo.new(FADE_DURATION, Enum.EasingStyle.Quad, Enum.EasingDirection.In), -- ตั้งเวลา/สไตล์การเคลื่อนที่
		{ BackgroundTransparency = 1 }                          -- ค่าปลายทาง = โปร่งใส 100% (จอกลับใส)
	)
	fadeOut:Play()                                              -- เริ่มเล่น Tween Fade ออก
	fadeOut.Completed:Wait()                                    -- รอจนจอใสสนิท
	gui:Destroy()                                               -- ลบ GUI ชั่วคราวทิ้งเพื่อไม่ให้ค้างในเกม
end

