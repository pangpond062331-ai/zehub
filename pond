				rowStroke.Color = c.Border
				label.TextColor3 = c.Text
				keyBtn.BackgroundColor3 = c.Panel
				keyStroke.Color = c.Border
				if not capturing then
					keyBtn.TextColor3 = value and c.Accent or c.TextDim
				end
			end
		end)

		local obj = {}
		function obj.Get() return value end
		function obj.Set(key, silent)
			value = key
			render()
			if not silent and opts.OnChanged then
				pcall(opts.OnChanged, value)
			end
		end
		function obj.GetFrame() return row end
		return obj
	end

	-- ── TEXT INPUT / NUMERIC INPUT ─────────────────────────────────────────
	function UI.TextInput(opts)
		local colors = ThemeEngine.GetColors()
		local hasLabel = opts.LabelKey ~= nil
		local frame = Instance.new("Frame")
		frame.LayoutOrder = opts.LayoutOrder or 0
		frame.Size = UDim2.new(1, 0, 0, hasLabel and 58 or 34)
		frame.BackgroundTransparency = 1
		frame.Parent = opts.Parent

		if hasLabel then
			local label = Instance.new("TextLabel")
			label.Size = UDim2.new(1, 0, 0, 16)
			label.BackgroundTransparency = 1
			label.Font = Enum.Font.GothamMedium
			label.TextSize = 11
			label.TextColor3 = colors.TextDim
			label.TextXAlignment = Enum.TextXAlignment.Left
			label.Parent = frame
			Localization.BindText(label, opts.LabelKey)
		end

		local box = Instance.new("TextBox")
		box.Size = UDim2.new(1, 0, 0, hasLabel and 34 or 34)
		box.Position = UDim2.new(0, 0, 0, hasLabel and 22 or 0)
		box.BackgroundColor3 = colors.PanelAlt
		box.BackgroundTransparency = 0.3
		box.BorderSizePixel = 0
		box.Font = Enum.Font.Gotham
		box.TextSize = 13
		box.TextColor3 = colors.Text
		box.PlaceholderColor3 = colors.TextDim
		box.TextXAlignment = Enum.TextXAlignment.Left
		box.ClearTextOnFocus = false
		box.Text = tostring(opts.Value or "")
		box.Parent = frame
		UI.Corner(box, 6)
		local boxStroke = UI.Stroke(box, colors.Border, 1, 0.5)

		local maxLength = tonumber(opts.MaxLength) or 64
		local numeric = opts.Numeric == true

		box:GetPropertyChangedSignal("Text"):Connect(function()
			local text = box.Text
			if #text > maxLength then
				box.Text = text:sub(1, maxLength)
				return
			end
			if numeric then
				local cleaned = text:gsub("[^%d%.]", "")
				local firstDot = cleaned:find(".", 1, true)
				if firstDot then
					local head = cleaned:sub(1, firstDot)
					local tail = cleaned:sub(firstDot + 1):gsub("%.", "")
					cleaned = head .. tail
				end
				if cleaned ~= text then
					box.Text = cleaned
					return
				end
			end
			if opts.OnChanged then
				pcall(opts.OnChanged, box.Text)
			end
		end)

		box.FocusLost:Connect(function()
			if numeric and opts.Min ~= nil and opts.Max ~= nil then
				local n = tonumber(box.Text)
				if n then
					n = clampNum(n, tonumber(opts.Min), tonumber(opts.Max), tonumber(opts.Min))
					box.Text = formatNumber(n, (tonumber(opts.Step) or 1) < 1 and 2 or 0)
				end
			end
			if opts.OnSubmit then
				local ok, err = pcall(opts.OnSubmit, box.Text)
				if not ok then ErrorHandling.Report("UI.TextInput", err) end
			end
		end)

		ThemeEngine.Bind(function(c)
			if frame.Parent then
				box.BackgroundColor3 = c.PanelAlt
				box.TextColor3 = c.Text
				box.PlaceholderColor3 = c.TextDim
				boxStroke.Color = c.Border
			end
		end)

		local obj = {}
		function obj.Get() return box.Text end
		function obj.Set(v) box.Text = tostring(v or "") end
		function obj.Clear() box.Text = "" end
		function obj.GetFrame() return frame end
		function obj.GetBox() return box end
		return obj
	end

	-- ── SEARCH INPUT ───────────────────────────────────────────────────────
	function UI.SearchInput(opts)
		local colors = ThemeEngine.GetColors()
		local frame = Instance.new("Frame")
		frame.LayoutOrder = opts.LayoutOrder or 0
		frame.Size = opts.Size or UDim2.new(1, 0, 0, 34)
		frame.BackgroundColor3 = colors.PanelAlt
		frame.BackgroundTransparency = 0.3
		frame.BorderSizePixel = 0
		frame.Parent = opts.Parent
		UI.Corner(frame, 8)
		local frameStroke = UI.Stroke(frame, colors.Border, 1, 0.5)

		local box = Instance.new("TextBox")
		box.Size = UDim2.new(1, -34, 1, 0)
		box.Position = UDim2.new(0, 10, 0, 0)
		box.BackgroundTransparency = 1
		box.Font = Enum.Font.Gotham
		box.TextSize = 12
		box.TextColor3 = colors.Text
		box.PlaceholderColor3 = colors.TextDim
		box.TextXAlignment = Enum.TextXAlignment.Left
		box.ClearTextOnFocus = false
		box.Text = ""
		box.Parent = frame
		Localization.BindText(box, opts.PlaceholderKey or "search.placeholder", "PlaceholderText")

		local clearBtn = Instance.new("TextButton")
		clearBtn.Size = UDim2.new(0, 22, 0, 22)
		clearBtn.Position = UDim2.new(1, -26, 0.5, -11)
		clearBtn.BackgroundTransparency = 1
		clearBtn.Text = "×"
		clearBtn.Font = Enum.Font.GothamBold
		clearBtn.TextSize = 14
		clearBtn.TextColor3 = colors.TextDim
		clearBtn.Visible = false
		clearBtn.Parent = frame

		local debounce = nil
		local function fireChanged(text)
			if debounce then task.cancel(debounce) debounce = nil end
			debounce = task.delay(0.12, function()
				debounce = nil
				if opts.OnChanged then
					local ok, err = pcall(opts.OnChanged, text)
					if not ok then ErrorHandling.Report("UI.SearchInput", err) end
				end
			end)
		end

		box:GetPropertyChangedSignal("Text"):Connect(function()
			clearBtn.Visible = box.Text ~= ""
			fireChanged(box.Text)
		end)

		clearBtn.MouseButton1Click:Connect(function()
			box.Text = ""
		end)

		ThemeEngine.Bind(function(c)
			if frame.Parent then
				frame.BackgroundColor3 = c.PanelAlt
				frameStroke.Color = c.Border
				box.TextColor3 = c.Text
				box.PlaceholderColor3 = c.TextDim
				clearBtn.TextColor3 = c.TextDim
			end
		end)

		local obj = {}
		function obj.Get() return box.Text end
		function obj.Set(v) box.Text = tostring(v or "") end
		function obj.Clear() box.Text = "" end
		function obj.GetBox() return box end
		function obj.GetFrame() return frame end
		return obj
	end
end

