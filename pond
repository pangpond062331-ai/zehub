	function Localization.GetLanguage()
		return current
	end

	function Localization.IsSupported(lang)
		return LANGUAGES[lang] == true
	end

	function Localization.L(key, params)
		local entry = STRINGS[key]
		local text
		if entry then
			text = entry[current] or entry.EN
		else
			if not missingKeys[key] then
				missingKeys[key] = true
				ErrorHandling.Report("Localization", "Missing translation key: " .. tostring(key), "warn")
			end
			text = key -- แสดง key ให้เห็นชัด ๆ สำหรับนักพัฒนา
		end
		if type(text) ~= "string" then
			text = tostring(key)
		end
		if params then
			text = text:gsub("{([%w_]+)}", function(name)
				local v = params[name]
				if v ~= nil then
					return tostring(v)
				end
				return "{" .. name .. "}"
			end)
		end
		return text
	end

	-- ผูก TextLabel/TextButton/TextBox กับ key (อัปเดตอัตโนมัติเมื่อเปลี่ยนภาษา)
	-- params ใช้แทนค่าในวงเล็บปีกกา เช่น {name=...}
	function Localization.BindText(inst, key, prop, params)
		if not inst then return end
		table.insert(textBindings, { inst = inst, key = key, prop = prop or "Text", params = params })
		pcall(function()
			inst[prop or "Text"] = Localization.L(key, params)
		end)
	end

	-- ผูก callback ทั่วไป (เช่น สร้าง layout ใหม่เมื่อเปลี่ยนภาษา)
	function Localization.Bind(fn)
		if type(fn) ~= "function" then return { Token = nil } end
		local token = {}
		table.insert(customBindings, { fn = fn, token = token })
		pcall(fn, current)
		return token
	end

	function Localization.Unbind(token)
		if not token then return end
		for i, b in ipairs(customBindings) do
			if b.token == token then
				table.remove(customBindings, i)
				break
			end
		end
	end

	function Localization.SetLanguage(lang)
		if not LANGUAGES[lang] then
			ErrorHandling.Report("Localization", "Unsupported language: " .. tostring(lang), "warn")
			return false
		end
		current = lang
		-- อัปเดตข้อความที่ผูกไว้ทั้งหมด (ข้ามออบเจกต์ที่ถูกทำลายแล้ว)
		for i = #textBindings, 1, -1 do
			local b = textBindings[i]
			if b.inst and b.inst.Parent then
				local ok, err = pcall(function()
					b.inst[b.prop] = Localization.L(b.key, b.params)
				end)
				if not ok then
					ErrorHandling.Report("Localization.BindText", err)
				end
			else
				table.remove(textBindings, i)
			end
		end
		for i = #customBindings, 1, -1 do
			local b = customBindings[i]
			local ok, err = pcall(b.fn, current)
			if not ok then
				ErrorHandling.Report("Localization.Bind", err)
				table.remove(customBindings, i)
			end
		end
		return true
	end

	function Localization.GetMissingKeys()
		local out = {}
		for k in pairs(missingKeys) do
			table.insert(out, k)
		end
		table.sort(out)
		return out
	end

	function Localization.GetStats()
		local total = 0
		for _ in pairs(STRINGS) do
			total = total + 1
		end
		return total, #textBindings, #customBindings
	end

	function Localization.ClearBindings()
		textBindings = {}
		customBindings = {}
	end
end

