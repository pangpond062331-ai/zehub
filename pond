		refreshUIStatus()
	end)

	local refreshModules = statCard(2, "home.modules", function()
		return Localization.L("home.activeCount", { n = ModuleRegistry.GetEnabledCount() })
			.. " / " .. tostring(#ModuleRegistry.list)
	end)
	ModuleRegistry.changed:Connect(refreshModules)

	local refreshTheme = statCard(3, "home.theme", function()
		return Localization.L(ThemeEngine.Get().nameKey)
	end)
	ThemeEngine.Bind(function()
		refreshTheme()
	end)

	statCard(4, "home.language", function()
		return (Localization.GetLanguage() == "TH") and "ภาษาไทย" or "English"
	end)

	-- Quick Access (ปุ่มที่ทำงานจริง — ไปยังหน้านั้น ๆ)
	UI.Section(scroll, "home.quickAccess", 4)
	local qaGrid = Instance.new("Frame")
	qaGrid.LayoutOrder = 5
	qaGrid.Size = UDim2.new(1, 0, 0, 42)
	qaGrid.BackgroundTransparency = 1
	qaGrid.Parent = scroll
	local qaLayout = Instance.new("UIGridLayout")
	qaLayout.CellSize = UDim2.new(0.25, -6, 0, 38)
	qaLayout.CellPadding = UDim2.new(0, 8, 0, 0)
	qaLayout.SortOrder = Enum.SortOrder.LayoutOrder
	qaLayout.Parent = qaGrid

	for i, qa in ipairs({
		{ lk = "menu.features", page = "features" },
		{ lk = "menu.visual", page = "visual" },
		{ lk = "menu.settings", page = "settings" },
		{ lk = "menu.modules", page = "modules" },
	}) do
		UI.Button({
			Parent = qaGrid,
			LabelKey = qa.lk,
			Style = "secondary",
			LayoutOrder = i,
			Size = UDim2.new(0.25, -6, 0, 38),
			OnClick = function()
				NavigateTo(qa.page)
			end,
		})
	end

	-- สถานะโมดูล (ย่อ)
	UI.Section(scroll, "home.moduleStatus", 6)
	local modList = Instance.new("Frame")
	modList.LayoutOrder = 7
	modList.Size = UDim2.new(1, 0, 0, 0)
	modList.AutomaticSize = Enum.AutomaticSize.Y
	modList.BackgroundTransparency = 1
	modList.Parent = scroll
	local modListLayout = Instance.new("UIListLayout")
	modListLayout.SortOrder = Enum.SortOrder.LayoutOrder
	modListLayout.Padding = UDim.new(0, 6)
	modListLayout.Parent = modList

	local function rebuildModList()
		for _, child in ipairs(modList:GetChildren()) do
			if child:IsA("Frame") or child:IsA("TextLabel") then
				child:Destroy()
			end
		end
		local colors = ThemeEngine.GetColors()
		if #ModuleRegistry.list == 0 then
			local empty = Instance.new("TextLabel")
			empty.Size = UDim2.new(1, 0, 0, 24)
			empty.BackgroundTransparency = 1
			empty.Font = Enum.Font.Gotham
			empty.TextSize = 12
			empty.TextColor3 = colors.TextDim
			empty.Text = Localization.L("modules.empty")
			empty.Parent = modList
			return
		end
		local shown = 0
		for order, mod in ipairs(ModuleRegistry.list) do
			if shown >= 5 then break end
			shown = shown + 1
			local row = Instance.new("Frame")
			row.Size = UDim2.new(1, 0, 0, 32)
			row.LayoutOrder = order
			row.BackgroundColor3 = colors.PanelAlt
			row.BackgroundTransparency = 0.55
			row.BorderSizePixel = 0
			row.Parent = modList
			UI.Corner(row, 6)

			local name = Instance.new("TextLabel")
			name.Size = UDim2.new(1, -120, 1, 0)
			name.Position = UDim2.new(0, 10, 0, 0)
			name.BackgroundTransparency = 1
			name.Font = Enum.Font.GothamMedium
			name.TextSize = 12
			name.TextColor3 = colors.Text
			name.TextXAlignment = Enum.TextXAlignment.Left
			name.TextTruncate = Enum.TextTruncate.AtEnd
			name.Parent = row
			Localization.BindText(name, mod.nameKey)

			local statusKey = ModuleRegistry.GetStatusKey(mod)
			local chip = UI.StatusChip(row, 0, 100)
			chip.GetFrame().Position = UDim2.new(1, -110, 0.5, -10)
			chip.SetKey(statusKey, ModuleRegistry.StatusKind(statusKey))
		end
	end
	rebuildModList()
	ModuleRegistry.changed:Connect(rebuildModList)
	Localization.Bind(rebuildModList)

	-- ปัญหาล่าสุด
	UI.Section(scroll, "home.recentIssues", 8)
	local issuesLabel = Instance.new("TextLabel")
	issuesLabel.LayoutOrder = 9
	issuesLabel.Size = UDim2.new(1, 0, 0, 0)
	issuesLabel.AutomaticSize = Enum.AutomaticSize.Y
	issuesLabel.BackgroundTransparency = 1
	issuesLabel.Font = Enum.Font.Gotham
	issuesLabel.TextSize = 11
	issuesLabel.TextWrapped = true
	issuesLabel.TextXAlignment = Enum.TextXAlignment.Left
	issuesLabel.Parent = scroll

	local function refreshIssues()
		if not issuesLabel.Parent then return end
		local log = ErrorHandling.GetRecent(3)
		if #log == 0 then
			issuesLabel.TextColor3 = ThemeEngine.GetColors().TextDim
			issuesLabel.Text = Localization.L("home.noIssues")
			return
		end
		issuesLabel.TextColor3 = ThemeEngine.GetColors().Error
		local lines = {}
		for _, e in ipairs(log) do
			table.insert(lines, "[" .. e.context .. "] " .. e.message)
		end
		issuesLabel.Text = table.concat(lines, "\n")
	end
	refreshIssues()
	ErrorHandling.AddListener(function()
		task.defer(refreshIssues)
	end)
	Localization.Bind(refreshIssues)
end

-- ═══════════════════════════════════════════════════════════════════════════
-- PAGE: FEATURE MODULES
-- ═══════════════════════════════════════════════════════════════════════════
local function buildFeaturesPage(page)
	local query = ""

	local topBar = Instance.new("Frame")
	topBar.Size = UDim2.new(1, 0, 0, 42)
	topBar.BackgroundTransparency = 1
	topBar.Parent = page

	local filterBox = UI.SearchInput({
		Parent = topBar,
		PlaceholderKey = "features.search",
		OnChanged = function(text)
			query = text
			buildFeaturesPage.Rebuild()
		end,
	})

	local scroll = UI.MakeScroll(page)
	scroll.Size = UDim2.new(1, 0, 1, -46)
	scroll.Position = UDim2.new(0, 0, 0, 46)

	local CATEGORY_ORDER = { "Movement", "Combat", "Visual", "System" }

	local function makeModuleRow(parent, mod, order)
		local avail = ModuleRegistry.GetAvailability(mod)
		local statusKey = ModuleRegistry.GetStatusKey(mod)
		local kind = ModuleRegistry.StatusKind(statusKey)
		local colors = ThemeEngine.GetColors()

		local row = Instance.new("Frame")
		row.Size = UDim2.new(1, 0, 0, 62)
		row.LayoutOrder = order
		row.BackgroundColor3 = colors.PanelAlt
		row.BackgroundTransparency = 0.45
		row.BorderSizePixel = 0
		row.Parent = parent
		UI.Corner(row, 8)
		local stroke = UI.Stroke(row, mod.enabled and colors.Accent or colors.Border, 1, mod.enabled and 0.45 or 0.65)

		local name = Instance.new("TextLabel")
		name.Size = UDim2.new(1, -190, 0, 22)
		name.Position = UDim2.new(0, 12, 0, 6)
		name.BackgroundTransparency = 1
		name.Font = Enum.Font.GothamBold
		name.TextSize = 13
		name.TextColor3 = colors.Text
		name.TextXAlignment = Enum.TextXAlignment.Left
		name.TextTruncate = Enum.TextTruncate.AtEnd
		name.Parent = row
		Localization.BindText(name, mod.nameKey)

		local desc = Instance.new("TextLabel")
		desc.Size = UDim2.new(1, -190, 0, 18)
		desc.Position = UDim2.new(0, 12, 0, 30)
		desc.BackgroundTransparency = 1
		desc.Font = Enum.Font.Gotham
		desc.TextSize = 10
		desc.TextColor3 = colors.TextDim
		desc.TextXAlignment = Enum.TextXAlignment.Left
		desc.TextTruncate = Enum.TextTruncate.AtEnd
		desc.Parent = row
		if mod.descKey then
			Localization.BindText(desc, mod.descKey)
		end

		local chip = UI.StatusChip(row, 0, 104)
		chip.GetFrame().Position = UDim2.new(1, -186, 0, 8)
		chip.SetKey(statusKey, kind)

		if mod.kind == "action" then
			UI.Button({
				Parent = row,
				LabelKey = "features.run",
				Style = "primary",
				Size = UDim2.new(0, 66, 0, 26),
				LayoutOrder = 0,
				Disabled = not avail.available,
				OnClick = function()
					ModuleRegistry.RunAction(mod.id)
				end,
			}).GetButton().Position = UDim2.new(1, -78, 0, 32)
		else
			local toggleBtn = UI.Button({
				Parent = row,
				Text = mod.enabled and Localization.L("common.on") or Localization.L("common.off"),
				Style = "secondary",
				Size = UDim2.new(0, 66, 0, 26),
				LayoutOrder = 0,
				Disabled = not avail.available,
				OnClick = function()
					ModuleRegistry.Toggle(mod.id)
				end,
			})
			local tBtn = toggleBtn.GetButton()
			tBtn.Position = UDim2.new(1, -78, 0, 32)
			Localization.Bind(function()
				local m = ModuleRegistry.byId[mod.id]
				tBtn.Text = (m and m.enabled) and Localization.L("common.on") or Localization.L("common.off")
			end)
		end

		-- ปุ่มตั้งค่าโมดูล (ถ้ามี)
		if type(mod.buildSettings) == "function" then
			local setBtn = UI.Button({
				Parent = row,
				Text = "...",
				Style = "ghost",
				Size = UDim2.new(0, 30, 0, 26),
				LayoutOrder = 0,
				OnClick = function()
					Overlay.Open(setBtn.GetButton(), math.max(row.AbsoluteSize.X, 220), function(content, close)
						local pad = Instance.new("UIPadding")
						pad.PaddingTop = UDim.new(0, 8)
						pad.PaddingBottom = UDim.new(0, 8)
						pad.PaddingLeft = UDim.new(0, 10)
						pad.PaddingRight = UDim.new(0, 10)
						pad.Parent = content

						local layout = Instance.new("UIListLayout")
						layout.SortOrder = Enum.SortOrder.LayoutOrder
						layout.Padding = UDim.new(0, 6)
						layout.Parent = content

						local title = Instance.new("TextLabel")
						title.Size = UDim2.new(1, 0, 0, 20)
						title.LayoutOrder = 1
						title.BackgroundTransparency = 1
						title.Font = Enum.Font.GothamBold
						title.TextSize = 12
						title.TextColor3 = ThemeEngine.GetColors().Accent
						title.TextXAlignment = Enum.TextXAlignment.Left
						title.Parent = content
						Localization.BindText(title, "features.settings")

						local okBuild, err = pcall(mod.buildSettings, content, mod)
						if not okBuild then
							ErrorHandling.Report("Module." .. mod.id .. ".Settings", err)
							local errLabel = Instance.new("TextLabel")
							errLabel.Size = UDim2.new(1, 0, 0, 30)
							errLabel.LayoutOrder = 99
							errLabel.BackgroundTransparency = 1
							errLabel.Font = Enum.Font.Gotham
							errLabel.TextSize = 11
							errLabel.TextColor3 = ThemeEngine.GetColors().Error
							errLabel.TextWrapped = true
							errLabel.TextXAlignment = Enum.TextXAlignment.Left
							errLabel.Parent = content
							errLabel.Text = Localization.L("common.pageError")
						end
					end)
				end,
			})
			setBtn.GetButton().Position = UDim2.new(1, -116, 0, 32)
		end

		-- คำอธิบายสถานะไม่พร้อมใช้งาน
		if not avail.available then
			Tooltip.Attach(row, avail.reasonKey or "tip.moduleUnavailable")
		end

		local thToken
		thToken = ThemeEngine.Bind(function(c)
			if not row.Parent then
				ThemeEngine.Unbind(thToken)
				return
			end
			row.BackgroundColor3 = c.PanelAlt
			stroke.Color = mod.enabled and c.Accent or c.Border
			name.TextColor3 = c.Text
			desc.TextColor3 = c.TextDim
		end)
		return row
	end

	function buildFeaturesPage.Rebuild()
		for _, child in ipairs(scroll:GetChildren()) do
			if not child:IsA("UIListLayout") and not child:IsA("UIPadding") then
				child:Destroy()
			end
		end
		local q = trimString(query):lower()
		local order = 0
		local matched = 0

		for _, category in ipairs(CATEGORY_ORDER) do
			local catMods = {}
			for _, mod in ipairs(ModuleRegistry.list) do
				if mod.category == category then
					local nameText = Localization.L(mod.nameKey):lower()
					local descText = mod.descKey and Localization.L(mod.descKey):lower() or ""
					if q == "" or nameText:find(q, 1, true) or descText:find(q, 1, true)
						or category:lower():find(q, 1, true) or mod.id:lower():find(q, 1, true) then
						table.insert(catMods, mod)
					end
				end
			end
			if #catMods > 0 then
				order = order + 1
				UI.Section(scroll, "category." .. category:lower(), order)
				for _, mod in ipairs(catMods) do
					order = order + 1
					matched = matched + 1
					makeModuleRow(scroll, mod, order)
				end
			end
		end

		if matched == 0 then
			order = order + 1
			local empty = Instance.new("TextLabel")
			empty.Size = UDim2.new(1, 0, 0, 40)
			empty.LayoutOrder = order
			empty.BackgroundTransparency = 1
			empty.Font = Enum.Font.Gotham
			empty.TextSize = 13
			empty.TextColor3 = ThemeEngine.GetColors().TextDim
			empty.Text = Localization.L("features.empty")
			empty.Parent = scroll
		end
	end

	buildFeaturesPage.Rebuild()
	ModuleRegistry.changed:Connect(function()
		buildFeaturesPage.Rebuild()
	end)
	Localization.Bind(function()
		buildFeaturesPage.Rebuild()
	end)
end

