	-- ── ระบบลากหน้าต่าง (ลากได้เฉพาะหัวเรื่อง กันชนขอบจอเสมอ) ──────────
	do
		local dragging = false
		local dragStart = nil
		local startOffset = nil
		local moveConn = nil
		local endConn = nil

		local function stopDrag()
			if not dragging then return end
			dragging = false
			if moveConn then moveConn:Disconnect() moveConn = nil end
			if endConn then endConn:Disconnect() endConn = nil end
			if State.Get("Window.RememberPosition") then
				State.Set("Window.PositionX", main.Position.X.Offset)
				State.Set("Window.PositionY", main.Position.Y.Offset)
				SaveService.Autosave()
			end
		end

		header.InputBegan:Connect(function(input)
			if not State.Get("Controls.DragEnabled") then return end
			if input.UserInputType == Enum.UserInputType.MouseButton1
				or input.UserInputType == Enum.UserInputType.Touch then
				dragging = true
				dragStart = input.Position
				startOffset = Vector2.new(main.Position.X.Offset, main.Position.Y.Offset)
				if moveConn then moveConn:Disconnect() end
				moveConn = UserInputService.InputChanged:Connect(function(inp)
					if not dragging then return end
					if inp.UserInputType == Enum.UserInputType.MouseMovement
						or inp.UserInputType == Enum.UserInputType.Touch then
						local delta = inp.Position - dragStart
						main.Position = UDim2.new(0.5, startOffset.X + delta.X, 0.5, startOffset.Y + delta.Y)
						Window.ClampPosition()
					end
				end)
				if endConn then endConn:Disconnect() end
				endConn = UserInputService.InputEnded:Connect(function(inp)
					if inp.UserInputType == Enum.UserInputType.MouseButton1
						or inp.UserInputType == Enum.UserInputType.Touch then
						stopDrag()
					end
				end)
			end
		end)
	end

	-- ── ระบบปรับขนาดหน้าต่าง ─────────────────────────────────────────────
	do
		local resizing = false
		local startPos = nil
		local startSize = nil
		local moveConn = nil
		local endConn = nil

		local function stopResize()
			if not resizing then return end
			resizing = false
			if moveConn then moveConn:Disconnect() moveConn = nil end
			if endConn then endConn:Disconnect() endConn = nil end
			userSize = main.Size
		end

		grip.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1
				or input.UserInputType == Enum.UserInputType.Touch then
				resizing = true
				startPos = input.Position
				startSize = Vector2.new(main.Size.X.Offset, main.Size.Y.Offset)
				if moveConn then moveConn:Disconnect() end
				moveConn = UserInputService.InputChanged:Connect(function(inp)
					if not resizing then return end
					if inp.UserInputType == Enum.UserInputType.MouseMovement
						or inp.UserInputType == Enum.UserInputType.Touch then
						local delta = inp.Position - startPos
						local vp = getViewport()
						local scale = math.max(windowScale.Scale, 0.1)
						local minW = MIN_ABS_W / scale
						local minH = MIN_ABS_H / scale
						local maxW = (vp.X - 24) / scale
						local maxH = (vp.Y - 24) / scale
						local newW = math.clamp(startSize.X + delta.X, minW, math.max(maxW, minW))
						local newH = math.clamp(startSize.Y + delta.Y, minH, math.max(maxH, minH))
						main.Size = UDim2.fromOffset(newW, newH)
						userSize = main.Size
					end
				end)
				if endConn then endConn:Disconnect() end
				endConn = UserInputService.InputEnded:Connect(function(inp)
					if inp.UserInputType == Enum.UserInputType.MouseButton1
						or inp.UserInputType == Enum.UserInputType.Touch then
						stopResize()
					end
				end)
			end
		end)
	end

	-- ── Navigation ────────────────────────────────────────────────────────
	local function updateNavVisuals()
		local c = ThemeEngine.GetColors()
		for id, nb in pairs(NavButtons) do
			local active = (id == currentNav)
			nb.btn.BackgroundColor3 = active and c.Accent or Color3.fromRGB(0, 0, 0)
			nb.btn.BackgroundTransparency = active and 0.78 or 1
			nb.icon.TextColor3 = active and c.Accent or c.TextDim
			nb.txt.TextColor3 = active and c.Text or c.TextDim
			nb.txt.Font = active and Enum.Font.GothamBold or Enum.Font.GothamMedium
			nb.bar.Visible = active
		end
	end

	function Window.CreatePage(id)
		local page = Instance.new("Frame")
		page.Name = "Page_" .. id
		page.Size = UDim2.fromScale(1, 1)
		page.BackgroundTransparency = 1
		page.BorderSizePixel = 0
		page.Visible = (id == currentNav)
		page.Parent = pageArea
		pages[id] = page
		return page
	end

	function Window.GetPage(id)
		return pages[id]
	end

	NavigateTo = function(pageId, opts)
		opts = opts or {}
		if not pages[pageId] then
			ErrorHandling.Report("Navigation", "Unknown page: " .. tostring(pageId), "warn")
			return
		end
		Overlay.Dismiss()
		searchPanel.Visible = false

		local oldPage = pages[currentNav]
		if oldPage and oldPage ~= pages[pageId] then
			oldPage.Visible = false
		end
		currentNav = pageId
		local newPage = pages[pageId]
		newPage.Visible = true
		-- รีเซ็ตการเลื่อนของหน้า
		for _, child in ipairs(newPage:GetChildren()) do
			if child:IsA("ScrollingFrame") then
				child.CanvasPosition = Vector2.new(0, 0)
			end
		end
		updateNavVisuals()
		if not opts.Silent and Perf.IsHeavyAllowed() then
			flash.BackgroundTransparency = 0.82
			Perf.Tween(flash, { BackgroundTransparency = 1 }, 0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
		end
	end

