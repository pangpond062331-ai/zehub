		card.BackgroundTransparency = 0.42
		card.BorderSizePixel = 0
		card.Parent = parent
		UI.Corner(card, 8)
		local stroke = UI.Stroke(card, colors.Border, 1, 0.6)

		ThemeEngine.Bind(function(c)
			if card.Parent then
