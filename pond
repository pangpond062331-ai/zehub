-- PAGE: VISUAL & THEME
-- ═══════════════════════════════════════════════════════════════════════════
local function buildVisualPage(page)
	local scroll = UI.MakeScroll(page)

	UI.Section(scroll, "visual.themes", 1)

	-- การ์ดธีม 4 ใบ (เปลี่ยนได้ทันที ไม่ต้องเปิด UI ใหม่)
	local themeGrid = Instance.new("Frame")
	themeGrid.LayoutOrder = 2
	themeGrid.Size = UDim2.new(1, 0, 0, 122)
	themeGrid.BackgroundTransparency = 1
	themeGrid.Parent = scroll
	local themeLayout = Instance.new("UIGridLayout")
	themeLayout.CellSize = UDim2.new(0.5, -5, 0, 57)
	themeLayout.CellPadding = UDim2.new(0, 10, 0, 8)
	themeLayout.SortOrder = Enum.SortOrder.LayoutOrder
	themeLayout.Parent = themeGrid

	local themeButtons = {}
	for i, entry in ipairs(ThemeEngine.GetList()) do
		local themeDef = Themes[entry.key]
		local cardBtn = Instance.new("TextButton")
		cardBtn.LayoutOrder = i
		cardBtn.BackgroundColor3 = ThemeEngine.GetColors().PanelAlt
		cardBtn.BackgroundTransparency = 0.4
		cardBtn.BorderSizePixel = 0
		cardBtn.AutoButtonColor = false
		cardBtn.Text = ""
		cardBtn.Parent = themeGrid
		UI.Corner(cardBtn, 8)
		local cardStroke = UI.Stroke(cardBtn, ThemeEngine.GetColors().Border, 1, 0.6)

		local nameLabel = Instance.new("TextLabel")
		nameLabel.Size = UDim2.new(1, -30, 0, 22)
		nameLabel.Position = UDim2.new(0, 10, 0, 7)
		nameLabel.BackgroundTransparency = 1
		nameLabel.Font = Enum.Font.GothamBold
		nameLabel.TextSize = 12
		nameLabel.TextXAlignment = Enum.TextXAlignment.Left
		nameLabel.Parent = cardBtn
		Localization.BindText(nameLabel, entry.nameKey)

		-- ตัวอย่างสี 3 จุด
		for s = 1, 3 do
			local swatch = Instance.new("Frame")
			swatch.Size = UDim2.new(0, 14, 0, 14)
			swatch.Position = UDim2.new(0, 10 + (s - 1) * 18, 0, 33)
			swatch.BorderSizePixel = 0
			swatch.Parent = cardBtn
			UI.Corner(swatch, 7)
			if s == 1 then swatch.BackgroundColor3 = themeDef.c.Accent
			elseif s == 2 then swatch.BackgroundColor3 = themeDef.c.GradientA
			else swatch.BackgroundColor3 = themeDef.c.Text
			end
		end

		local check = Instance.new("TextLabel")
		check.Size = UDim2.new(0, 24, 0, 24)
		check.Position = UDim2.new(1, -32, 0, 14)
		check.BackgroundTransparency = 1
		check.Font = Enum.Font.GothamBold
		check.TextSize = 14
		check.Text = "✓"
		check.Visible = false
		check.Parent = cardBtn

		themeButtons[entry.key] = { btn = cardBtn, stroke = cardStroke, check = check, nameLabel = nameLabel }

		cardBtn.MouseButton1Click:Connect(function()
			if ThemeEngine.GetKey() == entry.key then return end
			if ThemeEngine.Set(entry.key) then
				State.Set("Theme", entry.key)
				Notify.Show("success", "notify.themeChanged", "notify.themeChanged",
					{ theme = Localization.L(entry.nameKey) }, 2.5)
			end
		end)
	end

	local function refreshThemeCards()
		local c = ThemeEngine.GetColors()
		local activeKey = ThemeEngine.GetKey()
		for key, refs in pairs(themeButtons) do
			local active = (key == activeKey)
			refs.btn.BackgroundColor3 = active and c.Panel or c.PanelAlt
			refs.btn.BackgroundTransparency = active and 0.15 or 0.4
			refs.stroke.Color = active and c.Accent or c.Border
			refs.stroke.Thickness = active and 2 or 1
			refs.check.Visible = active
			refs.check.TextColor3 = c.Accent
			refs.nameLabel.TextColor3 = active and c.Accent or c.Text
			refs.nameLabel.Font = active and Enum.Font.GothamBold or Enum.Font.GothamMedium
		end
	end
	refreshThemeCards()
	ThemeEngine.Bind(refreshThemeCards)

	-- เอฟเฟกต์
	UI.Section(scroll, "visual.effects", 3)
	UI.Toggle({
		Parent = scroll, LabelKey = "visual.effect.bg", LayoutOrder = 4,
		StatePath = "Effects.BackgroundGradient",
	})
	UI.Toggle({
		Parent = scroll, LabelKey = "visual.effect.glow", LayoutOrder = 5,
		StatePath = "Effects.Glow",
	})
	UI.Toggle({
		Parent = scroll, LabelKey = "visual.effect.aura", LayoutOrder = 6,
		StatePath = "Effects.Aura",
	})
	UI.Toggle({
		Parent = scroll, LabelKey = "visual.effect.toast", LayoutOrder = 7,
		StatePath = "Effects.ToastAnimation",
	})

	UI.Section(scroll, "visual.animSpeed", 8)
	UI.Slider({
		Parent = scroll, LabelKey = "visual.animSpeed", LayoutOrder = 9,
		Min = 0.25, Max = 3, Step = 0.05, Unit = "x",
		StatePath = "AnimationSpeed",
	})

	UI.Section(scroll, "visual.opacity", 10)
	UI.Slider({
		Parent = scroll, LabelKey = "visual.opacity", LayoutOrder = 11,
		Min = 0.3, Max = 1, Step = 0.02,
		StatePath = "WindowOpacity",
	})

	UI.Section(scroll, "visual.perfMode", 12)
	UI.Toggle({
		Parent = scroll, LabelKey = "visual.perfMode", LayoutOrder = 13,
		StatePath = "PerformanceMode", TooltipKey = "visual.perfHint",
	})

	local hint = Instance.new("TextLabel")
	hint.LayoutOrder = 14
	hint.Size = UDim2.new(1, 0, 0, 0)
	hint.AutomaticSize = Enum.AutomaticSize.Y
	hint.BackgroundTransparency = 1
	hint.Font = Enum.Font.Gotham
	hint.TextSize = 10
	hint.TextWrapped = true
	hint.TextXAlignment = Enum.TextXAlignment.Left
	hint.Parent = scroll
	Localization.BindText(hint, "visual.perfHint")
	ThemeEngine.Bind(function(c)
		if hint.Parent then hint.TextColor3 = c.TextDim end
	end)
end

-- ═══════════════════════════════════════════════════════════════════════════
-- PAGE: SETTINGS
-- ═══════════════════════════════════════════════════════════════════════════
local function buildSettingsPage(page)
	local scroll = UI.MakeScroll(page)

	-- ภาษา (เปลี่ยนได้ทันที)
	UI.Section(scroll, "settings.language", 1)
	local langRow = Instance.new("Frame")
	langRow.LayoutOrder = 2
	langRow.Size = UDim2.new(1, 0, 0, 40)
	langRow.BackgroundTransparency = 1
	langRow.Parent = scroll

	local langButtons = {}
	local function makeLangButton(code, labelKey, xOffset)
		local colors = ThemeEngine.GetColors()
		local b = Instance.new("TextButton")
		b.Size = UDim2.new(0, 120, 0, 36)
		b.Position = UDim2.new(0, xOffset, 0, 2)
		b.BorderSizePixel = 0
		b.Font = Enum.Font.GothamBold
		b.TextSize = 13
		b.AutoButtonColor = false
		b.Parent = langRow
		UI.Corner(b, 8)
		local st = UI.Stroke(b, colors.Border, 1, 0.6)
		Localization.BindText(b, labelKey)
		b.MouseButton1Click:Connect(function()
			if Localization.GetLanguage() == code then return end
			Localization.SetLanguage(code)
			State.Set("Language", code)
			Notify.Show("info", "notify.languageChanged", "notify.languageChanged", nil, 2.5)
		end)
		langButtons[code] = { btn = b, stroke = st }
	end
	makeLangButton("EN", "set.languageEN", 0)
	makeLangButton("TH", "set.languageTH", 128)

	local function refreshLangButtons()
		local c = ThemeEngine.GetColors()
		local cur = Localization.GetLanguage()
		for code, refs in pairs(langButtons) do
			local active = (code == cur)
			refs.btn.BackgroundColor3 = active and c.Accent or c.PanelAlt
			refs.btn.BackgroundTransparency = active and 0.12 or 0.4
			refs.btn.TextColor3 = active and Color3.fromRGB(12, 14, 20) or c.Text
			refs.stroke.Color = active and c.AccentSoft or c.Border
		end
	end
	refreshLangButtons()
	Localization.Bind(refreshLangButtons)
	ThemeEngine.Bind(refreshLangButtons)

	-- การควบคุม
	UI.Section(scroll, "settings.controls", 3)
	UI.Keybind({
		Parent = scroll, LabelKey = "settings.toggleKey", LayoutOrder = 4,
		Value = safeKeycodeFromName(State.Get("Controls.ToggleKeyName")) or Enum.KeyCode.RightControl,
		StatePath = "Controls.ToggleKeyName",
	})
	UI.Toggle({
		Parent = scroll, LabelKey = "settings.dragEnabled", LayoutOrder = 5,
		StatePath = "Controls.DragEnabled",
	})

	-- หน้าต่าง
	UI.Section(scroll, "settings.window", 6)
	UI.Toggle({
		Parent = scroll, LabelKey = "settings.rememberPos", LayoutOrder = 7,
		StatePath = "Window.RememberPosition",
	})
	UI.Button({
		Parent = scroll, LabelKey = "settings.resetPos", Style = "secondary", LayoutOrder = 8,
		OnClick = function()
			Window.ResetWindowPosition()
			Notify.Show("info", "notify.positionReset", "notify.positionReset", nil, 2.5)
		end,
	})

	-- ประสิทธิภาพ
	UI.Section(scroll, "settings.performance", 9)
	UI.Toggle({
		Parent = scroll, LabelKey = "visual.perfMode", LayoutOrder = 10,
		StatePath = "PerformanceMode", TooltipKey = "tip.perfMode",
	})
	UI.Toggle({
		Parent = scroll, LabelKey = "settings.reduceMotion", LayoutOrder = 11,
		StatePath = "ReduceMotion",
	})

	local autoNote = Instance.new("TextLabel")
	autoNote.LayoutOrder = 12
	autoNote.Size = UDim2.new(1, 0, 0, 0)
	autoNote.AutomaticSize = Enum.AutomaticSize.Y
	autoNote.BackgroundTransparency = 1
	autoNote.Font = Enum.Font.Gotham
	autoNote.TextSize = 10
	autoNote.TextWrapped = true
	autoNote.TextXAlignment = Enum.TextXAlignment.Left
	autoNote.Parent = scroll
	Localization.BindText(autoNote, "settings.autoSaveNote")
	ThemeEngine.Bind(function(c)
		if autoNote.Parent then autoNote.TextColor3 = c.TextDim end
	end)

	-- รีเซ็ตทั้งหมด (ยืนยัน 2 ครั้ง)
	UI.Section(scroll, "settings.resetAll", 13)
	local confirmPending = false
	local resetTimer = nil
	local resetBtn
	resetBtn = UI.Button({
		Parent = scroll,
		LabelKey = "settings.resetAll",
		Style = "danger",
		LayoutOrder = 14,
		OnClick = function()
			if not confirmPending then
				confirmPending = true
				resetBtn.SetText(Localization.L("settings.resetConfirm"))
				if resetTimer then task.cancel(resetTimer) end
				resetTimer = task.delay(3, function()
					confirmPending = false
					resetTimer = nil
					resetBtn.SetText(Localization.L("settings.resetAll"))
				end)
			else
				confirmPending = false
				if resetTimer then task.cancel(resetTimer) resetTimer = nil end
				State.Reset()
				resetBtn.SetText(Localization.L("settings.resetAll"))
				Notify.Show("success", "notify.settingsReset", "notify.settingsReset", nil, 3)
			end
		end,
	})
	Localization.Bind(function()
		if not confirmPending then
			resetBtn.SetText(Localization.L("settings.resetAll"))
		end
	end)
end

