-- Invisibility — ใช้ LocalTransparencyModifier (ซ่อนตัวเองเฉพาะเครื่อง จริง)
do
	local function applyInvisible()
		local char = LocalPlayer.Character
		if not char then return end
		for _, part in ipairs(char:GetDescendants()) do
			if part:IsA("BasePart") then
				part:SetAttribute("AnxOrigTransparency", part.Transparency)
				part.LocalTransparencyModifier = 1
			end
		end
	end
	local function removeInvisible()
		local char = LocalPlayer.Character
		if not char then return end
		for _, part in ipairs(char:GetDescendants()) do
			if part:IsA("BasePart") then
				part.LocalTransparencyModifier = 0
				local orig = part:GetAttribute("AnxOrigTransparency")
				if orig ~= nil then
					part.Transparency = orig
					part:SetAttribute("AnxOrigTransparency", nil)
				end
			end
		end
	end
	local def = {
		id = "invisibility", nameKey = "module.invisibility", descKey = "module.invisibility.desc",
		category = "Visual", statusKey = "status.localEffect",
		availability = function()
			-- LocalTransparencyModifier เป็น API ของ engine ที่ใช้ได้กับ BasePart เสมอ
			return { available = true, statusKey = "status.localEffect" }
		end,
		enable = function(data)
			applyInvisible()
		end,
		disable = function(data)
			removeInvisible()
		end,
		onRespawn = function(data)
			-- ตัวละครใหม่ยังไม่ถูกซ่อน — ซ้ำ lạiถ้ายังเปิดอยู่
			applyInvisible()
		end,
	}
	ModuleRegistry.Register(def)
end

-- Noclip — ปิด CanCollide ทุก frame (ผลเฉพาะเครื่อง)
do
	local def = {
		id = "noclip", nameKey = "module.noclip", descKey = "module.noclip.desc",
		category = "Visual", statusKey = "status.localEffect",
		availability = function()
			return { available = true, statusKey = "status.localEffect" }
		end,
		enable = function(data)
			Perf.RegisterRenderStep("noclip_step", 2, function()
				local c = LocalPlayer.Character
				if c then
					for _, part in ipairs(c:GetDescendants()) do
						if part:IsA("BasePart") and part.CanCollide then
							part.CanCollide = false
						end
