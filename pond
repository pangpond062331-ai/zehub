	-- ป้ายสถานะเล็ก (ใช้กับโมดูล/ตารางสถานะ)
	function UI.StatusChip(parent, order, width)
		local colors = ThemeEngine.GetColors()
		local chip = Instance.new("Frame")
		chip.LayoutOrder = order or 0
		chip.Size = UDim2.new(0, width or 96, 0, 20)
		chip.BackgroundColor3 = colors.PanelAlt
		chip.BackgroundTransparency = 0.25
		chip.BorderSizePixel = 0
		chip.Parent = parent
		UI.Corner(chip, 10)

		local label = Instance.new("TextLabel")
		label.Size = UDim2.new(1, -10, 1, 0)
		label.Position = UDim2.new(0, 5, 0, 0)
		label.BackgroundTransparency = 1
		label.Font = Enum.Font.GothamBold
		label.TextSize = 10
		label.TextColor3 = colors.TextDim
		label.TextTruncate = Enum.TextTruncate.AtEnd
		label.Parent = chip

		local stroke = UI.Stroke(chip, colors.Border, 1, 0.6)

		ThemeEngine.Bind(function(c)
			if chip.Parent then
				chip.BackgroundColor3 = c.PanelAlt
				stroke.Color = c.Border
			end
		end)

		local obj = {}
		-- kind: "success" | "warning" | "error" | "accent" | "dim"
		function obj.SetKey(key, kind)
			local c = ThemeEngine.GetColors()
			local color = c.TextDim
			if kind == "success" then color = c.Success
			elseif kind == "warning" then color = c.Warning
			elseif kind == "error" then color = c.Error
			elseif kind == "accent" then color = c.Accent
			end
			label.TextColor3 = color
			stroke.Color = color
			label.Text = Localization.L(key)
			return obj
		end
		function obj.SetColor(color3)
			label.TextColor3 = color3
			stroke.Color = color3
		end
		function obj.GetFrame() return chip end
		return obj
	end

	-- ── BUTTON ─────────────────────────────────────────────────────────────
	function UI.Button(opts)
		local colors = ThemeEngine.GetColors()
		local btn = Instance.new("TextButton")
		btn.Size = opts.Size or UDim2.new(1, 0, 0, 36)
		btn.LayoutOrder = opts.LayoutOrder or 0
		btn.BorderSizePixel = 0
		btn.Font = Enum.Font.GothamBold
		btn.TextSize = 12
		btn.AutoButtonColor = false
		btn.ClipsDescendants = true
		btn.Parent = opts.Parent
		UI.Corner(btn, 7)
		local stroke = UI.Stroke(btn, colors.Border, 1, 0.5)

		local style = opts.Style or "primary"
		local disabled = opts.Disabled == true
		local lastClick = 0

		if opts.LabelKey then
			Localization.BindText(btn, opts.LabelKey)
		elseif opts.Text then
			btn.Text = opts.Text
		end

		local function applyStyle()
			local c = ThemeEngine.GetColors()
			local bg, fg
			if style == "secondary" then
				bg, fg = c.PanelAlt, c.Text
			elseif style == "danger" then
				bg, fg = c.Error, Color3.fromRGB(255, 240, 240)
			elseif style == "ghost" then
				bg, fg = c.PanelAlt, c.Accent
			else
				bg, fg = c.Accent, Color3.fromRGB(12, 14, 20)
			end
			btn.BackgroundColor3 = bg
			btn.BackgroundTransparency = disabled and 0.65 or (style == "ghost" and 0.3 or 0.12)
			btn.TextColor3 = disabled and c.TextDim or fg
			stroke.Color = c.Border
		end
		applyStyle()
		ThemeEngine.Bind(applyStyle)

		btn.MouseEnter:Connect(function()
			if disabled then return end
			Perf.Tween(btn, { BackgroundTransparency = math.max(0, btn.BackgroundTransparency - 0.1) }, 0.1)
		end)
		btn.MouseLeave:Connect(function()
			applyStyle()
		end)
		btn.MouseButton1Down:Connect(function()
			if disabled then return end
			btn.Size = UDim2.new(btn.Size.X.Scale, btn.Size.X.Offset, btn.Size.Y.Scale, (opts.Size or UDim2.new(1, 0, 0, 36)).Y.Offset - 2)
		end)
		btn.MouseButton1Up:Connect(function()
			btn.Size = opts.Size or UDim2.new(1, 0, 0, 36)
		end)

		btn.MouseButton1Click:Connect(function()
			if disabled then return end
			local now = os.clock()
			if now - lastClick < 0.08 then return end -- กันการทำงานทับซ้อนจากการกดเร็วเกินไป
			lastClick = now
			if opts.OnClick then
				local ok, err = pcall(opts.OnClick)
				if not ok then
					ErrorHandling.Report("UI.Button", err)
				end
			end
		end)

		if opts.TooltipKey then
			Tooltip.Attach(btn, opts.TooltipKey)
		end

		local obj = {}
		function obj.SetDisabled(v)
			disabled = v == true
			applyStyle()
		end
		function obj.SetLabelKey(key)
			btn.Text = Localization.L(key)
		end
		function obj.SetText(text)
			btn.Text = tostring(text)
		end
		function obj.GetButton() return btn end
		return obj
	end

	-- ── TOGGLE ─────────────────────────────────────────────────────────────
	function UI.Toggle(opts)
		local colors = ThemeEngine.GetColors()
		local rowH = opts.Height or 44

		local row = Instance.new("Frame")
		row.LayoutOrder = opts.LayoutOrder or 0
		row.Size = UDim2.new(1, 0, 0, rowH)
		row.BackgroundColor3 = colors.PanelAlt
		row.BackgroundTransparency = 0.45
		row.BorderSizePixel = 0
		row.Parent = opts.Parent
		UI.Corner(row, 8)
		local rowStroke = UI.Stroke(row, colors.Border, 1, 0.65)

		local label = Instance.new("TextLabel")
		label.Size = UDim2.new(1, -80, 1, 0)
		label.Position = UDim2.new(0, 12, 0, 0)
		label.BackgroundTransparency = 1
		label.Font = Enum.Font.GothamMedium
		label.TextSize = 13
		label.TextXAlignment = Enum.TextXAlignment.Left
		label.TextTruncate = Enum.TextTruncate.AtEnd
		label.Parent = row
		Localization.BindText(label, opts.LabelKey)

		local track = Instance.new("Frame")
		track.Size = UDim2.new(0, 46, 0, 24)
		track.Position = UDim2.new(1, -58, 0.5, -12)
		track.BorderSizePixel = 0
		track.Parent = row
		UI.Corner(track, 12)

		local knob = Instance.new("Frame")
		knob.Size = UDim2.new(0, 20, 0, 20)
		knob.BackgroundColor3 = Color3.fromRGB(240, 240, 245)
		knob.BorderSizePixel = 0
		knob.Parent = track
		UI.Corner(knob, 10)

		local btn = Instance.new("TextButton")
		btn.Size = UDim2.fromScale(1, 1)
		btn.BackgroundTransparency = 1
		btn.Text = ""
		btn.Parent = row

		local value = opts.Value == true
		local disabled = opts.Disabled == true

		local function apply(v, animate)
			local c = ThemeEngine.GetColors()
			local goalTrack = v and c.Accent or c.Track
			local goalKnob = v and UDim2.new(1, -22, 0.5, -10) or UDim2.new(0, 2, 0.5, -10)
			if animate and Perf.IsHeavyAllowed() then
				Perf.Tween(track, { BackgroundColor3 = goalTrack }, 0.18, Enum.EasingStyle.Quad)
				Perf.Tween(knob, { Position = goalKnob }, 0.18, Enum.EasingStyle.Quad)
			else
				track.BackgroundColor3 = goalTrack
				knob.Position = goalKnob
			end
		end
		apply(value, false)

		btn.MouseButton1Click:Connect(function()
			if disabled then return end
			value = not value
			apply(value, true)
			if opts.OnChanged then
				local ok, err = pcall(opts.OnChanged, value)
				if not ok then ErrorHandling.Report("UI.Toggle", err) end
			end
			if opts.StatePath then
				State.Set(opts.StatePath, value)
			end
		end)

		if opts.TooltipKey then
			Tooltip.Attach(row, opts.TooltipKey)
		end

		ThemeEngine.Bind(function(c)
			if row.Parent then
				row.BackgroundColor3 = c.PanelAlt
				rowStroke.Color = c.Border
				label.TextColor3 = disabled and c.TextDim or c.Text
				apply(value, false)
			end
		end)

		if opts.StatePath then
			State.Bind(opts.StatePath, function(v)
				if type(v) == "boolean" then
					value = v
					apply(v, false)
				end
			end)
		end

		local obj = {}
		function obj.Get() return value end
		function obj.Set(v, silent)
			value = v == true
			apply(value, false)
			if not silent and opts.OnChanged then
				pcall(opts.OnChanged, value)
			end
		end
		function obj.SetDisabled(v)
			disabled = v == true
			local c = ThemeEngine.GetColors()
			label.TextColor3 = disabled and c.TextDim or c.Text
		end
		function obj.GetFrame() return row end
		return obj
	end

	-- ── SLIDER ─────────────────────────────────────────────────────────────
	function UI.Slider(opts)
		local colors = ThemeEngine.GetColors()
		local minV = tonumber(opts.Min) or 0
		local maxV = tonumber(opts.Max) or 100
		if maxV <= minV then maxV = minV + 1 end
		local step = tonumber(opts.Step) or 1
		local decimals = (step < 1) and 2 or 0
		local unit = opts.Unit or ""

		local row = Instance.new("Frame")
		row.LayoutOrder = opts.LayoutOrder or 0
		row.Size = UDim2.new(1, 0, 0, 56)
		row.BackgroundColor3 = colors.PanelAlt
		row.BackgroundTransparency = 0.45
		row.BorderSizePixel = 0
		row.Parent = opts.Parent
		UI.Corner(row, 8)
		local rowStroke = UI.Stroke(row, colors.Border, 1, 0.65)

		local label = Instance.new("TextLabel")
		label.Size = UDim2.new(1, -100, 0, 20)
		label.Position = UDim2.new(0, 12, 0, 6)
		label.BackgroundTransparency = 1
		label.Font = Enum.Font.GothamMedium
		label.TextSize = 13
		label.TextXAlignment = Enum.TextXAlignment.Left
		label.TextTruncate = Enum.TextTruncate.AtEnd
		label.Parent = row
		Localization.BindText(label, opts.LabelKey)

		local valLabel = Instance.new("TextLabel")
		valLabel.Size = UDim2.new(0, 84, 0, 20)
		valLabel.Position = UDim2.new(1, -96, 0, 6)
		valLabel.BackgroundTransparency = 1
		valLabel.Font = Enum.Font.GothamBold
		valLabel.TextSize = 13
		valLabel.TextColor3 = colors.Accent
		valLabel.TextXAlignment = Enum.TextXAlignment.Right
		valLabel.Parent = row

		local trackBg = Instance.new("Frame")
		trackBg.Size = UDim2.new(1, -24, 0, 6)
		trackBg.Position = UDim2.new(0, 12, 0, 38)
		trackBg.BorderSizePixel = 0
		trackBg.BackgroundColor3 = colors.Track
		trackBg.Parent = row
		UI.Corner(trackBg, 3)

		local fill = Instance.new("Frame")
		fill.Size = UDim2.new(0, 0, 1, 0)
		fill.BackgroundColor3 = colors.Accent
		fill.BorderSizePixel = 0
		fill.Parent = trackBg
		UI.Corner(fill, 3)

		local knob = Instance.new("Frame")
		knob.Size = UDim2.new(0, 14, 0, 14)
		knob.AnchorPoint = Vector2.new(0.5, 0.5)
		knob.Position = UDim2.new(0, 0, 0.5, 0)
		knob.BackgroundColor3 = Color3.fromRGB(240, 240, 245)
		knob.BorderSizePixel = 0
		knob.ZIndex = 2
		knob.Parent = trackBg
		UI.Corner(knob, 7)

		-- พื้นที่สัมผัสใหญ่สำหรับมือถือ
		local clickArea = Instance.new("TextButton")
		clickArea.Size = UDim2.new(1, 0, 0, 26)
		clickArea.Position = UDim2.new(0, 0, 0, 28)
		clickArea.BackgroundTransparency = 1
		clickArea.Text = ""
		clickArea.ZIndex = 3
		clickArea.Parent = row

		local value = clampNum(roundStep(tonumber(opts.Value) or minV, step), minV, maxV, minV)

		local function render()
			local pct = (value - minV) / (maxV - minV)
			fill.Size = UDim2.new(math.clamp(pct, 0, 1), 0, 1, 0)
			knob.Position = UDim2.new(math.clamp(pct, 0, 1), 0, 0.5, 0)
			valLabel.Text = formatNumber(value, decimals) .. unit
		end

		local function setValue(v, fire)
			v = clampNum(roundStep(v, step), minV, maxV, minV)
			if v == value then
				render()
				return
			end
			value = v
			render()
			if fire and opts.OnChanged then
				local ok, err = pcall(opts.OnChanged, value)
				if not ok then ErrorHandling.Report("UI.Slider", err) end
			end
			if fire and opts.StatePath then
				State.Set(opts.StatePath, value)
			end
		end
		render()

		local dragging = false
		local dragConn = nil
		local endConn = nil

		local function onDragPos(pos)
			local ap = trackBg.AbsolutePosition
			local asz = trackBg.AbsoluteSize
			if asz.X <= 0 then return end
			local pct = math.clamp((pos.X - ap.X) / asz.X, 0, 1)
			setValue(minV + pct * (maxV - minV), true)
		end

		local function stopDrag()
			dragging = false
			if dragConn then dragConn:Disconnect() dragConn = nil end
			if endConn then endConn:Disconnect() endConn = nil end
		end

		clickArea.InputBegan:Connect(function(input)
			if disabled then return end
			if input.UserInputType == Enum.UserInputType.MouseButton1
				or input.UserInputType == Enum.UserInputType.Touch then
				dragging = true
				onDragPos(input.Position)
				if dragConn then dragConn:Disconnect() end
				dragConn = UserInputService.InputChanged:Connect(function(inp2)
					if not dragging then return end
					if inp2.UserInputType == Enum.UserInputType.MouseMovement
						or inp2.UserInputType == Enum.UserInputType.Touch then
						onDragPos(inp2.Position)
					end
				end)
				if endConn then endConn:Disconnect() end
				endConn = UserInputService.InputEnded:Connect(function(inp2)
					if inp2.UserInputType == Enum.UserInputType.MouseButton1
						or inp2.UserInputType == Enum.UserInputType.Touch then
						stopDrag()
					end
				end)
			end
		end)

		ThemeEngine.Bind(function(c)
			if row.Parent then
				row.BackgroundColor3 = c.PanelAlt
				rowStroke.Color = c.Border
				label.TextColor3 = c.Text
				valLabel.TextColor3 = c.Accent
				trackBg.BackgroundColor3 = c.Track
				fill.BackgroundColor3 = c.Accent
			end
		end)

		if opts.StatePath then
			State.Bind(opts.StatePath, function(v)
				if isFiniteNumber(v) then
					setValue(v, false)
				end
			end)
		end

		local obj = {}
		local disabledFlag = disabled == true
		function obj.Get() return value end
		function obj.Set(v, silent)
			setValue(tonumber(v) or value, not silent)
		end
		obj.Disabled = disabledFlag
		function obj.SetDisabled(v)
			disabled = v == true
			obj.Disabled = disabled
		end
		function obj.GetFrame() return row end
		return obj
	end

	-- ── DROPDOWN (ใช้ Overlay เพื่อไม่ให้ถูกตัดโดย ScrollingFrame) ────────
	function UI.Dropdown(opts)
		local colors = ThemeEngine.GetColors()
		local options = type(opts.Options) == "table" and opts.Options or {}

		local row = Instance.new("Frame")
		row.LayoutOrder = opts.LayoutOrder or 0
		row.Size = UDim2.new(1, 0, 0, 52)
		row.BackgroundColor3 = colors.PanelAlt
		row.BackgroundTransparency = 0.45
		row.BorderSizePixel = 0
		row.Parent = opts.Parent
		UI.Corner(row, 8)
		local rowStroke = UI.Stroke(row, colors.Border, 1, 0.65)

		local label = Instance.new("TextLabel")
		label.Size = UDim2.new(1, -24, 0, 16)
		label.Position = UDim2.new(0, 12, 0, 4)
		label.BackgroundTransparency = 1
		label.Font = Enum.Font.GothamMedium
		label.TextSize = 11
		label.TextColor3 = colors.TextDim
		label.TextXAlignment = Enum.TextXAlignment.Left
		label.Parent = row
		Localization.BindText(label, opts.LabelKey)

		local selBtn = Instance.new("TextButton")
		selBtn.Size = UDim2.new(1, -24, 0, 26)
		selBtn.Position = UDim2.new(0, 12, 0, 22)
		selBtn.BackgroundColor3 = colors.Panel
		selBtn.BackgroundTransparency = 0.25
		selBtn.BorderSizePixel = 0
		selBtn.Font = Enum.Font.GothamBold
		selBtn.TextSize = 12
		selBtn.TextXAlignment = Enum.TextXAlignment.Left
		selBtn.AutoButtonColor = false
		selBtn.Parent = row
		UI.Corner(selBtn, 6)
		local selStroke = UI.Stroke(selBtn, colors.Border, 1, 0.5)

		local disabled = opts.Disabled == true
		local current = opts.Value
		if current == nil and options[1] then
			current = options[1].Value
		end

		local function labelFor(value)
			for _, o in ipairs(options) do
				if o.Value == value then
					return Localization.L(o.LabelKey or o.Value)
				end
			end
			return tostring(value)
		end

		local function render()
			selBtn.Text = "  " .. labelFor(current) .. "   ▾"
		end
		render()

		selBtn.MouseButton1Click:Connect(function()
			if disabled then return end
			local rowWidth = math.max(row.AbsoluteSize.X, 160)
			Overlay.Open(selBtn, rowWidth, function(content, close)
				local layout = Instance.new("UIListLayout")
				layout.SortOrder = Enum.SortOrder.LayoutOrder
				layout.Parent = content

				local pad = Instance.new("UIPadding")
				pad.PaddingTop = UDim.new(0, 4)
				pad.PaddingBottom = UDim.new(0, 4)
				pad.PaddingLeft = UDim.new(0, 4)
				pad.PaddingRight = UDim.new(0, 4)
				pad.Parent = content

				for i, o in ipairs(options) do
					local optBtn = Instance.new("TextButton")
					optBtn.Size = UDim2.new(1, 0, 0, 30)
					optBtn.LayoutOrder = i
					optBtn.BorderSizePixel = 0
					optBtn.AutoButtonColor = false
					optBtn.Font = Enum.Font.GothamMedium
					optBtn.TextSize = 12
					optBtn.TextXAlignment = Enum.TextXAlignment.Left
					optBtn.Parent = content
					UI.Corner(optBtn, 5)

					local c = ThemeEngine.GetColors()
					local selected = (o.Value == current)
					optBtn.BackgroundTransparency = selected and 0.72 or 1
					optBtn.BackgroundColor3 = c.Accent
					optBtn.TextColor3 = selected and c.AccentSoft or c.Text
					optBtn.Text = (selected and "  ✓ " or "     ") .. labelFor(o.Value)

					optBtn.MouseButton1Click:Connect(function()
						current = o.Value
						render()
						close()
						if opts.OnChanged then
							local ok, err = pcall(opts.OnChanged, current)
							if not ok then ErrorHandling.Report("UI.Dropdown", err) end
						end
						if opts.StatePath then
							State.Set(opts.StatePath, current)
						end
					end)
				end
			end)
		end)

		ThemeEngine.Bind(function(c)
			if row.Parent then
				row.BackgroundColor3 = c.PanelAlt
				rowStroke.Color = c.Border
				label.TextColor3 = c.TextDim
				selBtn.BackgroundColor3 = c.Panel
				selStroke.Color = c.Border
				selBtn.TextColor3 = c.Accent
			end
		end)

		if opts.StatePath then
			State.Bind(opts.StatePath, function(v)
				if v ~= nil then
					current = v
					render()
				end
			end)
		end

		local obj = {}
		function obj.Get() return current end
		function obj.Set(v, silent)
			current = v
			render()
			if not silent and opts.OnChanged then
				pcall(opts.OnChanged, current)
			end
		end
		function obj.GetFrame() return row end
		return obj
	end

