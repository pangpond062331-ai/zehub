-- 5) กู้ค่าการเปิด/ปิดโมดูลที่บันทึกไว้ (โมดูลถูกลงทะเบียนไว้แล้ว)
pcall(function()
	ModuleRegistry.RestoreStates()
end)

-- 6) จัดตำแหน่งหน้าต่างแล้วแสดง
Window.ApplyLayout()
Window.Open()

-- 7) ตั้งคีย์เปิด/ปิด UI
do
	local toggleKey = safeKeycodeFromName(State.Get("Controls.ToggleKeyName")) or Enum.KeyCode.RightControl
	InputManager.Bind(toggleKey, function()
		Window.Toggle()
	end)
end

-- 8) จัดการเมื่อตัวละครเกิดใหม่ (โมดูลที่เปิดอยู่ re-apply)
LocalPlayer.CharacterAdded:Connect(function()
	ModuleRegistry.HandleRespawn()
end)
-- ถ้าตัวละครมีอยู่แล้วตอนเริ่มต้น ให้ apply ทันที
if LocalPlayer.Character then
	task.defer(function()
		ModuleRegistry.HandleRespawn()
	end)
end

-- 9) Public API
_G.AnimeNexus = {
	Version = VERSION,
	Window = Window,
	State = State,
	Theme = ThemeEngine,
	Localization = Localization,
	Modules = ModuleRegistry,
	Notify = Notify,
	Perf = Perf,
	Cleanup = Cleanup,
	ErrorHandling = ErrorHandling,
}

-- 10) Cleanup เมื่อ script ถูกทำลาย
script.Destroying:Connect(function()
	Cleanup.Teardown()
end)

-- ==================== INITIALIZATION COMPLETE ====================
print("[AnimeNexus] v" .. VERSION .. " initialized successfully.")
print("[AnimeNexus] Language: " .. tostring(Localization.GetLanguage()) .. " | Theme: " .. tostring(State.Get("Theme", "WaterBreathing")))
print("[AnimeNexus] Toggle: " .. tostring(State.Get("Controls.ToggleKeyName")) .. " | Modules: " .. #ModuleRegistry.list)

