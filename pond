-- STATE (ที่เก็บค่าการตั้งค่ากลาง + ตรวจสอบความถูกต้อง)
-- ═══════════════════════════════════════════════════════════════════════════
local DefaultConfig = {
	Language          = "EN",
	Theme             = "WaterBreathing",
	AnimationSpeed    = 1,
	WindowOpacity     = 0.92,   -- 0.3..1  (ค่ามาก = ทึบ)
	PerformanceMode   = false,
	ReduceMotion      = false,
	DevTestMode       = false,
	Effects = {
		BackgroundGradient = true,
		Glow               = true,
		Aura               = true,
		ToastAnimation     = true,
	},
	Controls = {
		ToggleKeyName = "RightControl",
		DragEnabled   = true,
	},
	Window = {
		RememberPosition = true,
		MiniMode         = false,
		PositionX        = nil, -- จัดเก็บเป็น offset ของหน้าต่าง (number หรือ nil)
		PositionY        = nil,
	},
	Modules    = {}, -- [moduleId] = true/false
	ModuleData = {}, -- [moduleId] = { ... } ค่าตั้งค่าของโมดูล (ตัวเลข/สตริง/บูลีน)
}

local State = {}
do
	local values = deepCopy(DefaultConfig)
	local listeners = {} -- { {path=string, fn=function, token=table} }
	local anyListeners = {} -- เรียกเมื่อ path ใดก็ได้เปลี่ยน
	local onChangeSignal = Signal.new("StateChange")

	local function getTable(path)
		local node = values
		for part in tostring(path):gmatch("[^%.]+") do
			if type(node) ~= "table" then return nil end
			node = node[part]
		end
		if node == nil then return nil end
		return node
	end

	function State.Get(path)
		if not path or path == "" then return values end
		local node = values
		local last = nil
		for part in tostring(path):gmatch("[^%.]+") do
			if type(node) ~= "table" then return nil end
			last = node
			node = node[part]
		end
		return node
	end

	function State.Set(path, newValue, opts)
		opts = opts or {}
		if type(path) ~= "string" or path == "" then return end
		local parts = {}
		for part in path:gmatch("[^%.]+") do
			table.insert(parts, part)
		end
		local node = values
		for i = 1, #parts - 1 do
			local part = parts[i]
			if type(node[part]) ~= "table" then
				node[part] = {}
			end
			node = node[part]
		end
		local lastPart = parts[#parts]
		if node[lastPart] == newValue then return end
		node[lastPart] = newValue
		-- แจ้ง listeners ของ path นี้
		for _, l in ipairs(listeners) do
			if l.path == path then
				pcall(l.fn, newValue)
			end
		end
		if not opts.silent then
			onChangeSignal:Fire(path, newValue)
			for _, fn in ipairs(anyListeners) do
				pcall(fn, path, newValue)
			end
		end
	end

	function State.Bind(path, fn)
		if type(fn) ~= "function" then return nil end
		local token = {}
		table.insert(listeners, { path = path, fn = fn, token = token })
		pcall(fn, State.Get(path))
		return token
	end

	function State.Unbind(token)
		if not token then return end
		for i, l in ipairs(listeners) do
			if l.token == token then
				table.remove(listeners, i)
				break
			end
		end
	end

	function State.OnChange(fn)
		if type(fn) ~= "function" then return nil end
		table.insert(anyListeners, fn)
		return function()
			for i, f in ipairs(anyListeners) do
				if f == fn then
					table.remove(anyListeners, i)
					break
				end
			end
		end
	end

	function State.GetSignal()
		return onChangeSignal
	end

	function State.GetAll()
		return deepCopy(values)
	end

	-- ใช้ข้อมูลที่ตรวจสอบแล้วแทนที่ค่าปัจจุบัน + แจ้งทุก listener
	function State.LoadValidated(validated)
		values = deepCopy(validated or deepCopy(DefaultConfig))
		for _, l in ipairs(listeners) do
			pcall(l.fn, State.Get(l.path))
		end
		onChangeSignal:Fire("*")
		for _, fn in ipairs(anyListeners) do
			pcall(fn, "*", nil)
		end
	end

	function State.Reset()
		State.LoadValidated(DefaultConfig)
	end

	function State.GetListenerCount()
		return #listeners, #anyListeners
	end
end

-- ตรวจสอบข้อมูลขาเข้า (ใช้กับโหลดโปรไฟล์/import/bridge)
-- คืนค่า: config ที่สะอาด, รายการ issues สำหรับ Diagnostics
local function ValidateConfig(raw)
	local issues = {}
	local out = deepCopy(DefaultConfig)

	if type(raw) ~= "table" then
		table.insert(issues, "root: expected table, got " .. type(raw))
		return out, issues
	end

	if type(raw.Language) == "string" and (raw.Language == "EN" or raw.Language == "TH") then
		out.Language = raw.Language
	elseif raw.Language ~= nil then
		table.insert(issues, "Language: invalid value ignored")
	end

	if type(raw.Theme) == "string" and ThemeEngine.IsValid(raw.Theme) then
		out.Theme = raw.Theme
	elseif raw.Theme ~= nil then
		table.insert(issues, "Theme: unknown theme ignored")
	end

	if isFiniteNumber(raw.AnimationSpeed) then
		out.AnimationSpeed = clampNum(raw.AnimationSpeed, 0.25, 4, 1)
	elseif raw.AnimationSpeed ~= nil then
		table.insert(issues, "AnimationSpeed: invalid number ignored")
	end

	if isFiniteNumber(raw.WindowOpacity) then
		out.WindowOpacity = clampNum(raw.WindowOpacity, 0.3, 1, 0.92)
	elseif raw.WindowOpacity ~= nil then
		table.insert(issues, "WindowOpacity: invalid number ignored")
	end

	if type(raw.PerformanceMode) == "boolean" then out.PerformanceMode = raw.PerformanceMode end
	if type(raw.ReduceMotion) == "boolean" then out.ReduceMotion = raw.ReduceMotion end
	if type(raw.DevTestMode) == "boolean" then out.DevTestMode = raw.DevTestMode end

	if type(raw.Effects) == "table" then
		for k in pairs(out.Effects) do
			if type(raw.Effects[k]) == "boolean" then
				out.Effects[k] = raw.Effects[k]
			end
		end
	elseif raw.Effects ~= nil then
		table.insert(issues, "Effects: invalid table ignored")
	end

	if type(raw.Controls) == "table" then
		if type(raw.Controls.ToggleKeyName) == "string" and safeKeycodeFromName(raw.Controls.ToggleKeyName) then
			out.Controls.ToggleKeyName = raw.Controls.ToggleKeyName
		elseif raw.Controls.ToggleKeyName ~= nil then
			table.insert(issues, "Controls.ToggleKeyName: unknown key ignored")
		end
		if type(raw.Controls.DragEnabled) == "boolean" then
			out.Controls.DragEnabled = raw.Controls.DragEnabled
		end
	end

	if type(raw.Window) == "table" then
		if type(raw.Window.RememberPosition) == "boolean" then
			out.Window.RememberPosition = raw.Window.RememberPosition
		end
		if type(raw.Window.MiniMode) == "boolean" then
			out.Window.MiniMode = raw.Window.MiniMode
		end
		if isFiniteNumber(raw.Window.PositionX) then
			out.Window.PositionX = clampNum(raw.Window.PositionX, -4000, 4000, nil)
		end
		if isFiniteNumber(raw.Window.PositionY) then
			out.Window.PositionY = clampNum(raw.Window.PositionY, -4000, 4000, nil)
		end
	end

	if type(raw.Modules) == "table" then
		for k, v in pairs(raw.Modules) do
			if type(k) == "string" and type(v) == "boolean" then
				out.Modules[k] = v
			end
		end
	else
		if raw.Modules ~= nil then
			table.insert(issues, "Modules: invalid table ignored")
		end
	end

	if type(raw.ModuleData) == "table" then
		for modId, data in pairs(raw.ModuleData) do
			if type(modId) == "string" and type(data) == "table" then
				local clean = {}
				for k, v in pairs(data) do
					local t = type(v)
					if t == "number" and isFiniteNumber(v) then
						clean[k] = v
					elseif t == "boolean" or t == "string" then
						clean[k] = v
					end
				end
				out.ModuleData[modId] = clean
			end
		end
	end

	return out, issues
end

-- ═══════════════════════════════════════════════════════════════════════════
-- PERFORMANCE MANAGER
-- ═══════════════════════════════════════════════════════════════════════════
local Perf = {}
do
	local fps = 60
	local frames = 0
	local elapsed = 0
	local samplerConn = nil
	local perfMode = false
	local reduceMotion = false
	local animSpeed = 1

	-- Render-step scheduler: named steps with priority (lower runs first).
	local renderSteps = {}   -- name -> { name, priority, fn }
	local renderOrder = {}   -- array of names, kept sorted by priority
	local renderConn = nil

	local function resortOrder()
		table.sort(renderOrder, function(a, b)
			local pa = renderSteps[a] and renderSteps[a].priority or 0
			local pb = renderSteps[b] and renderSteps[b].priority or 0
			if pa == pb then return a < b end
			return pa < pb
		end)
	end

	local function ensureRenderConn()
		if renderConn then return end
		renderConn = RunService.RenderStepped:Connect(function(dt)
			for _, name in ipairs(renderOrder) do
				local step = renderSteps[name]
				if step then
					local ok, err = pcall(step.fn, dt)
					if not ok then
						ErrorHandling.Report("Perf.RenderStep." .. name, err)
					end
				end
			end
		end)
		Cleanup.OnTeardown(function()
			if renderConn then
				renderConn:Disconnect()
				renderConn = nil
			end
			renderSteps = {}
			renderOrder = {}
		end)
	end

	-- ลงทะเบียนขั้นตอนเรนเดอร์: priority ต่ำทำงานก่อน, คืน handle
	function Perf.RegisterRenderStep(name, priority, fn)
		if type(name) ~= "string" or type(fn) ~= "function" then return nil end
		renderSteps[name] = { name = name, priority = tonumber(priority) or 0, fn = fn }
		local found = false
		for _, n in ipairs(renderOrder) do
			if n == name then found = true break end
		end
		if not found then
			table.insert(renderOrder, name)
			resortOrder()
		end
		ensureRenderConn()
		return name
	end

	function Perf.UnregisterRenderStep(name)
		if renderSteps[name] then
			renderSteps[name] = nil
			for i, n in ipairs(renderOrder) do
				if n == name then
					table.remove(renderOrder, i)
					break
				end
			end
		end
	end

	function Perf.Init()
		if samplerConn then return end
		samplerConn = RunService.Heartbeat:Connect(function(dt)
			frames = frames + 1
			elapsed = elapsed + dt
			if elapsed >= 0.5 then
				fps = frames / math.max(elapsed, 0.0001)
				frames = 0
				elapsed = 0
			end
		end)
		Cleanup.OnTeardown(function()
			if samplerConn then
				samplerConn:Disconnect()
				samplerConn = nil
			end
		end)
	end

	function Perf.GetFPS()
		return fps
	end

	function Perf.SetPerformanceMode(v)
		perfMode = v == true
	end
	function Perf.IsPerformanceMode() return perfMode end

	function Perf.SetReduceMotion(v)
		reduceMotion = v == true
	end
	function Perf.IsReduceMotion() return reduceMotion end

	function Perf.SetAnimationSpeed(v)
		animSpeed = clampNum(v, 0.25, 4, 1)
	end

	-- คืนค่า duration ที่ปรับตาม speed/performance/reduce-motion
	function Perf.Duration(base)
		if perfMode or reduceMotion then
			return 0.05
		end
		return clampNum((base or 0.2) / animSpeed, 0.05, 3, 0.2)
	end

	-- สร้าง Tween ที่ผ่านการปรับความเร็วแล้ว
	function Perf.Tween(inst, goals, base, style, dir, loopCount, reverses)
		local info = TweenInfo.new(
			Perf.Duration(base),
			style or Enum.EasingStyle.Quad,
			dir or Enum.EasingDirection.Out,
			loopCount or 0,
			reverses == true
		)
		local t = TweenService:Create(inst, info, goals)
		t:Play()
		return t
	end

	function Perf.IsHeavyAllowed()
		return not perfMode and not reduceMotion
	end
end

