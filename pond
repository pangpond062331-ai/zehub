-- SIGNAL (mini event system พร้อมนับจำนวน connection สำหรับ Diagnostics)
-- ═══════════════════════════════════════════════════════════════════════════
local ConnectionCount = 0

local Connection = {}
Connection.__index = Connection

function Connection:Disconnect()
	if not self.Connected then return end
	self.Connected = false
	local sig = self._signal
	if sig and sig._conns then
		for i = #sig._conns, 1, -1 do
			if sig._conns[i] == self then
				table.remove(sig._conns, i)
				break
			end
		end
	end
	ConnectionCount = math.max(0, ConnectionCount - 1)
end

local Signal = {}
Signal.__index = Signal

function Signal.new(name)
	return setmetatable({
		_name      = name or "Signal",
		_conns     = {},
		_destroyed = false,
	}, Signal)
end

function Signal:Connect(fn)
	local sig = self
	local conn = setmetatable({
		_fn      = fn,
		_signal  = sig,
		Connected = true,
	}, Connection)
	if self._destroyed then
		conn.Connected = false
		return conn
	end
	table.insert(self._conns, conn)
	ConnectionCount = ConnectionCount + 1
	return conn
end

function Signal:Fire(...)
	local snapshot = {}
	for i = 1, #self._conns do
		snapshot[i] = self._conns[i]
	end
	for _, conn in ipairs(snapshot) do
		if conn.Connected and conn._signal == self then
			local ok, err = pcall(conn._fn, ...)
			if not ok then
				ErrorHandling.Report("Signal." .. self._name, err)
			end
		end
	end
end

function Signal:Destroy()
	self._destroyed = true
	for i = #self._conns, 1, -1 do
		self._conns[i]:Disconnect()
	end
	self._conns = {}
end

function Signal:GetConnectionCount()
	return #self._conns
end

