-- ──────────────────────────────────────────────
--  SERVICES
-- ──────────────────────────────────────────────
local Players         = game:GetService("Players")
local RunService      = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local TweenService    = game:GetService("TweenService")
local Workspace       = game:GetService("Workspace")

local LocalPlayer = Players.LocalPlayer
local Character   = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
local HumanoidRootPart = Character:WaitForChild("HumanoidRootPart")
local Humanoid    = Character:WaitForChild("Humanoid")

-- ──────────────────────────────────────────────
--  CONFIG
-- ──────────────────────────────────────────────
local Config = {
    WalkSpeed      = 100,
    JumpPower      = 100,
    AutoFarmActive = false,
    AutoAimActive  = false,
    NoclipActive   = false,
    ESPActive      = false,
    DetectRange    = 100,   -- studs
    AttackDamage   = 50,
}

-- ──────────────────────────────────────────────
--  UTILITY FUNCTIONS
-- ──────────────────────────────────────────────

--- หา Character ของ Enemy ทั้งหมด
local function GetEnemies()
    local enemies = {}
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local hrp = player.Character:FindFirstChild("HumanoidRootPart")
            local hum = player.Character:FindFirstChildOfClass("Humanoid")
            if hrp and hum and hum.Health > 0 then
                table.insert(enemies, player.Character)
            end
        end
    end
    return enemies
end

--- หา Enemy ที่ใกล้ที่สุด
local function GetNearestEnemy()
    local nearest, minDist = nil, math.huge
    for _, enemy in ipairs(GetEnemies()) do
        local hrp = enemy:FindFirstChild("HumanoidRootPart")
        if hrp then
            local dist = (HumanoidRootPart.Position - hrp.Position).Magnitude
            if dist < minDist then
                minDist = dist
                nearest = enemy
            end
        end
    end
    return nearest, minDist
end

-- ──────────────────────────────────────────────
--  🚀 MOVEMENT FUNCTIONS
-- ──────────────────────────────────────────────

local Movement = {}

--- ตั้งค่า WalkSpeed
function Movement.SetSpeed(speed)
    Humanoid.WalkSpeed = speed
    Config.WalkSpeed = speed
    print("[Robot] Speed set to " .. speed)
end

--- ตั้งค่า JumpPower
function Movement.SetJump(power)
    Humanoid.JumpPower = power
    Config.JumpPower = power
    print("[Robot] JumpPower set to " .. power)
end

--- Teleport ไปยังตำแหน่งที่กำหนด
function Movement.Teleport(position)
    HumanoidRootPart.CFrame = CFrame.new(position)
    print("[Robot] Teleported to " .. tostring(position))
end

--- Teleport ไปหา player ที่ระบุชื่อ
function Movement.TeleportToPlayer(targetName)
    local target = Players:FindFirstChild(targetName)
    if target and target.Character then
        local hrp = target.Character:FindFirstChild("HumanoidRootPart")
        if hrp then
            HumanoidRootPart.CFrame = hrp.CFrame + Vector3.new(0, 3, 0)
            print("[Robot] Teleported to " .. targetName)
        end
    else
        warn("[Robot] Player not found: " .. targetName)
    end
end

--- Noclip Toggle
local noclipConn
function Movement.ToggleNoclip(enabled)
    Config.NoclipActive = enabled
    if enabled then
        noclipConn = RunService.Stepped:Connect(function()
            for _, part in ipairs(Character:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.CanCollide = false
                end
            end
        end)
        print("[Robot] Noclip ON")
    else
        if noclipConn then noclipConn:Disconnect() end
        print("[Robot] Noclip OFF")
    end
end

--- Fly ขึ้น/ลง
function Movement.FlyTo(targetPos, speed)
    speed = speed or 50
    local dist = (HumanoidRootPart.Position - targetPos).Magnitude
    local t = dist / speed
    local tween = TweenService:Create(
        HumanoidRootPart,
        TweenInfo.new(t, Enum.EasingStyle.Linear),
        { CFrame = CFrame.new(targetPos) }
    )
    tween:Play()
    print("[Robot] Flying to " .. tostring(targetPos))
end

-- ──────────────────────────────────────────────
--  ⚔️ ATTACK / COMBAT FUNCTIONS
-- ──────────────────────────────────────────────

local Combat = {}

--- ยิง/โจมตี enemy ที่ใกล้ที่สุด (Fake Damage via Remote - ปรับตาม game)
function Combat.AttackNearest()
    local enemy, dist = GetNearestEnemy()
    if enemy and dist <= Config.DetectRange then
        local hum = enemy:FindFirstChildOfClass("Humanoid")
        if hum then
            -- หมายเหตุ: Roblox ไม่อนุญาตให้ Client ลด HP ตรงๆ
            -- ปรับส่วนนี้ให้ Fire Remote Event ของเกมแทน
            warn("[Robot] [AttackNearest] Target: " .. enemy.Name .. " | Dist: " .. math.floor(dist) .. " studs")
            print("[Robot] Attack! HP remaining: " .. hum.Health)
        end
    else
        print("[Robot] No enemy in range (" .. Config.DetectRange .. " studs)")
    end
end

--- Auto Aim ไปที่ Enemy ที่ใกล้ที่สุด
local autoAimConn
function Combat.ToggleAutoAim(enabled)
    Config.AutoAimActive = enabled
    if enabled then
        autoAimConn = RunService.RenderStepped:Connect(function()
            local enemy = GetNearestEnemy()
            if enemy then
                local hrp = enemy:FindFirstChild("HumanoidRootPart")
                if hrp then
                    Workspace.CurrentCamera.CFrame = CFrame.new(
                        Workspace.CurrentCamera.CFrame.Position,
                        hrp.Position
                    )
                end
            end
        end)
        print("[Robot] AutoAim ON")
    else
        if autoAimConn then autoAimConn:Disconnect() end
        print("[Robot] AutoAim OFF")
    end
end

--- Kill Aura — โจมตีทุก enemy ในรัศมีอย่างต่อเนื่อง
local killAuraConn
function Combat.ToggleKillAura(enabled)
    if enabled then
        killAuraConn = RunService.Heartbeat:Connect(function()
            for _, enemy in ipairs(GetEnemies()) do
                local hrp = enemy:FindFirstChild("HumanoidRootPart")
                if hrp then
                    local dist = (HumanoidRootPart.Position - hrp.Position).Magnitude
                    if dist <= Config.DetectRange then
                        -- ปรับให้ Fire Remote Event ของเกม
                        warn("[Robot] [KillAura] Attacking: " .. enemy.Name)
                    end
                end
            end
        end)
        print("[Robot] KillAura ON")
    else
        if killAuraConn then killAuraConn:Disconnect() end
        print("[Robot] KillAura OFF")
    end
end

-- ──────────────────────────────────────────────
--  🔍 DETECT / SCAN FUNCTIONS
-- ──────────────────────────────────────────────

local Scanner = {}

--- แสดงรายชื่อ Enemy ทั้งหมดพร้อมระยะทาง
function Scanner.ScanAll()
    local enemies = GetEnemies()
    print("═══════ 🔍 SCAN RESULT ═══════")
    if #enemies == 0 then
        print("No enemies found.")
    else
        for i, enemy in ipairs(enemies) do
            local hrp = enemy:FindFirstChild("HumanoidRootPart")
            local hum = enemy:FindFirstChildOfClass("Humanoid")
            local dist = hrp and math.floor((HumanoidRootPart.Position - hrp.Position).Magnitude) or "?"
            local hp   = hum and math.floor(hum.Health) or "?"
            print(i .. ". " .. enemy.Name .. " | HP: " .. hp .. " | Dist: " .. dist .. " studs")
        end
    end
    print("══════════════════════════════")
end

--- ESP — แสดง Highlight บน Enemy
function Scanner.ToggleESP(enabled)
    Config.ESPActive = enabled
    -- ลบ ESP เก่าทั้งหมดก่อน
    for _, v in ipairs(Workspace:GetDescendants()) do
        if v:IsA("SelectionBox") and v.Name == "RobotESP" then
            v:Destroy()
        end
    end
    if enabled then
        for _, enemy in ipairs(GetEnemies()) do
            local box = Instance.new("SelectionBox")
            box.Name = "RobotESP"
            box.Adornee = enemy
            box.Color3 = Color3.fromRGB(255, 0, 0)
            box.LineThickness = 0.05
            box.SurfaceTransparency = 0.7
            box.SurfaceColor3 = Color3.fromRGB(255, 0, 0)
            box.Parent = Workspace
        end
        print("[Robot] ESP ON")
    else
        print("[Robot] ESP OFF")
    end
end

--- แสดงระยะทาง Real-time ไปยัง Enemy ที่ใกล้ที่สุด
function Scanner.TrackNearest()
    local enemy, dist = GetNearestEnemy()
    if enemy then
        print("[Robot] Nearest: " .. enemy.Name .. " | " .. math.floor(dist) .. " studs away")
    else
        print("[Robot] No enemies detected.")
    end
end

-- ──────────────────────────────────────────────
--  🤖 AUTO FARM
-- ──────────────────────────────────────────────

local AutoFarm = {}
local autoFarmConn

--- Auto Farm — เดินหาและโจมตี Enemy อัตโนมัติ
function AutoFarm.Toggle(enabled)
    Config.AutoFarmActive = enabled
    if enabled then
        autoFarmConn = RunService.Heartbeat:Connect(function()
            local enemy, dist = GetNearestEnemy()
            if enemy then
                local hrp = enemy:FindFirstChild("HumanoidRootPart")
                if hrp then
                    if dist > 5 then
                        -- เดินเข้าหา
                        Humanoid:MoveTo(hrp.Position)
                    else
                        -- โจมตี
                        Combat.AttackNearest()
                    end
                end
            end
        end)
        print("[Robot] AutoFarm ON")
    else
        if autoFarmConn then autoFarmConn:Disconnect() end
        Humanoid:MoveTo(HumanoidRootPart.Position) -- หยุด
        print("[Robot] AutoFarm OFF")
    end
end

-- ──────────────────────────────────────────────
--  🎛️ MENU (ScreenGui)
-- ──────────────────────────────────────────────

local function CreateMenu()
    -- ลบเมนูเก่าก่อน
    local oldGui = LocalPlayer.PlayerGui:FindFirstChild("RobotMenu")
    if oldGui then oldGui:Destroy() end

    local ScreenGui = Instance.new("ScreenGui")
    ScreenGui.Name = "RobotMenu"
    ScreenGui.ResetOnSpawn = false
    ScreenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    ScreenGui.Parent = LocalPlayer.PlayerGui

    -- Main Frame
    local Frame = Instance.new("Frame")
    Frame.Size = UDim2.new(0, 320, 0, 460)
    Frame.Position = UDim2.new(0, 20, 0.5, -230)
    Frame.BackgroundColor3 = Color3.fromRGB(15, 15, 20)
    Frame.BorderSizePixel = 0
    Frame.Parent = ScreenGui

    local Corner = Instance.new("UICorner")
    Corner.CornerRadius = UDim.new(0, 10)
    Corner.Parent = Frame

    -- Title
    local Title = Instance.new("TextLabel")
    Title.Size = UDim2.new(1, 0, 0, 40)
    Title.BackgroundColor3 = Color3.fromRGB(0, 120, 255)
    Title.Font = Enum.Font.GothamBold
    Title.Text = "🤖 ROBOT FRAMEWORK"
    Title.TextColor3 = Color3.fromRGB(255, 255, 255)
    Title.TextSize = 16
    Title.Parent = Frame

    local TitleCorner = Instance.new("UICorner")
    TitleCorner.CornerRadius = UDim.new(0, 10)
    TitleCorner.Parent = Title

    -- Draggable
    local dragging, dragInput, dragStart, startPos
    Title.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            dragStart = input.Position
            startPos = Frame.Position
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            local delta = input.Position - dragStart
            Frame.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + delta.X,
                startPos.Y.Scale, startPos.Y.Offset + delta.Y
            )
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)

    -- Scroll Container
    local ScrollFrame = Instance.new("ScrollingFrame")
    ScrollFrame.Size = UDim2.new(1, -10, 1, -50)
    ScrollFrame.Position = UDim2.new(0, 5, 0, 45)
    ScrollFrame.BackgroundTransparency = 1
    ScrollFrame.ScrollBarThickness = 4
    ScrollFrame.CanvasSize = UDim2.new(0, 0, 0, 0)
    ScrollFrame.AutomaticCanvasSize = Enum.AutomaticSize.Y
    ScrollFrame.Parent = Frame

    local ListLayout = Instance.new("UIListLayout")
    ListLayout.Padding = UDim.new(0, 6)
    ListLayout.Parent = ScrollFrame

    local Padding = Instance.new("UIPadding")
    Padding.PaddingLeft = UDim.new(0, 5)
    Padding.PaddingRight = UDim.new(0, 5)
    Padding.PaddingTop = UDim.new(0, 5)
    Padding.Parent = ScrollFrame

    -- ── Helper: สร้างปุ่ม ──
    local function MakeButton(text, color, callback)
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(1, 0, 0, 36)
        btn.BackgroundColor3 = color or Color3.fromRGB(40, 40, 55)
        btn.Font = Enum.Font.GothamSemibold
        btn.Text = text
        btn.TextColor3 = Color3.fromRGB(255, 255, 255)
        btn.TextSize = 13
        btn.BorderSizePixel = 0
        btn.Parent = ScrollFrame

        local bc = Instance.new("UICorner")
        bc.CornerRadius = UDim.new(0, 6)
        bc.Parent = btn

        btn.MouseEnter:Connect(function()
            TweenService:Create(btn, TweenInfo.new(0.15), {
                BackgroundColor3 = color and color:Lerp(Color3.fromRGB(255,255,255), 0.15) or Color3.fromRGB(60,60,80)
            }):Play()
        end)
        btn.MouseLeave:Connect(function()
            TweenService:Create(btn, TweenInfo.new(0.15), {
                BackgroundColor3 = color or Color3.fromRGB(40, 40, 55)
            }):Play()
        end)

        btn.MouseButton1Click:Connect(callback)
        return btn
    end

    -- ── Helper: สร้าง Toggle ──
    local function MakeToggle(text, configKey, callback)
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(1, 0, 0, 36)
        btn.BackgroundColor3 = Color3.fromRGB(40, 40, 55)
        btn.Font = Enum.Font.GothamSemibold
        btn.TextColor3 = Color3.fromRGB(255, 255, 255)
        btn.TextSize = 13
        btn.BorderSizePixel = 0
        btn.Parent = ScrollFrame

        local bc = Instance.new("UICorner")
        bc.CornerRadius = UDim.new(0, 6)
        bc.Parent = btn

        local function UpdateToggle()
            local active = Config[configKey]
            btn.Text = text .. (active and "  ✅ ON" or "  ❌ OFF")
            btn.BackgroundColor3 = active and Color3.fromRGB(0, 150, 80) or Color3.fromRGB(40, 40, 55)
        end
        UpdateToggle()

        btn.MouseButton1Click:Connect(function()
            Config[configKey] = not Config[configKey]
            callback(Config[configKey])
            UpdateToggle()
        end)
        return btn
    end

    -- ── Helper: Section Label ──
    local function MakeSection(text)
        local lbl = Instance.new("TextLabel")
        lbl.Size = UDim2.new(1, 0, 0, 24)
        lbl.BackgroundTransparency = 1
        lbl.Font = Enum.Font.GothamBold
        lbl.Text = text
        lbl.TextColor3 = Color3.fromRGB(0, 180, 255)
        lbl.TextSize = 12
        lbl.TextXAlignment = Enum.TextXAlignment.Left
        lbl.Parent = ScrollFrame
        return lbl
    end

    -- ════════════ MENU ITEMS ════════════

    MakeSection("─── 🚀 MOVEMENT ───")

    MakeButton("⚡ Speed Boost (x" .. Config.WalkSpeed .. ")", Color3.fromRGB(30, 100, 200), function()
        Movement.SetSpeed(Config.WalkSpeed == 16 and 100 or 16)
    end)

    MakeButton("🦘 High Jump", Color3.fromRGB(30, 100, 200), function()
        Movement.SetJump(Config.JumpPower == 50 and 200 or 50)
    end)

    MakeToggle("🌀 Noclip", "NoclipActive", function(state)
        Movement.ToggleNoclip(state)
    end)

    MakeButton("🎯 TP to Nearest Enemy", Color3.fromRGB(50, 80, 160), function()
        local enemy = GetNearestEnemy()
        if enemy then
            local hrp = enemy:FindFirstChild("HumanoidRootPart")
            if hrp then Movement.Teleport(hrp.Position + Vector3.new(0, 3, 0)) end
        else
            warn("[Robot] No enemy found!")
        end
    end)

    MakeSection("─── ⚔️ COMBAT ───")

    MakeButton("💥 Attack Nearest", Color3.fromRGB(180, 40, 40), function()
        Combat.AttackNearest()
    end)

    MakeToggle("🎯 Auto Aim", "AutoAimActive", function(state)
        Combat.ToggleAutoAim(state)
    end)

    MakeToggle("⚡ Kill Aura", "KillAuraActive", function(state)
        Combat.ToggleKillAura(state)
    end)

    MakeSection("─── 🔍 SCAN / ESP ───")

    MakeButton("📡 Scan All Enemies", Color3.fromRGB(0, 130, 130), function()
        Scanner.ScanAll()
    end)

    MakeButton("📍 Track Nearest", Color3.fromRGB(0, 130, 130), function()
        Scanner.TrackNearest()
    end)

    MakeToggle("🟥 ESP (Enemy Box)", "ESPActive", function(state)
        Scanner.ToggleESP(state)
    end)

    MakeSection("─── 🤖 AUTO FARM ───")

    MakeToggle("🌾 Auto Farm", "AutoFarmActive", function(state)
        AutoFarm.Toggle(state)
    end)

    MakeSection("─── ⚙️ SETTINGS ───")

    MakeButton("🔄 Reset Character", Color3.fromRGB(80, 50, 20), function()
        LocalPlayer:LoadCharacter()
    end)

    MakeButton("❌ Close Menu", Color3.fromRGB(120, 20, 20), function()
        ScreenGui:Destroy()
    end)
end

