	-- ── หน้าที่เฝ้าระวัง ─────────────────────────────────────────────────
	local function getViewport()
		return root.AbsoluteSize
	end

	local function compactNav()
		return isMini or getViewport().X < 760
	end

	local function computeScale()
		local vp = getViewport()
		if vp.X <= 0 or vp.Y <= 0 then return 1 end
		return math.clamp(math.min(vp.X / (DESIGN_W + 80), vp.Y / (DESIGN_H + 80)), 0.5, 1.05)
	end

	function Window.GetScale()
		return windowScale.Scale
	end

	function Window.ClampPosition()
		local vp = getViewport()
		if vp.X <= 0 or vp.Y <= 0 then return end
		local sizeAbs = main.AbsoluteSize
		local halfW = sizeAbs.X / 2
		local halfH = sizeAbs.Y / 2
		local margin = 8
		local offX = main.Position.X.Offset
		local offY = main.Position.Y.Offset
		local centerX = vp.X * 0.5 + offX
		local centerY = vp.Y * 0.5 + offY
		local minX, maxX = margin + halfW, vp.X - margin - halfW
		local minY, maxY = margin + halfH, vp.Y - margin - halfH
		if minX > maxX then
			centerX = vp.X * 0.5
		else
			centerX = math.clamp(centerX, minX, maxX)
		end
		if minY > maxY then
			centerY = vp.Y * 0.5
		else
			centerY = math.clamp(centerY, minY, maxY)
		end
		main.Position = UDim2.new(0.5, centerX - vp.X * 0.5, 0.5, centerY - vp.Y * 0.5)
	end

	function Window.ApplyLayout()
		if not running then return end
		local vp = getViewport()
		if vp.X <= 0 or vp.Y <= 0 then return end

		local scale = computeScale()
		windowScale.Scale = scale

		local compact = compactNav()
		local navW = compact and NAV_W_RAIL or NAV_W_FULL
		nav.Size = UDim2.new(0, navW, 1, -(HEADER_H + STATUS_H))
		pageArea.Size = UDim2.new(1, -navW, 1, -(HEADER_H + STATUS_H))
		pageArea.Position = UDim2.new(0, navW, 0, HEADER_H)
		for _, nb in pairs(NavButtons) do
			nb.txt.Visible = not compact
			nb.icon.Position = compact and UDim2.new(0, 0, 0, 0) or UDim2.new(0, 10, 0, 0)
			nb.icon.Size = compact and UDim2.new(1, 0, 1, 0) or UDim2.new(0, 26, 1, 0)
		end

		-- ขนาดหน้าต่าง (จำกัดไม่ให้เกินจอ หลังคูณสเกล)
		local maxOffsetW = (vp.X - 24) / math.max(scale, 0.1)
		local maxOffsetH = (vp.Y - 24) / math.max(scale, 0.1)
		local base = userSize or UDim2.fromOffset(DESIGN_W, DESIGN_H)
		local w = math.clamp(base.X.Offset, MIN_ABS_W / math.max(scale, 0.1), maxOffsetW)
		local h = math.clamp(base.Y.Offset, MIN_ABS_H / math.max(scale, 0.1), maxOffsetH)
		if isMini then
			w = math.min(w, 560 / math.max(scale, 0.1))
			h = math.min(h, 300 / math.max(scale, 0.1))
		end
		main.Size = UDim2.fromOffset(w, h)

		-- หัวเรื่อง: ซ่อน/ย่อปุ่มตามพื้นที่
		local absW = main.AbsoluteSize.X
		local showSearch = absW > 620
		searchBox.GetFrame().Visible = showSearch
		langBtn.Visible = absW > 480
		miniBtn.Visible = absW > 420

		-- Toast: ปรับตำแหน่งตามแนวจอ
		local narrow = vp.X < 760
		Notify.SetNarrowLayout(narrow)
		Notify.SetWidth(math.min(300, math.max(200, vp.X - 24)))

		Window.ClampPosition()
		Overlay.Dismiss()
		searchPanel.Visible = false
	end

	-- ── การเปิด/ปิด/ย่อ ───────────────────────────────────────────────────
	function Window.IsOpen()
		return isOpen
	end

	function Window.IsMinimized()
		return isMinimized
	end

	function Window.OnOpenChanged(fn)
		return openChanged:Connect(fn)
	end

	function Window.Open()
		if isOpen and not isMinimized then return end
		if isMinimized then
			Window.Restore()
			return
		end
		isOpen = true
		isMinimized = false
		miniBar.Visible = false
		main.Visible = true
		fab.Visible = false
		grip.Visible = true
		Window.ApplyLayout()
		local targetTrans = 1 - clampNum(State.Get("WindowOpacity"), 0.3, 1, 0.92)
		if Perf.IsHeavyAllowed() then
			main.BackgroundTransparency = 1
			Perf.Tween(main, { BackgroundTransparency = targetTrans }, 0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
		else
			main.BackgroundTransparency = targetTrans
		end
		VisualEffects.SetWindowVisible(true)
		openChanged:Fire(true)
	end

	function Window.Close()
		if not isOpen and isMinimized == false then
			main.Visible = false
		end
		local function finish()
			main.Visible = false
			miniBar.Visible = false
			isMinimized = false
			isOpen = false
			fab.Visible = true
			grip.Visible = false
			Overlay.Dismiss()
			searchPanel.Visible = false
			VisualEffects.SetWindowVisible(false)
			openChanged:Fire(false)
		end
		if Perf.IsHeavyAllowed() and main.Visible then
			Perf.Tween(main, { BackgroundTransparency = 1 }, 0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
			task.delay(Perf.Duration(0.24), finish)
		else
			finish()
		end
	end

	function Window.Toggle()
		if isOpen and not isMinimized then
			Window.Close()
		else
			Window.Open()
		end
	end

	function Window.Minimize()
		if not isOpen or isMinimized then return end
		isMinimized = true
		local function finish()
			main.Visible = false
			miniBar.Visible = true
			grip.Visible = false
			VisualEffects.SetWindowVisible(false)
			openChanged:Fire(false)
		end
		if Perf.IsHeavyAllowed() then
			Perf.Tween(main, { BackgroundTransparency = 1 }, 0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
			task.delay(Perf.Duration(0.2), finish)
		else
			finish()
		end
	end

	function Window.Restore()
		if not isMinimized then return end
		isMinimized = false
		isOpen = true
		miniBar.Visible = false
		main.Visible = true
		grip.Visible = true
		Window.ApplyLayout()
		local targetTrans = 1 - clampNum(State.Get("WindowOpacity"), 0.3, 1, 0.92)
		main.BackgroundTransparency = targetTrans
		VisualEffects.SetWindowVisible(true)
		openChanged:Fire(true)
	end

	function Window.SetMiniMode(v)
		isMini = v == true
		State.Set("Window.MiniMode", isMini)
		Window.ApplyLayout()
	end

	function Window.IsMiniMode()
		return isMini
	end

	function Window.ResetWindowPosition()
		main.Position = UDim2.fromScale(0.5, 0.5)
		State.Set("Window.PositionX", nil)
		State.Set("Window.PositionY", nil)
		Window.ClampPosition()
	end

	function Window.CycleLanguage()
		local newLang = (Localization.GetLanguage() == "EN") and "TH" or "EN"
		Localization.SetLanguage(newLang)
		State.Set("Language", newLang)
		Notify.Show("info", "notify.languageChanged", "notify.languageChanged", nil, 2.5)
	end

