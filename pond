-- PAGE: ADVANCED (Diagnostics / Debug / Performance / Test tools)
-- ═══════════════════════════════════════════════════════════════════════════
local function buildAdvancedPage(page)
	local scroll = UI.MakeScroll(page)
	local refreshFns = {}

	local function infoRow(order, labelKey, getValue)
		local c = ThemeEngine.GetColors()
		local row = Instance.new("Frame")
		row.Size = UDim2.new(1, 0, 0, 32)
		row.LayoutOrder = order
		row.BackgroundColor3 = c.PanelAlt
		row.BackgroundTransparency = 0.5
		row.BorderSizePixel = 0
		row.Parent = scroll
		UI.Corner(row, 6)

		local label = Instance.new("TextLabel")
		label.Size = UDim2.new(0.55, 0, 1, 0)
		label.Position = UDim2.new(0, 10, 0, 0)
		label.BackgroundTransparency = 1
		label.Font = Enum.Font.Gotham
		label.TextSize = 11
		label.TextColor3 = c.TextDim
		label.TextXAlignment = Enum.TextXAlignment.Left
		label.Parent = row
		Localization.BindText(label, labelKey)

		local value = Instance.new("TextLabel")
		value.Size = UDim2.new(0.45, -12, 1, 0)
		value.Position = UDim2.new(0.55, 0, 0, 0)
		value.BackgroundTransparency = 1
		value.Font = Enum.Font.GothamBold
		value.TextSize = 11
		value.TextColor3 = c.Accent
		value.TextXAlignment = Enum.TextXAlignment.Right
		value.TextTruncate = Enum.TextTruncate.AtEnd
		value.Parent = row

		local function refresh()
			if not row.Parent then return end
			local ok, res = pcall(getValue)
			value.Text = ok and tostring(res) or "?"
		end
		refresh()
		Localization.Bind(refresh)
		local thToken
		thToken = ThemeEngine.Bind(function(cl)
			if not row.Parent then
				ThemeEngine.Unbind(thToken)
				return
			end
			row.BackgroundColor3 = cl.PanelAlt
			label.TextColor3 = cl.TextDim
			value.TextColor3 = cl.Accent
		end)
		table.insert(refreshFns, refresh)
		return refresh
	end

	-- ระบบ
	UI.Section(scroll, "adv.system", 1)
	infoRow(2, "app.version", function() return VERSION end)
	infoRow(3, "adv.player", function() return LocalPlayer.DisplayName end)
	infoRow(4, "adv.placeId", function() return tostring(game.PlaceId) end)
	infoRow(5, "adv.platform", function() return InputManager.GetPlatformName() end)

	local viewportRefresh = infoRow(6, "adv.viewport", function()
		local vp = Window.Root.AbsoluteSize
		return math.floor(vp.X) .. " x " .. math.floor(vp.Y)
	end)
	infoRow(7, "adv.uiScale", function() return string.format("%.2f", Window.GetScale()) end)

	-- ประสิทธิภาพ
	UI.Section(scroll, "adv.performance", 8)
	local fpsRefresh = infoRow(9, "adv.fps", function() return formatNumber(Perf.GetFPS(), 0) end)
	local pingRefresh = infoRow(10, "adv.ping", function()
		return math.floor(LocalPlayer:GetNetworkPing() * 1000) .. " ms"
	end)
	local memRefresh = infoRow(11, "adv.memory", function()
		if StatsService.GetTotalMemoryUsageMb then
			return math.floor(StatsService:GetTotalMemoryUsageMb())
		end
		return "?"
	end)
	local connRefresh = infoRow(12, "adv.connections", function()
		local conns = Cleanup.GetStats()
		return ConnectionCount .. " / tracked " .. conns
	end)
	local guiRefresh = infoRow(13, "adv.guiInstances", function()
		return #Window.Root:GetDescendants()
	end)

	UI.Button({
		Parent = scroll,
		LabelKey = "common.refresh",
		Style = "secondary",
		LayoutOrder = 14,
		OnClick = function()
			for _, fn in ipairs(refreshFns) do
				pcall(fn)
			end
			Notify.Show("info", "adv.diagRan", "adv.diagRan", nil, 2)
		end,
	})

	-- อัปเดตค่า FPS/viewport ทุกวินาทีเมื่อหน้านี้แสดงอยู่
	task.spawn(function()
		while page.Parent do
			task.wait(1)
			if page.Visible then
				pcall(viewportRefresh)
				pcall(fpsRefresh)
				pcall(pingRefresh)
				pcall(memRefresh)
				pcall(connRefresh)
				pcall(guiRefresh)
			end
		end
	end)

	-- Error log
	UI.Section(scroll, "adv.errorLog", 15)
	local errCountLabel = Instance.new("TextLabel")
	errCountLabel.LayoutOrder = 16
	errCountLabel.Size = UDim2.new(1, 0, 0, 18)
	errCountLabel.BackgroundTransparency = 1
	errCountLabel.Font = Enum.Font.GothamMedium
	errCountLabel.TextSize = 11
	errCountLabel.TextXAlignment = Enum.TextXAlignment.Left
	errCountLabel.Parent = scroll

	local logList = Instance.new("Frame")
	logList.LayoutOrder = 17
	logList.Size = UDim2.new(1, 0, 0, 0)
	logList.AutomaticSize = Enum.AutomaticSize.Y
	logList.BackgroundTransparency = 1
	logList.Parent = scroll
	local logLayout = Instance.new("UIListLayout")
	logLayout.SortOrder = Enum.SortOrder.LayoutOrder
	logLayout.Padding = UDim.new(0, 4)
	logLayout.Parent = logList

	local function rebuildLog()
		for _, child in ipairs(logList:GetChildren()) do
			if child:IsA("Frame") or child:IsA("TextLabel") then
				child:Destroy()
			end
		end
		local c = ThemeEngine.GetColors()
		local log = ErrorHandling.GetRecent(10)
		errCountLabel.TextColor3 = c.TextDim
		errCountLabel.Text = Localization.L("adv.errorLog") .. " (" .. tostring(ErrorHandling.Count()) .. ")"
		if #log == 0 then
			local empty = Instance.new("TextLabel")
			empty.Size = UDim2.new(1, 0, 0, 24)
			empty.BackgroundTransparency = 1
			empty.Font = Enum.Font.Gotham
			empty.TextSize = 11
			empty.TextColor3 = c.TextDim
			empty.Text = Localization.L("adv.noErrors")
			empty.Parent = logList
			return
		end
		for order, e in ipairs(log) do
			local row = Instance.new("TextLabel")
			row.Size = UDim2.new(1, 0, 0, 0)
			row.AutomaticSize = Enum.AutomaticSize.Y
			row.LayoutOrder = order
			row.BackgroundColor3 = c.PanelAlt
			row.BackgroundTransparency = 0.55
			row.BorderSizePixel = 0
			row.Font = Enum.Font.Code
			row.TextSize = 10
			row.TextWrapped = true
			row.TextXAlignment = Enum.TextXAlignment.Left
			row.Parent = logList
			UI.Corner(row, 4)
			local pad = Instance.new("UIPadding")
			pad.PaddingTop = UDim.new(0, 4)
			pad.PaddingBottom = UDim.new(0, 4)
