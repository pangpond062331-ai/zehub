	-- ── Global Search ─────────────────────────────────────────────────────
	local SearchIndex = {}

	function Window.RebuildSearchIndex()
		SearchIndex = {}
		for _, m in ipairs(MENUS) do
			table.insert(SearchIndex, { labelKey = m.lk, page = m.id })
		end
		for _, mod in ipairs(ModuleRegistry.list) do
			table.insert(SearchIndex, { labelKey = mod.nameKey, page = "features" })
		end
		for _, shortcut in ipairs({
			{ labelKey = "settings.language",   page = "settings" },
			{ labelKey = "settings.toggleKey",  page = "settings" },
			{ labelKey = "visual.themes",       page = "visual" },
			{ labelKey = "visual.perfMode",     page = "visual" },
			{ labelKey = "config.profiles",     page = "configuration" },
			{ labelKey = "config.importTitle",  page = "configuration" },
			{ labelKey = "modules.devTools",    page = "modules" },
			{ labelKey = "adv.errorLog",        page = "advanced" },
			{ labelKey = "adv.tools",           page = "advanced" },
		}) do
			table.insert(SearchIndex, shortcut)
		end
	end

	local function positionSearchPanel()
		local anchor = searchBox.GetFrame()
		if not anchor.Visible or not anchor.Parent then
			searchPanel.Visible = false
			return
		end
		local rootSize = root.AbsoluteSize
		local aPos = anchor.AbsolutePosition
		local pW = math.min(280, math.max(180, rootSize.X - 16))
		searchPanel.Size = UDim2.new(0, pW, 0, 0)
		local x = (aPos.X - root.AbsolutePosition.X) + anchor.AbsoluteSize.X - pW
		x = math.clamp(x, 8, math.max(8, rootSize.X - pW - 8))
		searchPanel.Position = UDim2.fromOffset(x, (aPos.Y - root.AbsolutePosition.Y) + anchor.AbsoluteSize.Y + 6)
	end

	function Window.OnSearchChanged(text)
		text = trimString(text):lower()
		for _, child in ipairs(searchPanel:GetChildren()) do
			if child:IsA("TextButton") then child:Destroy() end
		end
		if text == "" then
			searchPanel.Visible = false
			return
		end
		local order = 0
		for _, entry in ipairs(SearchIndex) do
			if order >= 12 then break end
			local label = Localization.L(entry.labelKey)
			if label:lower():find(text, 1, true) or entry.labelKey:lower():find(text, 1, true) then
				order = order + 1
				local c = ThemeEngine.GetColors()
				local rb = Instance.new("TextButton")
				rb.Size = UDim2.new(1, -8, 0, 30)
				rb.LayoutOrder = order
				rb.BackgroundColor3 = c.PanelAlt
				rb.BackgroundTransparency = 0.5
				rb.BorderSizePixel = 0
				rb.Font = Enum.Font.GothamMedium
				rb.TextSize = 12
				rb.TextColor3 = c.Text
				rb.TextXAlignment = Enum.TextXAlignment.Left
				rb.Text = "  " .. label
				rb.TextTruncate = Enum.TextTruncate.AtEnd
				rb.Parent = searchPanel
				UI.Corner(rb, 6)
				rb.MouseButton1Click:Connect(function()
					NavigateTo(entry.page)
					searchBox.Clear()
					searchPanel.Visible = false
				end)
			end
		end
		if order == 0 then
			local c = ThemeEngine.GetColors()
			local empty = Instance.new("TextLabel")
			empty.Size = UDim2.new(1, -8, 0, 34)
			empty.LayoutOrder = 1
			empty.BackgroundTransparency = 1
			empty.Font = Enum.Font.Gotham
			empty.TextSize = 12
			empty.TextColor3 = c.TextDim
			empty.Text = Localization.L("common.noResults")
			empty.Parent = searchPanel
		end
		positionSearchPanel()
		searchPanel.Visible = true
	end

	-- ปิดแผงค้นหาเมื่อคลิกพื้นที่อื่น
	UserInputService.InputBegan:Connect(function(input)
		if not searchPanel.Visible then return end
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			local inPos = Vector2.new(input.Position.X, input.Position.Y)
			local sPos = searchPanel.AbsolutePosition
			local sSize = searchPanel.AbsoluteSize
			local inPanel = inPos.X >= sPos.X and inPos.X <= sPos.X + sSize.X
				and inPos.Y >= sPos.Y and inPos.Y <= sPos.Y + sSize.Y
			if not inPanel then
				searchPanel.Visible = false
			end
		end
	end)

	-- ── FPS ใน status bar (อัปเดต 1 วินาที/ครั้ง) ──────────────────────────
	task.spawn(function()
		while running do
			task.wait(1)
			if running and isOpen and not isMinimized then
				statusFps.Text = "FPS " .. formatNumber(Perf.GetFPS(), 0)
			end
		end
	end)

	-- ── Responsiveness: ปรับ layout เมื่อขนาดจอเปลี่ยน ──────────────────
	local layoutDebounce = nil
	Cleanup.Watch(root:GetPropertyChangedSignal("AbsoluteSize"), function()
		if layoutDebounce then task.cancel(layoutDebounce) end
		layoutDebounce = task.delay(0.05, function()
			layoutDebounce = nil
			Window.ApplyLayout()
		end)
	end)

	Cleanup.OnTeardown(function()
		running = false
	end)

	-- ── ตำแหน่งหน้าต่างจาก config ───────────────────────────────────────
	if State.Get("Window.RememberPosition")
		and isFiniteNumber(State.Get("Window.PositionX"))
		and isFiniteNumber(State.Get("Window.PositionY")) then
		main.Position = UDim2.new(
			0.5, clampNum(State.Get("Window.PositionX"), -4000, 4000, 0),
			0.5, clampNum(State.Get("Window.PositionY"), -4000, 4000, 0)
		)
	end

	Window.Header = header
	Window.NavFrame = nav
	Window.Fab = fab
	Window.MiniBar = miniBar
	Window.GetOpenSignal = function() return openChanged end
end

