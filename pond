			if key == nil then return Localization.L("common.none") end
			return tostring(key.Name)
		end

		local function render()
			if capturing then return end
			keyBtn.Text = "[ " .. displayName(value) .. " ]"
			keyBtn.TextColor3 = value and ThemeEngine.GetColors().Accent or ThemeEngine.GetColors().TextDim
		end
		render()

		keyBtn.MouseButton1Click:Connect(function()
			if capturing then return end
			capturing = true
			keyBtn.Text = "[ " .. Localization.L("keybind.press") .. " ]"
			keyBtn.TextColor3 = ThemeEngine.GetColors().Warning
			InputManager.BeginCapture(function(key, cancelled)
				capturing = false
				if not cancelled then
					value = key -- nil = ล้างค่า
					if opts.OnChanged then
